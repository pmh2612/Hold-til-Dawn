# Owner: Mai Thien Ngon. Pause overlay (Esc, section 6.3) and the result screen (section 2.5).
# A solo match pauses while the overlay is open; a network match will keep running (FTR-04).
var paused = false
static var CONTROLS = ["WASD move   mouse aim   LMB attack (hold)", "E (hold) gather, repair, revive, pick up", "1-4 / wheel hotbar   Tab inventory   G give / drop", "Q bandage   RMB flask (Healer)   C workbench", "B build (Engineer)   F (hold) enter base at night", "V skip-day vote   M map   Ctrl + wheel zoom"]

func pause_button(vs, i: int) -> Rect2:
	return Rect2(vs.x / 2 - 110, vs.y / 2 + 40 + i * 46, 220, 36)

func draw_pause(c, vs) -> void:
	if not paused:
		return
	c.draw_rect(Rect2(0, 0, vs.x, vs.y), Color(0, 0, 0, 0.55))
	var box_: Rect2 = Rect2(vs.x / 2 - 220, vs.y / 2 - 170, 440, 410)
	self.panel(c, box_)
	self.text(c, Vector2(box_.position.x, box_.position.y + 34), "PAUSED", 26, GOLD, 1, box_.size.x, true)
	for i in range(CONTROLS.size()):
		self.text(c, Vector2(box_.position.x, box_.position.y + 64 + i * 18), CONTROLS[i], 11, Color(1, 1, 1, 0.75), 1, box_.size.x)
	var mouse: Vector2 = Vector2(hud.get_local_mouse_position())
	var labels = ["RESUME  (Esc)", "LEAVE MATCH"]
	for i in range(2):
		var b: Rect2 = self.pause_button(vs, i)
		c.draw_rect(b, Color(0.95, 0.71, 0.27, 0.35) if b.has_point(mouse) else Color(1, 1, 1, 0.08))
		c.draw_rect(b, GOLD, false, 1.5)
		self.text(c, Vector2(b.position.x, b.position.y + 24), labels[i], 14, Color.WHITE, 1, b.size.x, true)
	sound.draw_volume(c, vs)

func pause_mouse(ev) -> bool:
	if not paused or ev.button_index != 1:
		return false
	if ev.pressed:
		var mouse: Vector2 = Vector2(hud.get_local_mouse_position())
		if self.pause_button(hud.size, 0).has_point(mouse):
			paused = false
		elif self.pause_button(hud.size, 1).has_point(mouse):
			paused = false
			self.back_to_menu("Left the match")
		else:
			sound.volume_mouse(mouse, hud.size)
	return true

# Esc closes an open panel first, then toggles the pause overlay.
func escape_key() -> void:
	if map_big:
		map_big = false
		return
	if bag_open or craft_open or build_open:
		bag_open = false
		craft_open = false
		self.close_build()
		drag_from = null
		return
	if snap.get("ph", "") == "result":
		return
	paused = not paused

