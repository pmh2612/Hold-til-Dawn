	menu_panel.position = Vector2(vs.x - 368, maxf(66, (vs.y - menu_panel.size.y) / 2.0 + 4))
	var component9 = menu_panel.size
	component9.x = 328
	menu_panel.size = component9
	var component10 = lobby_panel.size
	component10.x = minf(856, vs.x - 64)
	lobby_panel.size = component10
