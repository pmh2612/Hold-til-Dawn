func draw_weather_wall(index: int) -> void:
	var w = geometry
	var _d1 = w.weather_walls[index]
	var a_ = _d1[0]
	var b = _d1[1]
	var lift: Vector2 = Vector2(0, -56)
	fill_static(w.weather_wall_faces[index], Color("B5B59E" if index == 0 else "888F80"))
	draw_line(a_, b, Color("424E49"), 5)
	draw_line(a_ + lift, b + lift, Color("D0CBB0"), 7)
	draw_line(a_ + Vector2(0, -18), b + Vector2(0, -18), Color("737E70"), 2)
	for i in range(1, 6):
		var p: Vector2 = a_.lerp(b, i / 6.0).round()
		draw_line(p + lift + Vector2(0, 5), p - Vector2(0, 3), Color("939B88"), 1)
	if index == 0:
		var c: Vector2 = w.weather_centre
		# Sealed windows show opaque blue glass, never exterior scenery.
		for side in [-1, 1]:
			var window = Rect2(c + Vector2(side * 88 - 26, -161), Vector2(52, 30))
			draw_rect(window.grow(3), Color("555F57"))
			draw_rect(window, Color("729699"))
			draw_line(window.position + Vector2(26, 0), window.position + Vector2(26, 30), Color("C2C2A5"), 3)
			draw_line(window.position + Vector2(3, 6), window.position + Vector2(20, 6), Color("B0C7B9"), 2)
		draw_rect(Rect2(c + Vector2(-24, -163), Vector2(48, 33)), Color("DBD4B2"))
		for i in range(4):
			draw_line(c + Vector2(-17, -155 + i * 5), c + Vector2(15 - i * 4, -155 + i * 5), Color("7C8B84"), 2)
	if index >= 3:
		var jamb: Vector2 = b if index == 3 else a_
		draw_line(jamb, jamb + lift, Color("48594F"), 10)
		draw_line(jamb + Vector2(-2, 0), jamb + lift + Vector2(-2, 0), Color("A7AA8C"), 3)

func draw_weather_roof(w, view: Rect2) -> void:
	if not is_same(weather_roof_world, w):
		weather_roof_world = w
		weather_roof_alpha = 1
		weather_roof_clock = float(clock)
	var now: float = float(clock)
	var dt: float = clampf(now - weather_roof_clock, 0, 0.1)
	weather_roof_clock = now
	weather_roof_alpha = move_toward(weather_roof_alpha, 0 if weather_interior_active else 1, dt * 5)
	if weather_roof_alpha <= 0 or not w.weather_visibility.intersects(view):
		return
	# A raised metal roof covers furniture from outside and peels away on entry.
	var r: Rect2 = Rect2(w.weather_room.position - Vector2(14, 65), w.weather_room.size + Vector2(28, 10))
	var roof: Color = Color("617C72", weather_roof_alpha)
	var seam: Color = Color("405E56", weather_roof_alpha)
	draw_rect(r.grow(3), seam)
	draw_rect(r, roof)
	var x: float = r.position.x + 7
	while x < r.end.x:
		draw_line(Vector2(x, r.position.y), Vector2(x, r.end.y), seam, 2)
		draw_line(Vector2(x + 3, r.position.y), Vector2(x + 3, r.end.y), Color("879B85", weather_roof_alpha), 1)
		x += 16
	draw_line(Vector2(r.position.x, r.get_center().y), Vector2(r.end.x, r.get_center().y), Color("A2AD90", weather_roof_alpha), 6)
	draw_rect(Rect2(r.get_center() + Vector2(70, -28), Vector2(31, 25)), seam)
	for i in range(4):
		draw_line(r.get_center() + Vector2(74, -22 + i * 5), r.get_center() + Vector2(96, -22 + i * 5), Color("88998A", weather_roof_alpha), 2)

func draw_weather_isolation(w) -> void:
	if not weather_interior_active:
		return
	var r: Rect2 = w.weather_visibility
	var black: Color = Color("080C10")
	# Overlap the four panels so fractional camera zoom cannot expose a one-pixel seam.
	draw_rect(Rect2(-32768, -32768, 65536, r.position.y + 32770), black)
	draw_rect(Rect2(-32768, r.end.y - 2, 65536, 32770 - r.end.y), black)
	draw_rect(Rect2(-32768, r.position.y - 2, r.position.x + 32769, r.size.y + 4), black)
	draw_rect(Rect2(r.end.x - 1, r.position.y - 2, 32769 - r.end.x, r.size.y + 4), black)
	# Fill the narrow apron up to the wall foundations, including the open doorway's outside view.
	draw_rect(Rect2(r.position.x, w.weather_room.end.y + 5, r.size.x, r.end.y - w.weather_room.end.y - 5), black)

# ---- ui/gameplay/Main.BuildMenu.cs
# Owner: Pham Minh Hieu. Engineer build menu (B, MEC-11): pick a wall or a tower, see a green or red placement
# preview at the cursor, left mouse places it, right mouse cancels, R turns a wall.
var build_open = false
var build_kind = ""
var build_vert = false
# [kind, label, cost text, unlock tier]
static var BUILD_OPTIONS = [["wood", "Wood wall  200 HP", "5 wood", 0], ["stone", "Stone wall  400 HP", "5 stone", 1], ["tower", "Tower  300 HP, dirt base + 6s build", "10 wood + 5 titanium", 2]]

func close_build() -> void:
	build_open = false
	build_kind = ""

func toggle_build() -> void:
	var me = snap.ps.get(my_id)
	if me == null or me[1] != 2:
		self.note("Only the Engineer builds")
		return
	if build_open:
		self.close_build()
		return
	build_open = true
	build_kind = ""
	bag_open = false
	craft_open = false

# A short local message in the hint line (no server round trip).
func note(s) -> void:
	local_note = s
	local_note_t = 2.5
var local_note = ""
var local_note_t = 0.0

func build_key(code) -> bool:
	if not build_open:
		return false
	var n: int = int(code - 49)
	if n >= 0 and n < BUILD_OPTIONS.size():
		build_kind = BUILD_OPTIONS[n][0]
		return true
	if code == 82:
		build_vert = not build_vert
		return true
	return false

func build_spot() -> Vector2:
	var mouse: Vector2 = get_global_mouse_position()
	return mouse if build_kind == "tower" else GameSim.snap_to_tile(mouse + Vector2(0, LIFT * 0.5))

# Why the selected structure cannot be placed at the cursor, or "" (the server checks again).
func build_problem(me) -> Variant:
	var spot: Vector2 = self.build_spot()
	if spot.distance_to(local_pos) > GameSim.BUILD_REACH * T:
		return "Too far away"
	var walls = snap.get("walls", []).map(func(w): return {"pos": w[0], "vert": w[1]})
	var tier: int = 0
	var cost = {}
	if build_kind == "tower":
		var why = GameSim.tower_spot_problem(spot, geometry)
		if why != "":
			return why
		if snap.get("tw", []).size() >= GameSim.MAX_TOWERS:
			return "The team already has %d towers" % [GameSim.MAX_TOWERS]
		if snap.get("free_tower", false):
			return ""
		tier = 2
		cost = {"wood": 10, "titanium": 5}
	else:
		var w = GameSim.WALL_KINDS[build_kind]
		var why = GameSim.wall_spot_problem(spot, build_vert, geometry, walls)
		if why != "":
			return why
		tier = int(w[2])
		cost = w[1]
	if tier > snap.get("unlock", 0):
		return "Unlocks after night 1" if tier == 1 else "Unlocks after the first boss"
	for res in cost:
		if carried(me, res) < cost[res]:
			return "Need %d %s" % [cost[res], res]
	return ""

# World space: the green or red ghost of the structure under the cursor.
func draw_build_preview() -> void:
	var me = snap.get("ps", {}).get(my_id)
	if not build_open or build_kind == "" or me == null:
		return
	var spot: Vector2 = self.build_spot()
	var ok: bool = self.build_problem(me) == ""
	var col: Color = Color(0.3, 1.0, 0.45, 0.45) if ok else Color(1.0, 0.25, 0.25, 0.45)
	if build_kind == "tower":
		draw_circle(spot, 0.7 * T, col)
		draw_arc(spot, GameSim.TOWER_RANGE, 0, TAU, 64, col, 1.5)
		return
	var half: Vector2 = Vector2(0.5 * T, 1.5 * T) if build_vert else Vector2(1.5 * T, 0.5 * T)
	draw_rect(Rect2(spot - half, half * 2), col)

func draw_build_menu(c, vs, me) -> void:
	if not build_open:
		return
	var box_: Rect2 = Rect2(vs.x - 330, 98, 320, 112)
	self.panel(c, box_)
	self.text(c, box_.position + Vector2(10, 16), "BUILD", 10, GOLD, 0, -1.0, true)
	var unlock: int = snap.get("unlock", 0)
	for i in range(BUILD_OPTIONS.size()):
		var o = BUILD_OPTIONS[i]
		var locked: bool = o[3] > unlock
		var cost = o[2]
		if o[0] == "tower" and snap.get("free_tower", false):
			locked = false
			cost = "free"
		var picked: bool = o[0] == build_kind
		var col: Color = Color(1, 1, 1, 0.35) if locked else GOLD if picked else Color.WHITE
		self.text(c, box_.position + Vector2(10, 38 + i * 18), "%d  %s - %s%s" % [i + 1, o[1], cost, "  LOCKED" if locked else ""], 11, col)
	if build_kind != "":
		var why = self.build_problem(me)
		self.text(c, box_.position + Vector2(10, 100), "Left click to place" if why == "" else why, 11, Color(0.4, 1.0, 0.5) if why == "" else NEON_RED)

# A built wall: [pos, vertical, hp, maxhp, kind] drawn as a raised block with an HP bar once damaged.
func draw_built_wall(w) -> void:
	var pos: Vector2 = Vector2(w[0])
	var half: Vector2 = Vector2(0.5 * T, 1.5 * T) if w[1] else Vector2(1.5 * T, 0.5 * T)
	# art/props/wall_<kind>_<h|v>.png from tools/PixelProps.cs
	self.draw_prop("wall_%s_%s" % [w[4], "v" if w[1] else "h"], pos)
	if w[2] < w[3]:
		self.bar(pos - Vector2(0, half.y + 22), half.x * 1.6, w[2] / w[3], GOLD)

func build_mouse(ev) -> bool:
	if not build_open or build_kind == "":
		return false
	if ev.button_index == 2 and ev.pressed:
		build_kind = ""
		return true
	if ev.button_index == 1 and ev.pressed:
		self.act("build", [build_kind, self.build_spot(), build_vert])
	return ev.button_index == 1

# ---- ui/gameplay/Main.CraftPanel.cs
# Owner: Vu Duc Viet Anh. The workbench tab (MEC-10, BAL-19, recipe table in GDD section 3.2), opened with C.
# It takes the middle of the screen like the bag: on the left every recipe as a card with its icon, grouped by
# tier; on the right the picked recipe in detail (what it does, its numbers) and how it is made, drawn as
# ingredients + ingredients -> result, the steps to follow and a Craft button. A number key still crafts at once.
# The server decides (GameSim.CanCraft); the reasons shown here only mirror its rules.
# the recipe shown on the right
var craft_sel: int = 0
var craft_tier: int = 0

func craft_choices() -> Variant:
	var choices = []
	var i: int = 0
	while i < GameSim.RECIPES.size():
		if int(GameSim.RECIPES[i][2]) == craft_tier:
			choices.append(i)
		i += 1
	return choices

func craft_tier_button(vs: Vector2, tier: int) -> Rect2:
	var p: Rect2 = craft_panel_rect(vs)
	var w: float = (craft_left_w(p) - 12) / 3
	return Rect2(p.position.x + 20 + tier * (w + 4), p.position.y + HEAD_H + 4, w, 26)

func select_craft_tier(tier: int) -> void:
	craft_tier = clampi(tier, 0, 2)
	var choices = craft_choices()
	if not choices.has(craft_sel):
		craft_sel = choices[0]
const CARD_H: float = 92.0
const CARD_GAP: float = 8.0
const BOX: float = 52.0
# the title line
const HEAD_H: float = 48.0

# --- layout --------------------------------------------------------------
func craft_panel_rect(vs: Vector2) -> Rect2:
	# nearly the whole screen (the HUD is often only 540 px high, scaled up)
	var w: float = minf(vs.x - 40.0, 940.0)
	var h: float = minf(vs.y - 24.0, 540.0)
	return Rect2(Cs.round_even((vs.x - w) / 2), Cs.round_even((vs.y - h) / 2), w, h)

func craft_left_w(p: Rect2) -> float:
	return floorf(p.size.x * 0.54)

func craft_card(vs: Vector2, i: int) -> Rect2:
	var p: Rect2 = self.craft_panel_rect(vs)
	var lw: float = self.craft_left_w(p)
	var cw: float = floorf((lw - 3 * CARD_GAP) / 4)
	var r = GameSim.RECIPES[i]
	var tier: int = int(r[2])
	var k: int = 0
	for j in range(i):
		if int(GameSim.RECIPES[j][2]) == tier:
			k += 1
	var y: float = p.position.y + HEAD_H + 44 + k / 4 * (CARD_H + 12)
	return Rect2(p.position.x + 20 + k % 4 * (cw + CARD_GAP), y, cw, CARD_H)

func craft_detail(p: Rect2) -> Rect2:
	var x: float = p.position.x + 20 + self.craft_left_w(p) + 24
	return Rect2(x, p.position.y + HEAD_H + 4, p.end.x - 20 - x, p.size.y - HEAD_H - 4 - 16)

func craft_button(vs: Vector2) -> Rect2:
	var d: Rect2 = self.craft_detail(self.craft_panel_rect(vs))
	return Rect2(d.position.x, d.end.y - 38, d.size.x, 38)

# --- what the recipe is ----------------------------------------------------
# 8 -> "8", 1.5 -> "1.5"
static func num(v) -> Variant:
	var f: float = float(v)
	return str(int(f)) if f == floorf(f) else String.num(f, 1)

static func key_of(i: int) -> Variant:
	var n: int = 0
	var tier: int = int(GameSim.RECIPES[i][2])
	for j in range(i + 1):
		if int(GameSim.RECIPES[j][2]) == tier:
			n += 1
	return Cs.s(n % 10)

func craft_seconds(r) -> float:
	var me = snap.get("ps", {}).get(my_id, null)
	return (float(r[4]) / 20.0 if r[3] == "base" else GameSim.CRAFT_TIME) * (0.8 if me != null and carried(me, "crafting_kit") > 0 else 1.0)

func craft_tag(id) -> Variant:
	if GameSim.rescue_kind(id) >= 0:
		return "RESCUE - TEAM EQUIPMENT"
	if id == "revive":
		return "TEAM"
	elif id == "base":
		return "BASE  -  ENGINEER ONLY"
	elif id == "bandage":
		return "HEALING"
	elif id == "arrow":
		return "AMMO"
	var kind = GameSim.kind_of(id)
	if kind == "weapon":
		return "WEAPON  -  RANGED" if GameSim.WEAPON_STATS[id][3] else "WEAPON  -  MELEE"
	return kind.to_upper()

# one short line of numbers
func craft_desc(id) -> Variant:
	var out = []
	if GameSim.rescue_kind(id) >= 0:
		out.append("Required for the rescue helicopter")
		out.append("Craft by day. Installed for the whole team.")
		out.append("Find radio parts in landmark chests.")
		return out
	var tactical = GameSim.tactical_description(id)
	if tactical.size() > 0:
		return Array(tactical).duplicate()
	if GameSim.WEAPON_STATS.has(id):
		var s = GameSim.WEAPON_STATS[id]
		var ranged: bool = s[3]
		out.append(num(s[0]) + " damage, " + num(s[1]) + "/s, " + ("range " if ranged else "reach ") + num(s[2]))
		if id == "bow":
			out.append("No arrows included. Craft ammunition separately.")
		return out
	var k: int = 1
	while k < GameSim.ARMOUR_ITEMS.size():
		if Cs.s(GameSim.ARMOUR_ITEMS[k]) == id:
			out.append("-%d%% damage taken" % [int(Cs.round_even(float(GameSim.ARMOUR[k]) * 100.0))])
			return out
		k += 1
	if id == "bandage":
		out.append("Q: +30 HP")
	elif id == "revive":
		out.append("Hold E on a dead teammate")
	elif id == "base":
		out.append("+100 generator HP, by day")
	return out

# why this recipe cannot be crafted right now ("" = it can), the same rules as GameSim.CanCraft
func craft_block(me, i: int) -> Variant:
	var r = GameSim.RECIPES[i]
	var id = Cs.s(r[3])
	var tier: int = int(r[2])
	var radio = snap.get("rescue", null)
	if radio != null and float(radio[2]) > 0 and Cs.s(me[22]) == "craft" and int(me[26]) < 0:
		return "Release E to stop assembling the radio first"
	if tier != 3 and tier > snap.get("unlock", 0):
		return "Unlocks after night 1" if tier == 1 else "Unlocks after the first boss"
	if r[5] and me[1] != 2:
		return "Only an Engineer can do this"
	if GameSim.kind_of(id) == "armour" and GameSim.ARMOUR_ITEMS.find(id) <= int(me[9]):
		return "Already worn"
	if id == "base":
		if snap.get("ph", "") == "night":
			return "The generator can only be repaired by day"
		if snap.get("base", 0.0) >= float(GameSim.BASE_HP):
			return "The generator is at full HP"
	for res in r[1]:
		var need: int = int(r[1][res])
		var have: int = craft_have_local(me, Cs.s(res))
		if have < need:
			return "Need %d more %s" % [need - have, GameSim.item_name(res)]
	if not self.at_bench_local(me):
		return "Walk to the workbench to craft"
	var busy: int = int(me[26])
	if busy >= 0 and busy != i:
		return "Already making %s" % [GameSim.RECIPES[busy][0]]
	return ""

# --- drawing ---------------------------------------------------------------
func draw_craft_panel(c, vs) -> void:
	if not craft_open:
		return
	var me = snap.ps.get(my_id)
	if me == null:
		return
	var v: Vector2 = Vector2(vs)
	craft_sel = clampi(craft_sel, 0, GameSim.RECIPES.size() - 1)
	var mouse: Vector2 = Vector2(hud.get_local_mouse_position())
	# Opaque backing keeps world lights and scenery from competing with recipes.
	var p: Rect2 = self.craft_panel_rect(v)
	c.draw_rect(p, Color(0.06, 0.07, 0.1, 1.0))
	c.draw_rect(p, GOLD * Color(1, 1, 1, 0.7), false, 1.5)
	c.draw_line(Vector2(p.position.x + 16, p.position.y + HEAD_H - 8), Vector2(p.end.x - 16, p.position.y + HEAD_H - 8), Color(1, 1, 1, 0.1), 1.0)
	self.text(c, p.position + Vector2(20, 28), "WORKBENCH", 18, GOLD, 0, -1.0, true)
	# --- recipe cards, by tier
	var lw: float = self.craft_left_w(p)
	for t in range(3):
		var tab: Rect2 = craft_tier_button(v, t)
		var open: bool = t == 3 or t <= snap.get("unlock", 0)
		c.draw_rect(tab, Color(0.35, 0.29, 0.14, 0.95) if craft_tier == t else Color(0.08, 0.09, 0.12, 0.9))
		c.draw_rect(tab, GOLD if craft_tier == t else Color(1, 1, 1, 0.2), false, 1.0)
		self.text(c, Vector2(tab.position.x, tab.position.y + 18), ("BASIC" if t == 0 else "STONE" if t == 1 else "TITANIUM") + ("" if open else " [locked]"), 11, GOLD if open else Color.GRAY, 1, tab.size.x, true)
	var busy: int = int(me[26])
	for i in range(GameSim.RECIPES.size()):
		if int(GameSim.RECIPES[i][2]) == craft_tier:
			self.draw_craft_card(c, me, i, self.craft_card(v, i), mouse, busy)
	draw_rescue_checklist(c, p)
	# what you carry and what is in the chest
	var by: float = p.end.y - 20
	self.text(c, Vector2(p.position.x + 20, by + 4), "Bag", 10, Color(1, 1, 1, 0.6))
	var sto = snap.get("sto", [])
	var bx: float = p.position.x + 50
	for res in GameSim.RES:
		self.draw_item_icon(c, res, Vector2(bx + 10, by), 1.0)
		self.text(c, Vector2(bx + 22, by + 5), "%d" % [craft_have_local(me, Cs.s(res))], 11, Color.WHITE)
		var in_chest: int = GameSim.count_in(sto, res)
		self.text(c, Vector2(bx + 44, by + 5), "(chest %d)" % [in_chest], 9, Color(1, 1, 1, 0.45))
		bx += 108
	c.draw_line(Vector2(p.position.x + 20 + lw + 12, p.position.y + HEAD_H), Vector2(p.position.x + 20 + lw + 12, p.end.y - 14), Color(1, 1, 1, 0.12), 1.0)
	self.draw_craft_detail(c, me, v, self.craft_detail(p), mouse, busy)

func draw_craft_card(c, me, i: int, card: Rect2, mouse: Vector2, busy: int) -> void:
	var r = GameSim.RECIPES[i]
	var id = Cs.s(r[3])
	var locked: bool = int(r[2]) != 3 and int(r[2]) > snap.get("unlock", 0)
	var why = self.craft_block(me, i)
	var ready: bool = why == ""
	var hover: bool = card.has_point(mouse)
	var sel: bool = i == craft_sel
	c.draw_rect(card, Color(0.14, 0.16, 0.21, 0.85) if hover else Color(0.05, 0.06, 0.09, 0.6))
	c.draw_rect(card, GOLD if sel else Color(0.5, 0.85, 0.55, 0.55) if ready else Color(1, 1, 1, 0.15), false, 2.0 if sel else 1.0)
	self.text(c, card.position + Vector2(5, 13), key_of(i), 10, Color(1, 1, 1, 0.55), 0, -1.0, true)
	if r[5]:
		self.text(c, card.position + Vector2(0, 13), "ENG", 9, Color("F28C38"), 2, card.size.x - 5, true)
	var icon = Vector2(card.get_center().x, card.position.y + 31)
	c.draw_circle(icon, 22.0, Color(1, 1, 1, 0.02 if locked else 0.05))
	self.draw_item_icon(c, id, icon, 2.0)
	var n: int = int(r[4])
	if n > 1 and id != "base":
		self.text(c, icon + Vector2(14, 19), "x" + str(n), 10, Color.WHITE, 0, -1.0, true)
	self.text(c, Vector2(card.position.x, card.position.y + 64), Cs.s(r[0]), 11, Color(1, 1, 1, 0.4) if locked else Color.WHITE, 1, card.size.x)
	# the cost as small icons, red where you carry too little
	var cost = r[1]
	var parts: int = cost.size()
	var each: float = minf(38.0, (card.size.x - 4) / parts)
	var x: float = card.get_center().x - parts * each / 2
	for res in cost:
		var need: int = int(cost[res])
		var enough: bool = craft_have_local(me, Cs.s(res)) >= need
		self.draw_item_icon(c, res, Vector2(x + 10, card.position.y + 79), 1.0)
		self.text(c, Vector2(x + 20, card.position.y + 84), Cs.s(need), 10, Color.WHITE if enough else Color(1, 0.55, 0.5))
		x += each
	if locked:
		c.draw_rect(card, Color(0, 0, 0, 0.45))
		self.text(c, Vector2(card.position.x, card.position.y + 36), "LOCKED", 11, Color(1, 1, 1, 0.7), 1, card.size.x, true)
	if busy == i:
		var f: float = clampf(float(me[27]), 0.0, 1.0)
		c.draw_rect(Rect2(card.position.x, card.end.y - 4, card.size.x * f, 4), GOLD)

func draw_craft_detail(c, me, v: Vector2, d: Rect2, mouse: Vector2, busy: int) -> void:
	var i: int = craft_sel
	var r = GameSim.RECIPES[i]
	var id = Cs.s(r[3])
	var n: int = int(r[4])
	# big icon, name, kind and what it does
	var frame_ = Rect2(d.position, Vector2(96, 96))
	c.draw_rect(frame_, Color(0.05, 0.06, 0.09, 0.7))
	c.draw_rect(frame_, GOLD, false, 1.5)
	self.draw_item_icon(c, id, frame_.get_center(), 4.0)
	var tx: float = d.position.x + 110
	self.text(c, Vector2(tx, d.position.y + 20), Cs.s(r[0]), 17, Color.WHITE, 0, -1.0, true)
	self.text(c, Vector2(tx, d.position.y + 38), self.craft_tag(id), 10, GOLD, 0, -1.0, true)
	var ly: float = d.position.y + 114
	for line in self.craft_desc(id):
		self.text(c, Vector2(d.position.x, ly), line, 11, Color(1, 1, 1, 0.85))
		ly += 16
	# how it is made: ingredients + ingredients -> result
	var hy: float = d.position.y + 196
	self.text(c, Vector2(d.position.x, hy), "HOW TO CRAFT", 11, GOLD, 0, -1.0, true)
	var x: float = d.position.x
	var y: float = hy + 12
	var cost = r[1]
	var first: bool = true
	for res in cost:
		if not first:
			self.text(c, Vector2(x, y + BOX / 2 + 8), "+", 22, Color.WHITE, 1, 22.0, true)
			x += 22
		first = false
		var need: int = int(cost[res])
		var have: int = craft_have_local(me, Cs.s(res))
		self.craft_box(c, Rect2(x, y, BOX, BOX), res, "x" + str(need), Color(1, 1, 1, 0.25) if have >= need else Color(1, 0.5, 0.45, 0.7))
		self.text(c, Vector2(x, y + BOX + 13), "have %d" % [have], 10, Color("7FD38A") if have >= need else Color(1, 0.6, 0.55), 1, BOX)
		x += BOX
	# the arrow, with the hammer and the time it takes
	var ax: float = x + 10
	var aw: float = 58.0
	var my: float = y + BOX / 2
	var arrow = Color(1, 1, 1, 0.8)
	c.draw_line(Vector2(ax, my), Vector2(ax + aw - 8, my), arrow, 3.0)
	c.draw_colored_polygon([Vector2(ax + aw, my), Vector2(ax + aw - 10, my - 7), Vector2(ax + aw - 10, my + 7)], arrow)
	self.draw_item_icon(c, "hammer", Vector2(ax + aw / 2 - 2, my - 16), 1.0)
	self.text(c, Vector2(ax, my + 20), num(self.craft_seconds(r)) + " s", 10, Color(1, 1, 1, 0.7), 1, aw)
	x = ax + aw + 10
	# The bow is crafted empty; ammunition is a separate recipe.
	var count = "x" + str(n) if n > 1 and id != "base" else "+100" if id == "base" else ""
	self.craft_box(c, Rect2(x, y, BOX, BOX), id, count, GOLD)
	# the button, or why not
	var b: Rect2 = self.craft_button(v)
	var why = self.craft_block(me, i)
	if busy == i:
		var f: float = clampf(float(me[27]), 0.0, 1.0)
		c.draw_rect(b, Color(0.05, 0.06, 0.09, 0.95))
		c.draw_rect(Rect2(b.position, Vector2(b.size.x * f, b.size.y)), GOLD * Color(1, 1, 1, 0.75))
		c.draw_rect(b, GOLD, false, 1.5)
		self.text(c, Vector2(b.position.x, b.position.y + 25), "MAKING...  %d%%" % [int(f * 100)], 13, Color.WHITE, 1, b.size.x, true)
		return
	var can: bool = why == ""
	var hover: bool = can and b.has_point(mouse)
	c.draw_rect(b, (GOLD.lightened(0.15) if hover else GOLD) if can else Color(0.2, 0.21, 0.25, 0.9))
	c.draw_rect(b, INK if can else Color(1, 1, 1, 0.15), false, 1.0)
	self.text(c, Vector2(b.position.x, b.position.y + 25), "CRAFT  [%s]" % [key_of(i)] if can else why.to_upper(), 13, INK if can else Color(1, 1, 1, 0.55), 1, b.size.x, true)

# one picture box of the recipe: an icon at 2x with its count in the corner
func craft_box(c, r: Rect2, id, count, edge: Color) -> void:
	c.draw_rect(r, Color(0.05, 0.06, 0.09, 0.7))
	c.draw_rect(r, edge, false, 1.5)
	self.draw_item_icon(c, id, r.get_center(), 2.0)
	if count != "":
		self.text(c, Vector2(r.position.x, r.end.y - 4), count, 11, Color.WHITE, 2, r.size.x - 4, true)

# --- mouse -----------------------------------------------------------------
func craft_mouse(ev) -> bool:
	if not craft_open or ev.button_index != 1:
		return false
	if ev.pressed:
		var vs: Vector2 = Vector2(hud.size)
		var mouse: Vector2 = Vector2(hud.get_local_mouse_position())
		for t in range(3):
			if craft_tier_button(vs, t).has_point(mouse):
				select_craft_tier(t)
				return true
		for i in craft_choices():
			if self.craft_card(vs, i).has_point(mouse):
				craft_sel = i
		var me = snap.ps.get(my_id)
		if me != null and self.craft_button(vs).has_point(mouse) and self.craft_block(me, craft_sel) == "":
			self.act("craft", craft_sel)
	return true

