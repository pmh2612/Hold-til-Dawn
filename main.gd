func draw_fishing_life(w, view: Rect2, time: float) -> void:
	var _c1 = interior_active
	var pier
	if not _c1:
		pier = w.lm_at.get(10, Vector2.ZERO)
		_c1 = not w.lm_at.has(10)
	if _c1 or not Cs.has_point(view.grow(360), pier):
		return
	for l in range(w.fishing_litter.size()):
		var _d2 = w.fishing_litter[l]
		var p = _d2[0]
		var kind = _d2[1]
		if not view.has_point(p):
			continue
		draw_rect(Rect2(p + Vector2(-5, 2), Vector2(12, 3)), Color("343F35", 0.4))
		# Crumpled bait wrappers.
		if kind == 0:
			fill_static(w.fishing_litter_faces[l], Color("C9C09A"))
			draw_line(p + Vector2(-2, -2), p + Vector2(4, 1), Color("987C55"), 2)
		# Empty drink tins.
		elif kind == 1:
			draw_rect(Rect2(p - Vector2(4, 5), Vector2(8, 10)), Color("9AABA2"))
			draw_rect(Rect2(p - Vector2(4, 2), Vector2(8, 4)), Color("AB6450"))
			draw_line(p + Vector2(-3, -5), p + Vector2(3, -5), Color("D0D2B8"), 2)
		# Discarded green bottles.
		elif kind == 2:
			draw_rect(Rect2(p - Vector2(5, 2), Vector2(10, 5)), Color("4D7B68"))
			draw_rect(Rect2(p + Vector2(5, -1), Vector2(4, 3)), Color("729680"))
			draw_line(p - Vector2(3, 1), p + Vector2(3, -1), Color("ABC1A1"), 1)
		# Coiled fishing line and a rusty hook.
		else:
			draw_arc(p, 6, 0, TAU * 1.7, 16, Color("B7AE85"), 1)
			draw_line(p + Vector2(5, 0), p + Vector2(11, 4), Color("A4A18B"), 1)
	# At most eight visual fish, with cached sea positions and staggered jumps. No physics, AI or spawning.
	for i in range(w.fishing_fish.size()):
		var water: Vector2 = w.fishing_fish[i]
		if not Cs.has_point(view.grow(45), water):
			continue
		var cycle: float = 5.2 + i % 3 * 0.9
		var phase: float = fposmod(time + i * 1.37, cycle)
		if phase > 2.1:
			continue
		var t: float = minf(phase / 1.15, 1)
		var arc: float = sin(t * PI)
		var sign_: int = 1 if i % 2 == 0 else -1
		var fish: Vector2 = (water + Vector2((t - 0.5) * 42 * sign_, -arc * (30 + i % 3 * 8))).round()
		var foam: Color = Color("BCDAD1", (1 - phase / 2.1) * 0.75)
		var ripple: Vector2 = water + Vector2(-21 * sign_ if phase < 1.15 else 21 * sign_, 0)
		var radius: float = 5 + (phase if phase < 1.15 else phase - 1.15) * 16
		draw_set_transform(ripple.round(), 0, Vector2(1, 0.4))
		draw_arc(Vector2.ZERO, radius, 0, TAU, 16, foam, 1)
		draw_set_transform(Vector2.ZERO)
		if phase >= 1.15:
			var splash: float = (phase - 1.15) / 0.95
			for k in range(4):
				draw_rect(Rect2((ripple + Vector2((k - 1.5) * splash * 15, -sin(splash * PI) * (14 if k % 2 == 0 else 22))).round(), Vector2(2, 3)), foam)
			continue
		draw_set_transform(fish, (t - 0.5) * 1.3 * sign_, Vector2(sign_, 1))
		draw_colored_polygon(pier_fish_body, Color("9FC7BA" if i % 2 == 0 else "C4C7A5"))
		draw_colored_polygon(pier_fish_tail, Color("5F9997"))
		draw_line(Vector2(-4, 2), Vector2(6, 2), Color("E0E2BF"), 2)
		draw_rect(Rect2(6, -2, 2, 2), Color("273F43"))
		draw_set_transform(Vector2.ZERO)

# ---- src/world/view/Main.HarvestView.cs
var harvest_collider_sources = []
var harvest_collider_nodes = []
var harvest_types = {}

func node_colliders(records) -> Variant:
	if harvest_collider_sources.size() != records.size():
		harvest_collider_sources.clear()
		harvest_types.clear()
		harvest_collider_nodes = []
	var i: int = 0
	while i < records.size():
		var record = records[i]
		if i < harvest_collider_sources.size() and is_same(harvest_collider_sources[i], record):
			i += 1
			continue
		if i < harvest_collider_sources.size():
			harvest_types.erase(Vector2(harvest_collider_sources[i][1]))
		harvest_types[Vector2(record[1])] = int(record[0])
		if i < harvest_collider_sources.size():
			harvest_collider_sources[i] = record
			var node = harvest_collider_nodes[i]
			node["type"] = record[0]
			node["pos"] = record[1]
			node["amount"] = record[2]
			node["radius"] = record[4] if record.size() > 4 else null
		else:
			harvest_collider_sources.append(record)
			harvest_collider_nodes.append(Harvestables.from_snapshot(record))
		i += 1
	return harvest_collider_nodes

func gather_animation(target: Vector2) -> Variant:
	var type = harvest_types.get(target, 0)
	if not harvest_types.has(target):
		return null
	return "gather_wood" if type == 0 else "gather_stone" if type == 1 or type == 3 else "gather_herb" if type == 2 else null

