static var expedition_palette = {}

static func ep(hex_) -> Color:
	var c = expedition_palette.get(hex_, Color(0, 0, 0, 0))
	if not expedition_palette.has(hex_):
		c = Color(hex_)
		expedition_palette[hex_] = c
	return c
