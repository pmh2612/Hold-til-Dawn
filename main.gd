# ---- src/world/view/Main.NodeBreak.cs
# Owner: Vu Duc Viet Anh. A resource node breaks bit by bit as it is gathered instead of shrinking: each unit taken
# (5 to a node) swaps in the next broken stage of its sprite (art/nature/<node>_dmg<k>_<variant>.png, drawn by
# tools/PixelHarvestDamage.cs: trunk notches, rock fractures, cut stems), the node jolts, and a burst of chips in
# its colours flies off (wood chips, stone shards, leaves, blue crystal). Each tool contact triggers a short
# highlight and a rigid jolt; five small slots show resource/progress on the worked node only.
# Once empty it shows its remains (stump, rubble, ...) until dawn.
const NODE_FULL: int = 5
const NODE_STAGES: int = 4
var chips = []
var chip_clock: float = 0.0
# what each node held last frame, when it last lost a unit, when it last threw a chip while worked
var node_seen = {}
var node_hit_at = {}
var worked_nodes = {}
var harvest_strikes = {}
var visible_node_amounts = {}
var worked_sprites = {}
# chip colours per node type: wood, stone, herb, titanium
static var CHIP_COLS = [[Color("E0B070"), Color("C08A50"), Color("7A5634"), Color("3A6B45")], [Color("D5DAE1"), Color("A3A8B0"), Color("7D838C")], [Color("9BE37A"), Color("4FB862"), Color("2E7D3E")], [Color("D2E6FF"), Color("7FB0FF"), Color("4A72E6"), Color("A98CFF"), Color("3D415C")]]
# how high above its foot a node is broken into
static var CHIP_FROM = [8.0, 12.0, 6.0, 14.0]

# the sprite for a node as it stands now; also notices a unit taken since the last frame
func node_sprite(nd, hsh: int) -> Variant:
	var type: int = int(nd[0])
	var pos: Vector2 = Vector2(nd[1])
	var amount: int = int(nd[2])
	var was = node_seen.get(pos, 0)
	if node_seen.has(pos) and amount < was:
		self.burst_chips(type, pos, 18 if amount <= 0 else 10, 1.0)
		sound.harvest(type, pos, 2 if amount <= 0 else 1)
		node_hit_at[pos] = float(clock)
	node_seen[pos] = amount
	visible_node_amounts[pos] = amount
	var custom = Cs.s(nd[3]) if nd.size() > 3 else ""
	if custom.length() > 0:
		var sprite_ = Harvestables.stage_sprite(custom, 5) if amount <= 0 else Harvestables.stage_sprite(custom, NODE_FULL - amount) if amount < NODE_FULL else custom
		if spr.has(sprite_):
			return remember_worked_sprite(pos, sprite_)
	if amount <= 0:
		return remember_worked_sprite(pos, Cs.s(self.var_(NODE_EMPTY[type], hsh)))
	var name = Cs.s(NODE_SPR[type])
	var stage: int = clampi(NODE_FULL - amount, 0, NODE_STAGES)
	if stage > 0:
		var broken = name + "_dmg" + str(stage)
		if nvar.get(broken, 0) > 0:
			name = broken
	return remember_worked_sprite(pos, Cs.s(self.var_(name, hsh)))

func remember_worked_sprite(pos: Vector2, name) -> Variant:
	if worked_nodes.has(pos):
		worked_sprites[pos] = name
	return name

# Once per frame, time impacts to the contact frame of each character's harvesting animation.
func prepare_harvest_feedback() -> void:
	worked_nodes.clear()
	visible_node_amounts.clear()
	worked_sprites.clear()
	for id in snap.ps:
		var p = snap.ps[id]
		if Cs.s(p[22]) != "gather":
			continue
		var pos: Vector2 = Vector2(p[23])
		worked_nodes[pos] = maxf(worked_nodes.get(pos, 0.0), float(p[21]))
		var timing = anim_state.get(id)
		if timing == null or not Cs.s(timing[0]).begins_with("gather_"):
			continue
		var start: float = float(timing[1])
		var time: float = maxf(0, float(clock) - start)
		var skin = Cs.s(ROLE_SKIN[p[1]])
		var anim = cinfo.chars[skin].anims[timing[0]]
		var count: int = int(anim[1])
		var frame_: int = int(time * float(anim[2]))
		var cycle: int = frame_ / count
		if frame_ % count < 3:
			continue
		var key_ = Cs.s(id)
		var last = harvest_strikes.get(key_, null)
		if harvest_strikes.has(key_) and last[0] == pos and last[1] == start and last[2] == cycle:
			continue
		harvest_strikes[key_] = [pos, start, cycle]
		var type = harvest_types.get(pos, 0)
		if not harvest_types.has(pos):
			continue
		node_hit_at[pos] = float(clock)
		burst_chips(type, pos, 6 if type == 2 else 8, 0.65)
		sound.harvest(type, pos, 0)

func node_scale(nd) -> float:
	return 1.0

func node_modulate(nd) -> Color:
	var pos: Vector2 = Vector2(nd[1])
	var age: float = float(clock) - node_hit_at.get(pos, -9)
	var light: float = 1 + 0.38 * clampf(1 - age / 0.13, 0, 1)
	return Color(light, light, light, 1)

func node_offset(nd) -> Vector2:
	var pos: Vector2 = Vector2(nd[1])
	var at = node_hit_at.get(pos, 0.0)
	if node_hit_at.has(pos) and float(clock) - at < 0.2:
		return Vector2(sin((float(clock) - at) * 65) * 2 * (1 - (float(clock) - at) / 0.2), 0).round()
	return Vector2.ZERO

func draw_harvest_feedback() -> void:
	for pos in worked_nodes:
		var progress = worked_nodes[pos]
		var amount = visible_node_amounts.get(pos, 0)
		if not visible_node_amounts.has(pos) or amount <= 0 or hidden_in_base(pos):
			continue
		# Five small slots show units left; the next slot empties while E is held.
		var sprite_ = worked_sprites.get(pos, null)
		if not worked_sprites.has(pos):
			continue
		var bounds_: Rect2 = Rect2(sprite_rect(sprite_, pos, 1.0))
		var at: Vector2 = Vector2(pos.x - 16, bounds_.position.y - 10).round()
		draw_rect(Rect2(at - Vector2.ONE * 2, Vector2(36, 8)), Color("141019"))
		var col: Color = CHIP_COLS[harvest_types.get(pos, 0)][0]
		for i in range(NODE_FULL):
			var slot: Vector2 = at + Vector2(i * 7, 0)
			draw_rect(Rect2(slot, Vector2(5, 4)), Color("41464B"))
			var fill: float = 1 if i < amount - 1 else 1 - clampf(progress, 0, 1) if i == amount - 1 else 0
			if fill > 0:
				draw_rect(Rect2(slot, Vector2(maxf(1, ceilf(5 * fill)), 4)), col)

func burst_chips(type: int, foot: Vector2, n: int, power: float) -> void:
	var cols = CHIP_COLS[clampi(type, 0, CHIP_COLS.size() - 1)]
	var up: float = CHIP_FROM[clampi(type, 0, CHIP_FROM.size() - 1)]
	for i in range(n):
		var ang: float = lerpf(-PI * 0.95, -PI * 0.05, randf())
		var speed: float = lerpf(50.0, 120.0, randf()) * power
		chips.append(Cs.init(Chip.new(), {"pos": foot + Vector2(lerpf(-8.0, 8.0, randf()), -up * lerpf(0.6, 1.2, randf())), "vel": Vector2.from_angle(ang) * speed, "floor_": foot.y + lerpf(-4.0, 8.0, randf()), "age": 0.0, "life": lerpf(0.6, 1.1, randf()), "size": 3 if randf() < 0.3 else 2, "col": cols[int(randi() % cols.size())]}))

# call after the depth-sorted world items
func draw_chips() -> void:
	var now: float = float(clock)
	var dt: float = clampf(now - chip_clock, 0.0, 0.1)
	chip_clock = now
	for i in range(chips.size() - 1, -1, -1):
		var c = chips[i]
		c.age += dt
		if c.age >= c.life:
			chips.remove_at(i)
			continue
		if c.pos.y < c.floor_ or c.vel.y < 0:
			c.vel.y += 420.0 * dt
			c.pos += c.vel * dt
		if c.pos.y >= c.floor_ and c.vel.y > 0:
			# a small bounce, then it lies still
			c.pos.y = c.floor_
			c.vel = Vector2(c.vel.x * 0.4, -c.vel.y * 0.3) if absf(c.vel.y) > 60.0 else Vector2.ZERO
		chips[i] = c
		var a_: float = clampf((c.life - c.age) / 0.25, 0.0, 1.0)
		var col = c.col
		col.a = a_
		draw_rect(Rect2(c.pos.round(), Vector2(c.size, c.size)), col)

# ---- src/world/view/Main.OreGlow.cs
# Owner: Vu Duc Viet Anh. Titanium nodes are dark rocks grown with blue crystals (tools/PixelNature.cs). Over the
# node the game draws its crystal layer (art/nature/node_titanium_glow_<k>.png) with a slow breathing light, and
# now and then a crystal tip (the pure white pixels of that layer) twinkles.
const ORE_NODE = "node_titanium_"
const ORE_GLOW = "node_titanium_glow_"
var ore_tips = {}

# call right after drawing a nature sprite; does nothing for anything but a titanium node
func draw_ore_glow(n, pos: Vector2, s: float) -> void:
	if not n.begins_with(ORE_NODE) or n.begins_with(ORE_GLOW):
		return
	var gn = ORE_GLOW + n.substr(ORE_NODE.length())
	var sp = spr.get(gn)
	if sp == null:
		return
	var tex = sp[0]
	var r: Rect2 = Rect2(self.sprite_rect(gn, pos, s))
	var now: float = float(clock)
	var seed_: float = pos.x * 0.37 + pos.y * 0.61
	var pulse: float = 0.5 + 0.5 * sin(now * 1.8 + seed_)
	draw_texture_rect(tex, r, false, Color(1.1, 1.25, 1.7, 0.06 + 0.2 * pulse))
	var tips = self.ore_tips_of(gn, tex)
	var px_: float = r.size.x / tex.get_width()
	for k in range(tips.size()):
		# each tip flashes for a moment once every few seconds, out of step with the others
		var phase: float = fposmod(now * 0.45 + seed_ * 0.13 + k * 0.37, 1.0)
		if phase > 0.12:
			continue
		var a_: float = sin(phase / 0.12 * PI)
		var at: Vector2 = r.position + (tips[k] + Vector2(0.5, 0.5)) * px_
		var hot = Color(1.8, 2.0, 2.6, a_)
		var soft = Color(1.2, 1.4, 2.2, a_ * 0.5)
		var arm: float = Cs.round_even(1.0 + 2.0 * a_)
		draw_rect(Rect2((at - Vector2(0.5, 0.5)).round(), Vector2.ONE), hot)
		draw_rect(Rect2((at + Vector2(-0.5 - arm, -0.5)).round(), Vector2(arm, 1)), soft)
		draw_rect(Rect2((at + Vector2(0.5, -0.5)).round(), Vector2(arm, 1)), soft)
		draw_rect(Rect2((at + Vector2(-0.5, -0.5 - arm)).round(), Vector2(1, arm)), soft)
		draw_rect(Rect2((at + Vector2(-0.5, 0.5)).round(), Vector2(1, arm)), soft)

func ore_tips_of(gn, tex) -> Variant:
	var tips = ore_tips.get(gn, null)
	if ore_tips.has(gn):
		return tips
	var list = []
	var im = tex.get_image()
	if im != null:
		if im.is_compressed():
			im.decompress()
		for y in range(im.get_height()):
			for x in range(im.get_width()):
				var c: Color = im.get_pixel(x, y)
				if c.a > 0.99 and c.r > 0.99 and c.g > 0.99 and c.b > 0.99:
					list.append(Vector2(x, y))
	tips = Array(list).duplicate()
	ore_tips[gn] = tips
	return tips

# ---- src/world/view/Main.Rivers.cs
# Owner: Vu Duc Viet Anh. Draws the two rivers of src/world/IslandRivers.cs on the ground layer, over the paths
# (a path the water cuts ends at the bank): a muddy bank, the water, a deeper channel down the middle and
# ripples drifting downstream, running out over the beach into the sea. Then the bridges: stone abutments on
# both banks, a plank deck on two beams, piles in the water under it, a rail on each side and a lantern on
# each corner post. Light from the upper left, like the rest of the island.
const RIVER_MUD: Color = Color("4E5636")
const RIVER_MUD_EDGE: Color = Color("5F6A3E")
const RIVER_WATER: Color = Color("3A6E85")
const RIVER_DEEP: Color = Color("2E5C74")
const RIVER_RIM: Color = Color(0.05, 0.09, 0.1, 0.4)
const RIVER_GLINT: Color = Color(0.7, 0.86, 0.92, 0.7)
var river_looks

static func ribbon(path, half: float) -> Variant:
	var l = offset(path, -half)
	var r = offset(path, half)
	var out = Cs.arr(l.size() + r.size(), Vector2.ZERO)
	Cs.copy_to(l, out, 0)
	for i in range(r.size()):
		out[l.size() + i] = r[r.size() - 1 - i]
	return out

# the stretch of a river from where it leaves the sea to where it reaches it again, Out tiles past the coast
static func landward(path, out: float) -> Variant:
	var a_: int = 0
	var b: int = path.size() - 1
	while a_ < b and IslandMap.depth(path[a_]) < -out:
		a_ += 1
	while b > a_ and IslandMap.depth(path[b]) < -out:
		b -= 1
	return path.slice(a_, b + 1)

func build_river_looks() -> void:
	var tl: float = float(T)
	river_looks = []
	for path in IslandMap.rivers:
		var wet = landward(path, 1.5 * tl)
		var dry = landward(path, -0.6 * tl)
		river_looks.append(Cs.init(RiverLook.new(), {"path": wet, "bank": ribbon(dry, IslandMap.RIVER_HALF + IslandMap.RIVER_BANK), "water": ribbon(wet, IslandMap.RIVER_HALF), "deep": ribbon(wet, IslandMap.RIVER_HALF * 0.45), "rim_l": offset(dry, -IslandMap.RIVER_HALF), "rim_r": offset(dry, IslandMap.RIVER_HALF), "edge_l": offset(dry, -(IslandMap.RIVER_HALF + IslandMap.RIVER_BANK)), "edge_r": offset(dry, IslandMap.RIVER_HALF + IslandMap.RIVER_BANK), "box": bounds(path, IslandMap.RIVER_HALF + IslandMap.RIVER_BANK + tl)}))

func draw_rivers(view: Rect2) -> void:
	if river_looks == null:
		build_river_looks()
	var clk: float = float(clock)
	for r in river_looks:
		if not r.box.intersects(view):
			continue
		fill_static(r.bank, RIVER_MUD * 1.08, true)
		draw_polyline(r.edge_l, RIVER_MUD_EDGE, 2)
		draw_polyline(r.edge_r, RIVER_MUD_EDGE, 2)
		fill_static(r.water, RIVER_WATER, false)
		fill_static(r.deep, RIVER_DEEP, false)
		draw_polyline(r.rim_l, RIVER_RIM, 2)
		draw_polyline(r.rim_r, RIVER_RIM, 2)
		# ripples drifting downstream (south), only those in view
		var p = r.path
		var shift: int = int(clk * 3.0)
		for i in range(shift % 5, p.size() - 1, 5):
			var at: Vector2 = p[i]
			if not view.has_point(at):
				continue
			var along: Vector2 = (p[i + 1] - at).normalized()
			var across: Vector2 = Vector2(-along.y, along.x)
			var k: int = i / 5 + shift / 5
			var side: float = (k * 7 % 5 - 2) * 0.32 * IslandMap.RIVER_HALF
			var col = RIVER_GLINT
			col.a *= 0.35 + 0.35 * sin(clk * 2.0 + k)
			var q: Vector2 = (at + across * side).round()
			draw_line(q, (q + along * 5).round(), col, 1)
	for i in range(IslandMap.bridges.size()):
		var deck: Rect2 = IslandMap.bridge_deck(i)
		if deck.grow(2 * float(T)).intersects(view):
			draw_bridge(deck.get_center(), clk)

# a bridge east-west across its river, centred on C
func draw_bridge(c: Vector2, clk: float) -> void:
	var l: float = Cs.round_even(IslandMap.BRIDGE_HALF_LEN)
	var w: float = Cs.round_even(IslandMap.BRIDGE_HALF_W)
	var rh: float = IslandMap.RIVER_HALF
	draw_set_transform(c.round())
	# shadow on the water and the piles under the deck, with a ring of ripples round each
	draw_rect(Rect2(-rh + 4, w + 2, 2 * rh - 4, 14), Color(0, 0, 0, 0.28))
	for x in [-Cs.round_even(rh * 0.45), Cs.round_even(rh * 0.45)]:
		draw_rect(Rect2(x - 5, w - 4, 10, 18), Color("3F3122"))
		draw_rect(Rect2(x - 5, w - 4, 3, 18), Color("5E4A33"))
		var wob: float = sin(clk * 2.2 + x) * 1.5
		draw_arc(Vector2(x, w + 15), 8 + wob, 0, PI, 8, Color(0.75, 0.88, 0.92, 0.45), 1)
	# stone abutments on both banks: blocks, a pale top edge and a dark front face
	for end in [-1, 1]:
		var x0: float = -l if end < 0 else rh - 8
		var x1: float = -rh + 8 if end < 0 else l
		var block = Rect2(x0, -w - 6, x1 - x0, 2 * w + 12)
		draw_rect(block, Color("858069"))
		draw_rect(Rect2(x0, w + 6, x1 - x0, 7), Color("5A5646"))
		var y: float = -w - 6
		var row: float = 0
		while y < w + 6:
			draw_line(Vector2(x0, y), Vector2(x1, y), Color("6A6655"), 1)
			var x: float = x0 + (6 if fmod(row, 2) == 0 else 14)
			while x < x1:
				draw_line(Vector2(x, y), Vector2(x, minf(y + 10, w + 6)), Color("6A6655"), 1)
				x += 16
			y += 10
			row += 1
		draw_line(Vector2(x0, -w - 6), Vector2(x1, -w - 6), Color("B4AE93"), 2)
		draw_rect(Rect2(x0, w + 13, x1 - x0, 2), Color(0, 0, 0, 0.25))
	# the deck: planks across it on a dark frame, worn lighter down the middle where everyone walks
	var d0: float = -l + 8
	var d1: float = l - 8
	draw_rect(Rect2(d0, -w + 2, d1 - d0, 2 * w - 4), Color("3A2D21"))
	var wood = ["A47F4F", "967349", "8B6A43", "AB8A59", "9C7A4C"]
	var n: int = 0
	var x: float = d0 + 1
	while x < d1 - 1:
		var h: int = (n * 37 + 11) % 23
		var plank = Color(wood[h % wood.size()])
		if h == 0:
			plank = plank.darkened(0.2)
		var wd: float = minf(8, d1 - 1 - x)
		draw_rect(Rect2(x, -w + 4, wd, 2 * w - 8), plank)
		draw_line(Vector2(x, -w + 4), Vector2(x, w - 4), plank.lightened(0.18), 1)
		draw_rect(Rect2(x + 3, -w + 8, 2, 2), Color("3A3430"))
		draw_rect(Rect2(x + 3, w - 10, 2, 2), Color("3A3430"))
		if h % 7 == 3:
			draw_line(Vector2(x + 2, -6 + h), Vector2(x + 2, 4 + h), plank.darkened(0.25), 1)
		x += 9
		n += 1
	draw_rect(Rect2(d0, -16, d1 - d0, 32), Color(1, 1, 0.9, 0.06))
	# the two beams along its sides; the near one shows its face
	draw_rect(Rect2(d0 - 2, -w, d1 - d0 + 4, 6), Color("5C4630"))
	draw_line(Vector2(d0 - 2, -w), Vector2(d1 + 2, -w), Color("8C6C46"), 1)
	draw_rect(Rect2(d0 - 2, w - 6, d1 - d0 + 4, 6), Color("5C4630"))
	draw_rect(Rect2(d0 - 2, w, d1 - d0 + 4, 5), Color("3A2C1E"))
	# rails: posts with a top rail and a lower rail, the far side first
	for side in [-1, 1]:
		var base: float = -w + 2 if side < 0 else w - 2
		var top: float = base - 15
		var posts: int = 7
		for k in range(posts):
			x = Cs.round_even(lerpf(d0 + 6, d1 - 6, float(k) / (posts - 1)))
			var corner: bool = k == 0 or k == posts - 1
			var pw: float = 7 if corner else 5
			draw_rect(Rect2(x - pw / 2, top - (3 if corner else 0), pw, base - top + (3 if corner else 0)), Color("54412C"))
			draw_rect(Rect2(x - pw / 2, top - (3 if corner else 0), 1, base - top + (3 if corner else 0)), Color("8A6C47"))
			if corner:
				# a lantern on each corner post, glowing after dark
				draw_rect(Rect2(x - 3, top - 9, 6, 6), Color("2C2620"))
				draw_rect(Rect2(x - 2, top - 8, 4, 4), Color("F2C94C"))
				var glow: float = 0.12 + 0.04 * sin(clk * 3.0 + x)
				draw_circle(Vector2(x, top - 6), 9, Color(1.0, 0.82, 0.4, glow))
		draw_rect(Rect2(d0 + 4, top, d1 - d0 - 8, 4), Color("B08E5C"))
		draw_line(Vector2(d0 + 4, top), Vector2(d1 - 4, top), Color("D4B47C"), 1)
		draw_line(Vector2(d0 + 4, top + 4), Vector2(d1 - 4, top + 4), Color(0, 0, 0, 0.3), 1)
		draw_rect(Rect2(d0 + 4, top + 8, d1 - d0 - 8, 2), Color("8E7048"))
	draw_set_transform(Vector2.ZERO)

