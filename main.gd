func expedition_items(items, view: Rect2) -> void:
	if interior_active:
		return
	var w = geometry
	var i: int = 0
	while i < w.expedition_vehicles.size():
		var v = w.expedition_vehicles[i]
		if Cs.has_point(view.grow(155), v.pos):
			items.append([v.pos.y, 16, i])
		i += 1
	i = 0
	while i < w.expedition_cliffs.size():
