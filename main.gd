func front_sprite(n, at, scale, col) -> void:
	if not spr.has(n):
		return
	var tex = spr[n][0]
	front.draw_texture_rect(self.pixel(tex), Rect2(at - spr[n][1] * scale, tex.get_size() * scale), false, col)

func draw_frontend() -> void:
	var c = front
	var vs = c.size
	var w = vs.x
	var h = vs.y
	c.draw_rect(Rect2(Vector2.ZERO, vs), Color("0B1420"))
	# A quiet sea and distant islands, drawn in the same hard-edged language as the sprites.
	c.draw_rect(Rect2(0, h * 0.48, w, h * 0.52), Color("102230"))
	c.draw_colored_polygon(PackedVector2Array([Vector2(0, h * 0.55), Vector2(w * 0.15, h * 0.38), Vector2(w * 0.23, h * 0.5), Vector2(w * 0.4, h * 0.34), Vector2(w * 0.59, h * 0.55)]), Color("152936"))
	for i in 38:
		var x = fmod(i * 139.0 + clock * (3 + i % 3), w)
		var y = h * 0.52 + fmod(i * 43.0, h * 0.48)
		c.draw_line(Vector2(x, y), Vector2(x + 12 + i % 5 * 8, y), Color(0.3, 0.5, 0.57, 0.12), 1)
	var moon = Vector2(w * 0.47, h * 0.25)
	c.draw_circle(moon, 38, Color(0.58, 0.72, 0.76, 0.035))
	c.draw_circle(moon, 27, Color("A0B4B8"))
	c.draw_circle(moon + Vector2(10, -7), 25, Color("0B1420"))
	# A small island vignette uses the actual in-game lighthouse and nature art.
	var foot = Vector2(w * 0.32, h * 0.88)
	c.draw_colored_polygon(PackedVector2Array([foot + Vector2(-200, 9), foot + Vector2(-125, -23), foot + Vector2(4, -33), foot + Vector2(130, -12), foot + Vector2(190, 11), foot + Vector2(90, 32), foot + Vector2(-95, 29)]), Color("1A3037"))
	# the lamp sits 7 px below the top of the lighthouse sprite
	var lamp = foot - Vector2(0, (prop.lighthouse[1].y - 7) * 2.4) if prop.has("lighthouse") else foot + Vector2(0, -159)
	var sweep = sin(clock * 0.25) * 30
	c.draw_colored_polygon(PackedVector2Array([lamp, lamp + Vector2(240, -105 + sweep), lamp + Vector2(245, -12 + sweep)]), Color(0.92, 0.72, 0.32, 0.055))
	c.draw_colored_polygon(PackedVector2Array([lamp, lamp + Vector2(-245, -70 - sweep), lamp + Vector2(-245, -8 - sweep)]), Color(0.92, 0.72, 0.32, 0.04))
	self.front_sprite("pine_2", foot + Vector2(-112, -15), 2.4, Color("577276"))
	self.front_sprite("pine_3", foot + Vector2(106, -5), 2.4, Color("52656A"))
	if prop.has("lighthouse"):
		var p = prop.lighthouse
		var tex = p[0]
		c.draw_texture_rect(self.pixel(tex), Rect2(foot - p[1] * 2.4, tex.get_size() * 2.4), false, Color("B1C0BD"))
	c.draw_circle(lamp, 14, Color(1.0, 0.7, 0.25, 0.05))
	c.draw_circle(lamp, 4, Color("F3CC76"))
	for i in 10:
		var spark = foot + Vector2(sin(i * 7.2 + clock * 0.3) * 150, -fmod(i * 29 + clock * 9, 150))
		c.draw_rect(Rect2(spark, Vector2(2, 2)), Color(0.85, 0.72, 0.4, 0.18 + 0.12 * sin(clock + i)))
	# Masthead and footer frame both connection and crew screens.
	c.draw_rect(Rect2(32, 25, 20, 24), GOLD)
	c.draw_rect(Rect2(40, 29, 4, 13), Color("14212C"))
	c.draw_rect(Rect2(37, 33, 10, 4), Color("14212C"))
	self.text(c, Vector2(62, 36), "HOLD 'TIL DAWN", 15, Color("D6DFDD"), 0, -1, true)
	self.text(c, Vector2(62, 49), "CO-OP SURVIVAL / ISLAND WATCH", 9, Color("6F8A99"))
	self.text(c, Vector2(w - 215, 36), "THE LONG NIGHT AWAITS", 10, Color("8DA4AC"))
	for i in 5:
		c.draw_rect(Rect2(w - 105 + i * 14, 44, 8, 3), GOLD if i == 0 else Color("334955"))
	if menu_panel.visible:
		self.text(c, Vector2(40, 160), "HOLD 'TIL", 60, Color("E7E4D8"), 0, -1, true)
		self.text(c, Vector2(40, 240), "DAWN", 76, GOLD, 0, -1, true)

func get_player_name() -> Variant:
	return name_edit.text.strip_edges() if name_edit.text.strip_edges() != "" else "Player"

func key(k) -> Variant:
	return 1.0 if Input.is_physical_key_pressed(k) else 0.0

func doors_open() -> Variant:
	var night: bool = snap.get("ph", "") == "night"
	return snap.doors.map(func(d): return not night or d <= 0)

func breach() -> Variant:
	for d in snap.doors:
		if d <= 0:
			return true
	return false

func draw_activity(foot, aim, activity) -> void:
	if activity == "repair":
		var centre = foot - Vector2(0, 15)
		var angle = aim + sin(clock * 12) * 0.8
		var tip = centre + Vector2.from_angle(angle) * 20
		var side = Vector2.from_angle(angle).orthogonal() * 5
		draw_line(centre, tip, INK, 5)
		draw_line(centre, tip, Color("AD7C48"), 3)
		draw_line(tip - side, tip + side, INK, 7)
		draw_line(tip - side, tip + side, Color("B9C6CC"), 4)
	elif activity in ["heal", "revive"]:
		var centre = foot - Vector2(0, 18)
		var pulse = 0.7 + 0.3 * sin(clock * 8)
		draw_line(centre - Vector2(4, 0), centre + Vector2(4, 0), Color(0.4, 1.8, 0.7, pulse), 3)
		draw_line(centre - Vector2(0, 4), centre + Vector2(0, 4), Color(0.4, 1.8, 0.7, pulse), 3)

# ---- src/ai/view/Main.EnemyView.cs
# Owner: Vu Duc Viet Anh. How enemies and bosses look on the client: sprite choice, tint, attack and death
# frames, health bars, boss bar.
# Sprite sheets in art/chars/ belong to Mai Thien Ngon; this file only maps enemy state to them.
static var ENEMY_SKIN = ["grunt", "spitter", "wrecker", "wrecker"]
static var ENEMY_TINT = [Color.WHITE, Color.WHITE, Color.WHITE, Color.WHITE]
# sprite sheet per boss archetype, in GameSim.BOSS_KINDS order (Juggernaut .. Ironhide)
static var BOSS_SKIN = ["boss_juggernaut", "boss_broodmother", "boss_bio_cannon", "boss_burrower", "boss_gatebreaker", "boss_phantom", "boss_ironhide"]
# boss moves with a wind-up: it holds the first attack frame (arms up) until the move lands
static var BOSS_WIND = {"glow": true, "charge_wind": true, "blow": true, "slam": true, "ambush": true}
# a dead enemy plays its "down" frames where it fell, lies there, then fades (seconds)
const CORPSE_TIME: float = 2.4
# a dead enemy plays its "down" frames where it fell, lies there, then fades (seconds)
const CORPSE_FADE: float = 0.6
# 3x replaces 2x: every boss, including attacks and corpses, is 1.5 times its former size.
# Integer scaling preserves the pixel edges; gameplay collision/reach still use the simulation radius.
const BOSS_DRAW_SCALE: float = 3.0
# what each enemy on screen was last drawn as (by id), so it can fall over where it died
var en_seen = {}
var corpses = []
# bosses holding a wind-up, and when their move landed
var winding = {}
var strike_at = {}

# Enemies drawn last frame that are gone from the snapshot died (or the night ended under them): they fall.
func note_fallen(shown) -> void:
	for key_ in Array(en_seen.keys()).duplicate():
		var _d1 = en_seen[key_]
		var id = _d1[0]
		var look = _d1[1]
		if not shown.has(id):
			look.at = float(clock)
			corpses.append(look)
			en_seen.erase(key_)

# out of a match: nothing carries over to the next one
func forget_fallen() -> void:
	en_seen.clear()
	corpses.clear()
	winding.clear()
	strike_at.clear()

# depth items [foot y, 12, index] for the corpses still showing
func corpse_items(items) -> void:
	Cs.remove_all(corpses, func(c): return float(clock) - c.at > CORPSE_TIME)
	var i: int = 0
	while i < corpses.size():
		# under anyone standing on the same spot
		items.append([corpses[i].foot.y - 1.0, 12, i])
		i += 1

func draw_corpse(i: int) -> void:
	var c = corpses[i]
	var t: float = float(clock) - c.at
	var mod_: Color = c.mod
	mod_.a *= clampf((CORPSE_TIME - t) / CORPSE_FADE, 0.0, 1.0)
	self.char_(c.key, c.skin, c.foot, null, c.s, mod_, false, "idle", "down", t)

# Ground markers of boss moves (BAL-43): circle (slam, surfacing), line (charge) and arc (ambush).
# The inner fill grows as the hit comes closer.
func draw_telegraphs() -> void:
	for tl in snap.get("tele", []):
		var pos: Vector2 = Vector2(tl[0])
		var r: float = float(tl[1])
		var left: float = float(tl[2])
		var kind = Cs.s(tl[3]) if tl.size() > 3 else "circle"
		if kind == "line":
			var end: Vector2 = Vector2(tl[4])
			var side: Vector2 = (end - pos).normalized().orthogonal() * r
			var quad = [pos + side, end + side, end - side, pos - side]
			draw_colored_polygon(quad, Color(1.0, 0.1, 0.3, 0.18))
			var mid: Vector2 = pos.lerp(end, 1.0 - left)
			draw_colored_polygon([pos + side, mid + side, mid - side, pos - side], Color(1.0, 0.15, 0.3, 0.3))
			draw_polyline([pos + side, end + side, end - side, pos - side, pos + side], NEON_RED, 2)
			continue
		if kind == "arc":
			var ang: float = float(tl[5])
			var half: float = float(tl[6]) / 2
			draw_colored_polygon(arc_fan(pos, r, ang, half), Color(1.0, 0.1, 0.3, 0.18))
			draw_colored_polygon(arc_fan(pos, r * (1.0 - left), ang, half), Color(1.0, 0.15, 0.3, 0.35))
			draw_arc(pos, r, ang - half, ang + half, 24, NEON_RED, 3)
			continue
		draw_circle(pos, r, Color(1.0, 0.1, 0.3, 0.16))
		draw_circle(pos, r * (1.0 - left), Color(1.0, 0.15, 0.3, 0.35))
		draw_arc(pos, r, 0, TAU, 48, NEON_RED, 3)

static func arc_fan(c: Vector2, r: float, ang: float, half: float) -> Variant:
	var pts = Cs.arr(18, Vector2.ZERO)
	pts[0] = c
	for i in range(17):
		pts[i + 1] = c + Vector2.from_angle(ang - half + 2 * half * i / 16.0) * maxf(r, 1.0)
	return pts

func draw_enemy(e, foot) -> void:
	var ty: int = int(e[1])
	var look = Cs.s(e[7]) if e.size() > 7 else ""
	# each boss archetype has its own sheet (art/chars/boss_*.png from tools/PixelBosses.cs)
	var skin = BOSS_SKIN[int(e[6])] if ty == GameSim.BOSS else ENEMY_SKIN[ty]
	var key_ = "e%d" % [e[0]]
	if look == "cloak":
		en_seen.erase(key_)
		# the Phantom is invisible while cloaked; only a faint shimmer gives it away up close
		if local_pos.distance_to(foot) < 2.5 * T:
			draw_arc(foot - Vector2(0, 16), e[5] * 0.8, 0, TAU, 24, Color(0.8, 0.7, 1.0, 0.18), 2)
		return
	if look == "burrow" or look == "surface":
		# the Burrower underground: a moving dirt mound
		en_seen.erase(key_)
		self.shadow(foot, e[5] * 0.9)
		draw_circle(foot - Vector2(0, 3), e[5] * 0.6, Color("5A4632"))
		draw_circle(foot - Vector2(0, 6), e[5] * 0.35, Color("7A6046"))
		return
	# the character's own size (the sheet cell has room around it for its attack)
	var size: float = float(cinfo.chars[skin].get("body", cinfo.chars[skin].size))
	# GDD size in tiles over the sprite's own size: the 40 px Wrecker is drawn 1:1. A boss is drawn much bigger
	# than its body (BOSS_DRAW_SCALE), so it towers over the players but still fits through a door.
	var s: float = BOSS_DRAW_SCALE if ty == GameSim.BOSS else float(e[5] / (0.5 * T) * 32.0 / size)
	var mod_: Color = ENEMY_TINT[ty]
	if ty == GameSim.BOSS:
		mod_ = Color.WHITE
		# wind-ups glow; recovery, stagger and climb-out (the weak windows) look dim
		if look == "glow" or look == "charge_wind" or look == "blow" or look == "slam" or look == "ambush":
			mod_ = mod_.lerp(Color(2.2, 1.6, 0.6), 0.5 + 0.5 * sin(clock * 18.0))
		elif look == "recover" or look == "stagger" or look == "climb":
			mod_ = mod_.darkened(0.35)
		elif look == "shown":
			mod_ = mod_.lerp(Color(0.8, 0.7, 1.0), 0.4)
	en_seen[key_] = [e[0], Cs.init(Fallen.new(), {"key": key_, "skin": skin, "s": s, "mod": ENEMY_TINT[ty], "foot": Vector2(foot)})]
	if flash.has(e[0]):
		mod_ = Color(2.0, 2.0, 2.0)
	# attack frames: on each hit or spit (snapshot field 9); a boss holds the wind-up frame through its
	# wind-up and strikes when the move lands
	var play = null
	var play_t: float = 0.0
	var now: float = float(clock)
	var start: float = self.swing_start(key_, e.size() > 9 and e[9])
	if ty == GameSim.BOSS and BOSS_WIND.has(look):
		Cs.set_add(winding, key_)
		play = "attack"
	else:
		if winding.erase(key_):
			# straight to the slam (frame 1 of 4 at 10 frames/s)
			strike_at[key_] = now - 0.1
		var sa = strike_at.get(key_, 0.0)
		var from: float = maxf(start, sa if strike_at.has(key_) else -1.0)
		if from >= 0 and now - from < self.anim_length(skin, "attack"):
			play = "attack"
			play_t = now - from
	self.char_(key_, skin, foot, null, s, mod_, false, "idle", play, play_t)
	if e.size() > 10 and e[10]:
		var at: Vector2 = Vector2(foot) - Vector2(0, size * s * 0.65)
		draw_arc(at, 9.0, 0, TAU, 12, Color("DDD681"), 2.0)
		for i in range(3):
			draw_circle(at + Vector2.from_angle(i * TAU / 3 + float(clock) * 3) * 9.0, 2.0, Color("FFF3B4"))
	if e.size() > 11 and e[11]:
		draw_arc(Vector2(foot), float(e[5]), 0, TAU, 20, Color("83DDD8"), 3.0)
	if e[3] < e[4] and ty != GameSim.BOSS:
		self.bar(foot - Vector2(0, size * 0.7 * s + 4), e[5] * 2.2, e[3] / e[4], NEON_RED)
# --- HUD drawing (screen space) -----------------------------------------
# Night: how many of the night's enemies are down, under the generator panel. It fills as they die; full (and
# the three supplies in) means dawn comes (GameSim.NightSpawns.cs).
const NIGHT_BAR_H: float = 30.0

func draw_night_bar(c, cx: float) -> void:
	if snap.get("ph", "") != "night":
		return
	var nq = snap.get("nq", null)
	if nq == null or int(nq[1]) <= 0:
		return
	var down: int = int(nq[0])
	var all: int = int(nq[1])
	var frac: float = clampf(float(down) / all, 0.0, 1.0)
	var box_ = Rect2(cx - 160, 56, 320, NIGHT_BAR_H - 4)
	var cw = c
	self.panel(cw, box_)
	self.text(cw, Vector2(cx - 150, 70), "NIGHT %d" % [snap.k], 11, GOLD, 0, -1.0, true)
	var bar_ = Rect2(cx - 90, 64, 240, 7)
	c.draw_rect(bar_.grow(1), INK)
	c.draw_rect(bar_, Color(0.22, 0.24, 0.3))
	# red while the night still has enemies, green once the last one is down
	var fill: Color = Color("3DBE5A") if frac >= 1.0 else NEON_RED.lerp(Color("F2B544"), frac)
	c.draw_rect(Rect2(bar_.position, Vector2(bar_.size.x * frac, bar_.size.y)), fill)

func draw_boss_bar(c, cx) -> void:
	for e in snap.en:
		if e[1] == GameSim.BOSS:
			# below the night bar
			var dy: float = NIGHT_BAR_H if snap.get("ph", "") == "night" else 0.0
			var br = Rect2(cx - 230, 66 + dy, 460, 10)
			self.text(c, Vector2(cx - 230, 62 + dy), GameSim.boss_title(e[6]).to_upper(), 12, NEON_PINK, 1, 460, true)
			c.draw_rect(br.grow(2), INK)
			c.draw_rect(Rect2(br.position, Vector2(br.size.x * e[3] / e[4], br.size.y)), NEON_PINK)
			for x in [br.position.x - 6, br.end.x + 6]:
				self.diamond(c, Vector2(x, br.get_center().y), 8, NEON_PINK)

# ---- src/gameplay/view/Main.Anim.cs
# Owner: Pham Minh Hieu. Which one-shot sprite animation a player plays. The frames are in the character sheets
# (art/chars/*.png, drawn by tools/PixelPoses.cs; chars.json "anims" says where they are):
#   attack_fists  - bare hands: guard, jab, impact, back to guard
#   attack_spear  - stone spear: drawn back, thrust, full reach, recover
#   attack_blade  - titanium blade: raised, slash across, follow-through, recover
#   attack_hammer - hammer: lifted overhead, coming down, smashed into the ground, recover
#   attack_bow    - starter bow and bow: nock, full draw, release, recover (the arrow is its own sprite)
#   long spear and stun maul play the spear / hammer frames with their own weapon drawn moving over them,
#   and a thrown flask, a set trap or a drunk tonic plays the jab frames (src/gameplay/view/Main.TacticalItems.cs)
#   down          - knocked down: hit, knees give, falling, lying still until revived
# An attack starts when GameSim's P.Swing does (MEC-02, MEC-03) and plays once.
# per character: when its current swing was first and last seen
var swings = {}
# per player: when they were first seen knocked down
var down_since = {}
static var WEAPON_ANIM = {"explosive_arrow": "attack_bow", "long_spear": "attack_spear", "stun_maul": "attack_hammer", "fists": "attack_fists", "stone_spear": "attack_spear", "titanium_blade": "attack_blade", "hammer": "attack_hammer", "starter_bow": "attack_bow", "bow": "attack_bow"}

# The snapshot only says "swinging now", so a swing seen again after a gap is a new one.
# Returns when the latest swing started, or -1 if none was seen yet.
func swing_start(key_, flag: bool) -> float:
	var now: float = float(clock)
	var s = swings.get(key_, Swing.new())
	if flag:
		if not s.any or now - s.seen > 0.06:
			s.start = now
			s.any = true
		s.seen = now
		swings[key_] = s
	return s.start if s.any else -1.0

# seconds a one-shot animation of a sheet lasts (0 when the sheet has no animation of that name)
func anim_length(skin, name) -> float:
	var c = cinfo.chars.get(skin, null)
	var a_ = null if c == null else c.get("anims", {}).get(name, null)
	return 0.0 if a_ == null else float(a_[1]) / float(a_[2])

# the attack of the weapon a player holds and how far into it they are (null when not attacking)
func player_attack(id, p, skin) -> Variant:
	var start: float = self.swing_start(Cs.s(id), p[11])
	if start < 0:
		return null
	var weapon = Cs.s(p[8])
	var hand = p[7][int(p[25])]
	if hand != null and Cs.s(hand[0]) == "explosive_arrow":
		weapon = "explosive_arrow"
	var n = WEAPON_ANIM.get(weapon, null)
	var name = n if WEAPON_ANIM.has(weapon) else "attack_fists"
	# throwing a flask or setting a trap: an overhand throw (the jab frames); drinking a tonic too
	if hand != null and GameSim.is_tactical_use(Cs.s(hand[0])) and Cs.s(hand[0]) != "explosive_arrow":
		name = "attack_fists"
	var t: float = float(clock) - start
	return [name, t] if t < self.anim_length(skin, name) else null

# seconds since a player went down (the fall plays once, then they lie still); forgets them once they are up
func down_time(id, down: bool) -> float:
	var key_ = Cs.s(id)
	if not down:
		down_since.erase(key_)
		return 0.0
	var since = down_since.get(key_, 0.0)
	if not down_since.has(key_):
		since = float(clock)
		down_since[key_] = since
	return float(clock) - since

# ---- src/gameplay/view/Main.TacticalItems.cs
# Owner: Pham Minh Hieu. How the tactical items look in use:
#   flasks   - fly from the thrower in an arc, then splash and leave their pulsing area
#   vine trap - sprouts out of the ground, then waits with its vines curling
#   blast    - the explosive arrow's burst: a flash, a ring and flying sparks
#   haste    - streaks behind a hasted runner and sparks round their feet
#   long spear / stun maul - drawn moving over the spear / hammer frames: a thrust out and back, an overhead
#   blow that lands with a shock ring and stars
# when this client first saw each tactical area (by kind and spot), for its opening animation
var area_seen = {}
# seconds a thrown flask flies before it splashes
const FLASK_FLIGHT: float = 0.3

func draw_tactical_areas() -> void:
	var now: float = float(clock)
	var live = {}
	for a_ in snap.get("tactical", []):
		var kind = Cs.s(a_[0])
		var at: Vector2 = Vector2(a_[1])
		var key_ = [kind, at]
		Cs.set_add(live, key_)
		var seen = area_seen.get(key_, 0.0)
		if not area_seen.has(key_):
			seen = now
			area_seen[key_] = seen
		var age: float = now - seen
		if kind == "trap":
			draw_trap(at, age)
			continue
		var tint_: Color = Color("6CE4BA" if kind == "heal" else "A1C64A" if kind == "poison" else "FF9B45")
		if kind == "blast":
			draw_blast(at, age, tint_)
			continue
		# a flask: in the air first (only for one thrown just now: an old area seen late has no flight)
		var left: float = float(a_[2])
		var fresh: bool = left > 5.0 - FLASK_FLIGHT - 0.1
		if fresh and age < FLASK_FLIGHT:
			var from: Vector2 = thrower_pos(a_[3] if a_.size() > 3 else null, at)
			draw_flask_flight(from, at, age / FLASK_FLIGHT, kind)
			continue
		var open: float = clampf((age - FLASK_FLIGHT) / 0.25, 0.0, 1.0) if fresh else 1.0
		var r: float = 1.8 * T * ease(open, 0.4)
		draw_circle(at, r, Color(tint_, 0.13))
		draw_arc(at, r, 0, TAU, 32, Color(tint_, 0.8), 2.0)
		if fresh and open < 1.0:
			# the splash: glass and drops thrown out
			for i in range(8):
				var d: Vector2 = Vector2.from_angle(i * TAU / 8 + 0.3)
				var p: Vector2 = at + d * (6 + 26 * open) - Vector2(0, 10 * sin(open * PI))
				draw_rect(Rect2(p.round(), Vector2(2, 2)), Color(tint_.lightened(0.3), 1 - open))
		for i in range(5):
			var p: Vector2 = at + Vector2.from_angle(i * TAU / 5 + now * 0.25) * (r * 0.55)
			p.y -= 3.0 + 3.0 * sin(now * 3 + i)
			if kind == "heal":
				draw_line(p - Vector2.RIGHT * 3, p + Vector2.RIGHT * 3, tint_, 2.0)
				draw_line(p - Vector2.DOWN * 3, p + Vector2.DOWN * 3, tint_, 2.0)
			else:
				draw_rect(Rect2(p.round(), Vector2(3, 3)), tint_)
	# forget areas that are gone
	if area_seen.size() > live.size():
		var gone = []
		for k in area_seen.keys():
			if not live.has(k):
				gone.append(k)
		for k in gone:
			area_seen.erase(k)

func thrower_pos(owner, fallback: Vector2) -> Vector2:
	if owner == null:
		return fallback
	if owner == my_id:
		return Vector2(local_pos)
	var p = snap.ps.get(owner, null)
	return fallback if p == null else Vector2(shown_p.get(owner, p[2]))

# a flask tumbling along a throw arc
func draw_flask_flight(from: Vector2, to: Vector2, k: float, kind) -> void:
	var ground_: Vector2 = from.lerp(to, k)
	var height: float = 18 + 34 * sin(k * PI)
	self.shadow(ground_, 4)
	var at: Vector2 = ground_ - Vector2(0, height)
	draw_set_transform(at, k * 9.0, Vector2.ONE)
	draw_item_icon(self, "healing_flask" if kind == "heal" else "poison_flask", Vector2.ZERO, 1.0)
	draw_set_transform(Vector2.ZERO)

# a vine trap sprouting, then waiting
func draw_trap(at: Vector2, age: float) -> void:
	var grow: float = clampf(age / 0.35, 0.0, 1.0)
	var s: float = ease(grow, 0.4) * (1.0 + 0.25 * sin(grow * PI))
	var green = Color("98BE56")
	draw_arc(at, 17.0 * s, 0, TAU, 16, green, 2.0)
	# curling vines
	for i in range(4):
		var a_: float = i * TAU / 4 + float(clock) * 0.6
		var root: Vector2 = at + Vector2.from_angle(a_) * 12.0 * s
		var tip: Vector2 = root + Vector2(0, -6.0 * s) + Vector2.from_angle(a_ + 1.2) * 3.0 * sin(float(clock) * 3 + i)
		draw_line(root, tip, Color("5E8A34"), 2.0)
	if s > 0.05:
		draw_set_transform(at, 0, Vector2.ONE * s)
		draw_item_icon(self, "vine_trap", Vector2.ZERO, 1.0)
		draw_set_transform(Vector2.ZERO)
	if grow < 1.0:
		# soil kicked up as it bursts out
		for i in range(6):
			var p: Vector2 = at + Vector2.from_angle(i * TAU / 6) * (8 + 14 * grow) - Vector2(0, 8 * sin(grow * PI))
			draw_rect(Rect2(p.round(), Vector2(2, 2)), Color("7A6046", 1 - grow))

# the explosive arrow's burst over its short life
func draw_blast(at: Vector2, age: float, tint_: Color) -> void:
	var k: float = clampf(age / 0.35, 0.0, 1.0)
	var r: float = 1.5 * T
	draw_circle(at, r * (0.3 + 0.7 * k), Color(2.2, 1.5, 0.6, 0.5 * (1 - k)))
	draw_arc(at, r * (0.4 + 0.8 * k), 0, TAU, 32, Color(tint_, 1 - k), 3.0)
	for i in range(10):
		var d: Vector2 = Vector2.from_angle(i * TAU / 10 + 0.4)
		var p: Vector2 = at + d * r * (0.2 + 0.9 * k) - Vector2(0, 14 * sin(k * PI))
		draw_rect(Rect2(p.round(), Vector2(3, 3)), Color(1.8, 1.2, 0.5, 1 - k))

# haste: streaks behind a runner and sparks at the feet
func draw_haste(id, p, foot: Vector2) -> void:
	if p.size() <= 30 or not p[30]:
		return
	var m = cmove.get(id, null)
	var now: float = float(clock)
	var moving: bool = m != null and now - float(m[1]) < 0.15
	var gold = Color("F0C76B")
	if moving:
		var back: Vector2 = -Vector2.from_angle(float(m[2]))
		for i in range(3):
			var s: Vector2 = foot + Vector2(0, -8 - i * 9) + back * 10
			draw_line(s, s + back * (14 + 6 * sin(now * 20 + i)), Color(gold, 0.6), 2.0)
	for i in range(3):
		var k: float = fmod(now * 1.5 + i / 3.0, 1.0)
		var s: Vector2 = foot + Vector2(-9 + i * 9, -k * 22)
		draw_rect(Rect2(s.round(), Vector2(2, 2)), Color(gold, 1 - k))

func draw_tactical_weapon(id, p, foot: Vector2, aim: float) -> void:
	draw_haste(id, p, foot)
	var w = Cs.s(p[8])
	if not p[11] or not (w == "long_spear" or w == "stun_maul"):
		return
	var start: float = self.swing_start(Cs.s(id), true)
	var k: float = clampf((float(clock) - start) / 0.25, 0.0, 1.0)
	var dir: Vector2 = Vector2.from_angle(aim)
	var side: Vector2 = dir.orthogonal()
	var hand: Vector2 = foot - Vector2(0, 18)
	var ink = Color(0.08, 0.07, 0.1)
	if w == "long_spear":
		# drawn back, driven out to full reach, pulled back
		var out: float = -8.0 * (k / 0.25) if k < 0.25 else lerpf(-8.0, 22.0, (k - 0.25) / 0.3) if k < 0.55 else lerpf(22.0, 4.0, (k - 0.55) / 0.45)
		var butt: Vector2 = hand - dir * 12 + dir * out
		var tip: Vector2 = hand + dir * 46 + dir * out
		draw_line(butt, tip, ink, 5)
		draw_line(butt, tip, Color("C39058"), 3)
		draw_colored_polygon([tip + dir * 13, tip + side * 5, tip - side * 5], Color("DBE9D7"))
		draw_polyline([tip + dir * 13, tip + side * 5, tip - side * 5, tip + dir * 13], ink, 1.5)
		if k > 0.35 and k < 0.75:
			# the thrust streak
			var a_: float = 1.0 - absf(k - 0.55) / 0.2
			draw_line(tip + dir * 15 - side * 3, tip + dir * 34 - side * 3, Color(1, 1, 1, 0.6 * a_), 2.0)
			draw_line(tip + dir * 15 + side * 3, tip + dir * 30 + side * 3, Color(1, 1, 1, 0.6 * a_), 2.0)
	else:
		# raised high behind, brought down hard in front, a shock where it lands
		var swing: float = lerpf(0.0, -0.4, k / 0.3) if k < 0.3 else lerpf(-0.4, 1.0, ease(clampf((k - 0.3) / 0.3, 0.0, 1.0), 2.4))
		var lift: float = (1.0 - swing) * 22.0
		var head: Vector2 = hand + dir * (12 + 18 * swing) - Vector2(0, lift)
		draw_line(hand, head, ink, 6)
		draw_line(hand, head, Color("B48550"), 4)
		var hd: Vector2 = (head - hand).normalized()
		var hs: Vector2 = hd.orthogonal()
		var block = [head + hd * 6 + hs * 12, head + hd * 6 - hs * 12, head - hd * 6 - hs * 12, head - hd * 6 + hs * 12]
		draw_colored_polygon(block, Color("A0CEE0"))
		draw_polyline([block[0], block[1], block[2], block[3], block[0]], ink, 1.5)
		if k >= 0.6:
			var i: float = (k - 0.6) / 0.4
			var ground_: Vector2 = foot + dir * 30
			draw_set_transform(ground_, 0, Vector2(1.0, 0.45))
			draw_arc(Vector2.ZERO, 8 + 22 * i, 0, TAU, 24, Color("DDD681", 1 - i), 2.5)
			draw_set_transform(Vector2.ZERO)
			for s in range(3):
				draw_circle(ground_ - Vector2(0, 12 + 6 * i) + Vector2.from_angle(s * TAU / 3 + i * 4) * 9, 2.0, Color("FFF3B4", 1 - i))

# ---- src/world/view/Main.BaseArrow.cs
# Owner: Vu Duc Viet Anh. Outside the base a small arrow circles your character and always points at the base
# (its centre, the lighthouse), so you never lose your way home.
# how far from the character's centre the arrow sits, in screen pixels
const BASE_ARROW_R: float = 62.0
const BASE_ARROW_COL: Color = Color(1.0, 0.78, 0.32)

func draw_base_arrow(c, ct: Transform2D) -> void:
	var me = snap.ps.get(my_id)
	if me == null or int(me[5]) == 2 or GameSim.inside_base(local_pos):
		return
	var to: Vector2 = -local_pos
	var dist: float = to.length()
	if dist < 1.0:
		return
	var dir: Vector2 = to / dist
	# the character's middle on screen (the feet are at LocalPos)
	var mid: Vector2 = ct * (local_pos + Vector2(0, -14))
	# fade in as you walk away from the walls, so it does not sit on top of the base right outside a door
	var near: float = clampf((dist - Vector2(GameSim.HALF).length()) / (4.0 * T), 0.35, 1.0)
	var tip: Vector2 = mid + dir * (BASE_ARROW_R + 9.0)
	var back: Vector2 = mid + dir * (BASE_ARROW_R - 7.0)
	var side: Vector2 = Vector2(-dir.y, dir.x)
	# a gentle pulse along its direction
	var bob: float = 2.5 * sin(float(clock) * 4.0)
	tip += dir * bob
	back += dir * bob
	var head = [tip, back + side * 9.0, back + dir * 4.0, back - side * 9.0]
	var rim = Cs.arr(head.size() + 1, Vector2.ZERO)
	Cs.copy_to(head, rim, 0)
	rim[head.size()] = head[0]
	var col = BASE_ARROW_COL
	col.a = near
	var ink = INK
	ink.a = 0.85 * near
	c.draw_colored_polygon(head, col)
	c.draw_polyline(rim, ink, 2.0)

# ---- src/world/view/Main.BaseFog.cs
# Owner: Vu Duc Viet Anh. From outside the base you cannot see into it: a roof covers the floor inside the walls
# and nothing standing inside is drawn (players, enemies, drops, the workbench, hits, boss markers).
# The walls, doors, door towers and the lighthouse (the beacon, rising through the roof) still show.
# Step inside and everything shows again; the roof fades so walking through a door does not flash.
# 0: inside is visible, 1: hidden
var base_fog: float = 0.0
var base_fog_clock: float = 0.0
# how fast the fog comes and goes (full change in 1 / this seconds)
const BASE_FOG_SPEED: float = 4.0
# what is drawn over the floor inside the walls
const BASE_FOG_COL: Color = Color(0.07, 0.08, 0.1)

# call once per frame before drawing the world
func tick_base_fog() -> void:
	var now: float = float(clock)
	var dt: float = clampf(now - base_fog_clock, 0.0, 0.1)
	base_fog_clock = now
	var out: bool = not GameSim.inside_base(local_pos)
	base_fog = move_toward(base_fog, 1.0 if out else 0.0, dt * BASE_FOG_SPEED)

# whether something at this spot is hidden from you
func hidden_in_base(pos: Vector2) -> bool:
	return base_fog > 0.5 and GameSim.inside_base(pos)
# From outside, the base has a roof: flat riveted slabs in the walls' concrete laid between the wall tops (lifted by the wall height,
# like the walls' top faces), rusting at the seams, with vent grates. The lighthouse rises through the
# middle of it and is drawn on top (a depth item). Under it, the floor goes dark, which is what shows through an
# open door. Drawn on the ground layer, so the walls and everything outside draw over it.
var roof_alpha: float = 0.0
# the roof is about 1500 rects a frame from outside: its colours are parsed once, not on every rect
static var roof_hex = {}
const ROOF_SLAB: Color = Color("B0A58B")
const ROOF_SLAB_LIT: Color = Color("C6BBA1")
static var RIVETS = [Vector2(2, 2), Vector2(32 - 4, 2), Vector2(2, 25 - 4), Vector2(32 - 4, 25 - 4), Vector2(32 / 2 - 1, 2), Vector2(32 / 2 - 1, 25 - 4)]

func rf_2(hex_, a_: float = 1.0) -> Color:
	var c = roof_hex.get(hex_, Color(0, 0, 0, 0))
	if not roof_hex.has(hex_):
		c = Color(hex_)
		roof_hex[hex_] = c
	c.a = a_ * roof_alpha
	return c

func rf(c: Color) -> Color:
	c.a *= roof_alpha
	return c

static func roof_rect() -> Rect2:
	var h: Vector2 = Vector2(GameSim.HALF)
	var in_: float = float(GameSim.WALL_IN)
	var lift: float = float(WALL_H)
	return Rect2(-h.x + in_, -h.y + in_ - lift, 2 * (h.x - in_), 2 * (h.y - in_))

func draw_base_fog() -> void:
	if base_fog <= 0.0:
		return
	roof_alpha = smoothstep(0.0, 1.0, base_fog)
	var h: Vector2 = Vector2(GameSim.HALF)
	# the dark inside, seen through the doorways
	var dark = BASE_FOG_COL
	dark.a = roof_alpha
	draw_rect(Rect2(-h, h * 2), dark)
	var r: Rect2 = roof_rect()
	var x0: float = r.position.x
	var y0: float = r.position.y
	# riveted concrete slabs in the walls' cream, each a shade apart, rust bleeding from some seams (the rim around them is the walls'
	# concrete coping, src/world/view/Main.BaseLook.cs)
	draw_rect(r, rf_2("8A8069"))
	var pw: int = 32
	var ph: int = 25
	var y: float = y0
	while y < r.end.y:
		var x: float = x0
		while x < r.end.x:
			var p = Rect2(x + 1, y + 1, pw - 1, ph - 1).intersection(r)
			if not p.has_area():
				x += pw
				continue
			var hs: int = hash_(roundi(x), roundi(y) + 999)
			draw_rect(p, rf(ROOF_SLAB.lerp(ROOF_SLAB_LIT, hs % 100 / 100.0)))
			draw_rect(Rect2(p.position, Vector2(p.size.x, 1)), rf_2("DDD3BB", 0.8))
			draw_rect(Rect2(p.position, Vector2(1, p.size.y)), rf_2("DDD3BB", 0.5))
			draw_rect(Rect2(p.position.x, p.end.y - 1, p.size.x, 1), rf_2("857B66", 0.6))
			# rivets at the corners and halfway along the long edges
			for rv in RIVETS:
				var at: Vector2 = p.position + rv
				if p.has_point(at):
					draw_rect(Rect2(at, Vector2.ONE), rf_2("E8E0CB"))
					draw_rect(Rect2(at + Vector2(0, 1), Vector2.ONE), rf_2("7A705C", 0.7))
			# weathering: rust blooms and streaks, a few pale patches
			if hs % 3 == 0:
				var n: int = 4 + (hs >> 3) % 6
				var c: Vector2 = p.position + Vector2(4 + (hs >> 5) % (pw - 10), 4 + (hs >> 9) % (ph - 10))
				for k in range(n):
					var hk: int = hash_(hs, k)
					var d: Vector2 = Vector2(hk % 7 - 3, (hk >> 4) % 5 - 2)
					var blot = Rect2(c + d, Vector2(1 + (hk >> 8) % 3, 1 + (hk >> 11) % 2)).intersection(p)
					if blot.has_area():
						draw_rect(blot, rf_2("74401F" if (hk >> 13) % 3 == 0 else "9C5B33", 0.75))
				# a run toward the south edge
				var run = Rect2(c, Vector2(1, 3 + (hs >> 14) % 8)).intersection(p)
				if run.has_area():
					draw_rect(run, rf_2("9C5B33", 0.5))
			elif hs % 7 == 1:
				draw_rect(Rect2(p.position + Vector2(5, 6), Vector2(10, 5)).intersection(p), rf_2("E2D9C3", 0.4))
			x += pw
		y += ph
	# vent grates in concrete frames
	for v in [Vector2(-118, 28), Vector2(84, -22), Vector2(-104, -96), Vector2(102, 34)]:
		self.roof_grate(Rect2(v, Vector2(26, 12)))
	# the lighthouse's shadow across the roof by day (the sun is low in the south-east); it comes up through
	# the roof, which is lifted by the wall height
	var foot: Vector2 = Vector2(LIGHTHOUSE) - Vector2(0, float(WALL_H))
	if snap.get("ph", "") == "day":
		var sh = [foot + Vector2(-16, 4), foot + Vector2(16, 0), foot + Vector2(-104, -98), foot + Vector2(-128, -84)]
		for k in range(len(sh)):
			sh[k] = sh[k].clamp(r.position, r.end)
		draw_colored_polygon(sh, rf_2("000000", 0.28))
	# where the lighthouse comes up through the roof: a rusty steel collar
	self.roof_ellipse(foot + Vector2(4, 2), 34, 9, rf_2("000000", 0.3))
	self.roof_ellipse(foot, 30, 8, rf_2("6B5444"))
	self.roof_ellipse(foot, 30, 8, rf_2("2E353D"), false)
	self.roof_ellipse(foot, 26, 6, rf_2("8A6A4E"), false)

# a vent grate: concrete frame, dark slats
func roof_grate(g: Rect2) -> void:
	draw_rect(Rect2(g.position + Vector2(2, 3), g.size), rf_2("000000", 0.3))
	draw_rect(g.grow(2), rf_2("2E353D"))
	draw_rect(g.grow(1), rf_2("C8BDA3"))
	draw_rect(g, rf_2("23282E"))
	var x: float = g.position.x + 2
	while x < g.end.x - 1:
		draw_rect(Rect2(x, g.position.y + 1, 1, g.size.y - 2), rf_2("8A8069"))
		x += 3.0
	draw_rect(Rect2(g.position.x, g.position.y, g.size.x, 1), rf_2("000000", 0.4))

func roof_ellipse(c: Vector2, rx: float, ry: float, col: Color, filled: bool = true) -> void:
	var pts = Cs.arr(24, Vector2.ZERO)
	for k in range(24):
		var a_: float = k * TAU / 24
		pts[k] = c + Vector2(cos(a_) * rx, sin(a_) * ry)
	if filled:
		draw_colored_polygon(pts, col)
	else:
		var ring = Cs.arr(25, Vector2.ZERO)
		Cs.copy_to(pts, ring, 0)
		ring[24] = pts[0]
		draw_polyline(ring, col, 1.0)

# From outside only the part of the lighthouse above the roof shows: the sprite is cut where it comes
# up through the roof's collar (DrawBaseFog). Inside, or while the roof is fading out, it is drawn whole.
func draw_lighthouse(pos: Vector2, mod_: Color) -> void:
	var p = prop.get("lighthouse")
	if p == null:
		return
	if base_fog <= 0.5:
		self.draw_prop("lighthouse", pos, mod_)
		return
	var tex = p[0]
	var sc: float = float(LIGHTHOUSE_SCALE)
	var anchor: Vector2 = Vector2(p[1])
	var size: Vector2 = tex.get_size()
	# texture rows above the roof line (the roof sits WALL_H above the ground)
	var keep: float = clampf(anchor.y - float(WALL_H) / sc, 0.0, size.y)
	var src = Rect2(0, 0, size.x, keep)
	var dst = Rect2((pos - anchor * sc).round(), Vector2(size.x, keep) * sc)
	draw_texture_rect_region(tex, dst, src, mod_)

# whether a depth item (see Main._Draw) stands inside the base and is hidden from you
func hidden_item(it) -> bool:
	if base_fog <= 0.5 and not interior_active:
		return false
	var kind: int = int(it[1])
	var pos: Vector2 = Vector2.ZERO
	# scatter and nodes, enemies, props
	if kind == 0 or kind == 2:
		pos = Vector2(it[3])
	# the lighthouse is seen over the walls
	elif kind == 6:
		if Cs.s(it[2]) == "lighthouse":
			return false
		pos = Vector2(it[3])
	# players
	elif kind == 3:
		pos = Vector2(it[4])
	# projectiles, drops, arrows
	elif kind == 4 or kind == 5 or kind == 11:
		pos = Vector2(it[2][0])
	elif kind == 21:
		pos = Vector2(it[2][1])
	elif kind == 22:
		pos = GameSim.WORKBENCH_POS
	elif kind == 12:
		pos = corpses[int(it[2])].foot
	# walls, broken doors, pillars, towers and built walls are never hidden
	else:
		return false
	return self.hidden_in_base(pos) or hidden_outside_interior(pos)

# ---- src/world/view/Main.BaseLook.cs
# Owner: Vu Duc Viet Anh. How the base looks: weathered concrete walls (cream concrete with pilasters, rust runs and moss
# at the foot), the paved stone floor inside, and the warm lamps on the door pillars and the north wall that light it
# at night. The roof seen from outside (src/world/view/Main.BaseFog.cs) uses the same concrete for its rim, so walls and
# roof read as one building. All drawn in code, pixel by pixel, with a fixed hash so nothing flickers.
# the base walls are passed to Wall() with this top colour (Main.WallItems); Wall() hands them to ConcreteWall
const BASE_WALL_TOP: Color = Color("8A8F98")
# concrete
const CON_TOP: Color = Color("CFC5AC")
const CON_TOP_D: Color = Color("B4AA90")
const CON_TOP_L: Color = Color("E2D9C3")
const CON_FACE: Color = Color("B5AA90")
const CON_FACE_L: Color = Color("C3B89E")
const CON_FACE_D: Color = Color("968B74")
const CON_PIL: Color = Color("C8BDA3")
const CON_GRIME: Color = Color("7A705C")
const RUST: Color = Color("9C5B33")
const RUST_D: Color = Color("74401F")
const MOSS: Color = Color("6E7B38")
const MOSS_D: Color = Color("55602A")
# paving inside
const PAVE_A: Color = Color("6F6A5E")
const PAVE_B: Color = Color("847E70")
const PAVE_SEAM: Color = Color("4F4B42")
const PAVE_LIT: Color = Color("958F80")
# lamps: wall sconces on the north wall (x positions) and one on top of every door pillar
static var SCONCE_X = [-150.0, 150.0]
const LAMP_LIGHT: Color = Color("FF9A3C")
const LAMP_HOT: Color = Color(2.4, 1.6, 0.6)
const PILASTER_EVERY: int = 96
var base_lamps = []

static func hash_(x: int, y: int) -> int:
	# C# int arithmetic: wraps at 32 bits
	var h: int = Cs.i32(x * 374761393 + y * 668265263)
	h = Cs.i32((h ^ (h >> 13)) * 1274126177)
	return (h ^ (h >> 16)) & 0x7fffffff

static func mod(a_: int, m: int) -> int:
	return (a_ % m + m) % m

func px(x: float, y: float, w: float, h: float, c: Color) -> void:
	draw_rect(Rect2(x, y, w, h), c)

static func a(c: Color, alpha: float) -> Color:
	c.a = alpha
	return c

# A horizontal wall whose front face looks into the base (the north wall, door B's gate and pillars): under the
# roof, seen from outside, that face is hidden.
func face_under_roof(r: Rect2) -> bool:
	var h: Vector2 = Vector2(GameSim.HALF)
	var c: Vector2 = r.get_center()
	return base_fog > 0.5 and r.size.x >= r.size.y and c.y < 0 and absf(c.x) < h.x

# Same shape as Main.Wall: the top face lifted by Height, the front face below it, ink edges. Hide is how much of the
# front face, from the bottom, is not drawn (-1: all of it when it faces into a roofed base).
func concrete_wall(r: Rect2, height: float, cap: bool, hide: float = -1.0) -> void:
	var top = Rect2(r.position - Vector2(0, height), r.size)
	var f = Rect2(r.position.x, r.end.y - height, r.size.x, height)
	if hide < 0:
		hide = height if self.face_under_roof(r) else 0.0
	var face_end: float = f.end.y - hide
	var face: bool = face_end > f.position.y + 0.5
	if face:
		self.concrete_face(Rect2(f.position, Vector2(f.size.x, face_end - f.position.y)), hide <= 0.0)
	self.concrete_top(top, r.size.x >= r.size.y)
	var bottom: float = face_end if face else top.end.y
	# seen from outside, the wall tops run straight on into the roof (src/world/view/Main.BaseFog.cs): no ink
	# line along an edge the roof touches
	var roof: Rect2 = roof_rect()
	var seam = Color(INK, INK.a * (1.0 - smoothstep(0.0, 1.0, base_fog)))
	draw_line(Vector2(top.position.x, top.position.y), Vector2(top.position.x, bottom), _concrete_wall_ink(absf(top.position.x - roof.end.x) < 1.0, seam), 2)
	draw_line(Vector2(top.end.x, top.position.y), Vector2(top.end.x, bottom), _concrete_wall_ink(absf(top.end.x - roof.position.x) < 1.0, seam), 2)
	draw_line(Vector2(top.position.x, bottom), Vector2(top.end.x, bottom), _concrete_wall_ink(absf(bottom - roof.position.y) < 1.0, seam), 2)
	if cap:
		draw_line(top.position, Vector2(top.end.x, top.position.y), _concrete_wall_ink(absf(top.position.y - roof.end.y) < 1.0, seam), 2)
	# the lamps on the inside of the north wall
	if face and hide <= 0.0 and r.size.x >= r.size.y and r.get_center().y < 0 and absf(r.get_center().x) < Vector2(GameSim.HALF).x:
		for sx in SCONCE_X:
			if sx > f.position.x + 6 and sx < f.end.x - 6:
				self.sconce(Vector2(sx, f.position.y + height * 0.45))

# local function Ink of the method above
func _concrete_wall_ink(on_roof: bool, seam) -> Color:
	return seam if on_roof else INK

func concrete_face(f: Rect2, foot: bool) -> void:
	px(f.position.x, f.position.y, f.size.x, f.size.y, CON_FACE)
	# formwork lines
	var y: float = f.position.y + 6
	while y < f.end.y - 2:
		px(f.position.x, y, f.size.x, 1, a(CON_FACE_L, 0.7))
		y += 8.0
	var x0: int = ceili(f.position.x)
	var x1: int = floori(f.end.x)
	var yt: int = roundi(f.position.y)
	var hh: int = maxi(1, roundi(f.size.y))
	for x in range(x0, x1):
		if mod(x, PILASTER_EVERY) == 0:
			# a pilaster: a lighter column standing a little proud of the wall
			px(x - 3, f.position.y, 7, f.size.y, CON_PIL)
			px(x - 3, f.position.y, 1, f.size.y, CON_TOP_L)
			px(x + 3, f.position.y, 1, f.size.y, CON_FACE_D)
		elif mod(x, 32) == 0:
			px(x, f.position.y, 1, f.size.y, a(CON_FACE_D, 0.8))
	for x in range(x0 - mod(x0, 2), x1, 2):
		var h: int = hash_(x, 7)
		var xs: float = maxf(x, f.position.x)
		var w: float = minf(x + 2, f.end.x) - xs
		if w <= 0:
			continue
		if h % 9 == 0:
			# a rust run down from the coping
			var len_: int = mini(hh, 3 + (h >> 4) % 9)
			px(xs, f.position.y, w, len_, a(RUST, 0.55))
			px(xs, f.position.y + len_ - 1, w, 1, a(RUST_D, 0.6))
		if foot and h % 7 == 1:
			# moss and damp at the foot
			var len_: int = mini(hh, 2 + (h >> 6) % 6)
			px(xs, f.end.y - len_, w, len_, a(MOSS, 0.75))
			px(xs, f.end.y - len_, w, 1, a(MOSS_D, 0.6))
		if h % 11 == 3:
			px(xs, yt + (h >> 8) % hh, 1, 1, a(CON_FACE_D, 0.9))
		if h % 23 == 5:
			# a lighter, sun-bleached patch
			px(xs, yt + (h >> 9) % hh, w, 3, a(CON_TOP_L, 0.35))
	# shadow under the coping and grime along the foot
	px(f.position.x, f.position.y, f.size.x, 2, Color(0, 0, 0, 0.18))
	if foot:
		px(f.position.x, f.end.y - 2, f.size.x, 2, a(CON_GRIME, 0.6))

func concrete_top(top: Rect2, horizontal: bool) -> void:
	px(top.position.x, top.position.y, top.size.x, top.size.y, CON_TOP)
	var x0: int = ceili(top.position.x)
	var y0: int = ceili(top.position.y)
	for x in range(x0 - mod(x0, 2), ceili(top.end.x), 2):
		for y in range(y0 - mod(y0, 2), ceili(top.end.y), 2):
			if not top.has_point(Vector2(x, y)):
				continue
			var h: int = hash_(x, y)
			if h % 13 == 0:
				px(x, y, 1, 1, CON_TOP_D)
			elif h % 61 == 1:
				px(x, y, 2, 1, a(MOSS, 0.8))
			elif h % 89 == 2:
				px(x, y, 1, 1, a(RUST, 0.8))
	# the edge toward the camera catches the light, the far edge is worn darker
	px(top.position.x, top.end.y - 1, top.size.x, 1, CON_TOP_L)
	px(top.position.x, top.position.y, top.size.x, 1, CON_TOP_D)
	# pilaster caps, a step proud of the coping
	if horizontal:
		for x in range(x0, ceili(top.end.x)):
			if mod(x, PILASTER_EVERY) == 0 and x > top.position.x + 5 and x < top.end.x - 5:
				px(x - 4, top.position.y - 1, 9, top.size.y + 1, CON_TOP_L)
				px(x - 4, top.position.y - 1, 9, 1, CON_TOP_D)
				px(x + 4, top.position.y, 1, top.size.y, CON_FACE_D)
	else:
		for y in range(y0, ceili(top.end.y)):
			if mod(y, PILASTER_EVERY) == 0 and y > top.position.y + 5 and y < top.end.y - 5:
				px(top.position.x - 1, y - 4, top.size.x + 2, 9, CON_TOP_L)
				px(top.position.x - 1, y + 4, top.size.x + 2, 1, CON_FACE_D)

# A door pillar in the same concrete, taller than the wall, a lamp on top that glows from dusk.
func concrete_pillar(r: Rect2, height: float) -> void:
	# under the roof only the part above the wall shows
	var hide: float = float(WALL_H) if self.face_under_roof(r) else 0.0
	self.concrete_wall(r, height, true, hide)
	var lamp = Rect2((r.get_center() - Vector2(2, height + 1)).round(), Vector2(4, 3))
	draw_rect(lamp.grow(1), INK)
	draw_rect(lamp, LAMP_HOT if self.lamps_lit() else Color("F2B544"))

func sconce(p: Vector2) -> void:
	p = p.round()
	px(p.x - 2, p.y + 2, 5, 2, INK)
	px(p.x - 2, p.y - 3, 5, 5, INK)
	px(p.x - 1, p.y - 2, 3, 3, LAMP_HOT if self.lamps_lit() else Color("F2B544"))
	if self.lamps_lit():
		# warm light washing down the wall
		px(p.x - 5, p.y + 4, 11, 6, a(LAMP_LIGHT, 0.12))

func lamps_lit() -> bool:
	return snap.get("ph", "") in ["dusk", "night"]

# The paved floor inside the walls: big stone slabs in staggered rows, each a slightly different shade, with dark
# joints, a lit top edge and the odd crack.
func draw_base_floor() -> void:
	var h: Vector2 = Vector2(GameSim.HALF)
	var in_: float = float(GameSim.WALL_IN)
	var floor_ = Rect2(-h.x + in_, -h.y + in_, 2 * (h.x - in_), 2 * (h.y - in_))
	px(floor_.position.x, floor_.position.y, floor_.size.x, floor_.size.y, PAVE_SEAM)
	var s: int = 32
	var sh: int = 24
	var row: int = 0
	var y: float = floor_.position.y
	while y < floor_.end.y:
		var off: float = 0.0 if row % 2 == 0 else s / 2
		var x: float = floor_.position.x - off
		while x < floor_.end.x:
			var slab = Rect2(x + 1, y + 1, s - 1, sh - 1).intersection(floor_)
			if not slab.has_area():
				x += s
				continue
			var hs: int = hash_(roundi(x), roundi(y))
			var c: Color = PAVE_A.lerp(PAVE_B, hs % 100 / 100.0)
			draw_rect(slab, c)
			px(slab.position.x, slab.position.y, slab.size.x, 1, a(PAVE_LIT, 0.8))
			px(slab.position.x, slab.position.y, 1, slab.size.y, a(PAVE_LIT, 0.5))
			# speckle
			for k in range(6):
				var hk: int = hash_(hs + k, k)
				px(slab.position.x + hk % maxi(1, int(slab.size.x)), slab.position.y + (hk >> 8) % maxi(1, int(slab.size.y)), 1, 1, a(PAVE_SEAM, 0.6))
			if hs % 5 == 0:
				# a crack across the slab
				var p: Vector2 = slab.position + Vector2(4 + (hs >> 4) % 10, 3)
				for k in range(8):
					if not slab.has_point(p):
						break
					px(p.x, p.y, 1, 1, a(PAVE_SEAM, 0.9))
					p += Vector2(1 if hash_(hs, k) % 3 == 0 else 0, 1) + Vector2(1 if hash_(k, hs) % 2 == 0 else 0, 0)
			x += s
		row += 1
		y += sh
	# damp, darker corners and a soft shade along the north wall
	px(floor_.position.x, floor_.position.y, floor_.size.x, 8, Color(0, 0, 0, 0.12))

# --- lamps ---------------------------------------------------------------------
func setup_base_lamps(tex) -> void:
	var spots = []
	for i in range(3):
		for fp in self.door_pillars(i):
			spots.append(Rect2(fp).get_center())
	var north: float = -Vector2(GameSim.HALF).y + float(GameSim.WALL_IN) + 6.0
	for sx in SCONCE_X:
		spots.append(Vector2(sx, north))
	# All eight glows are one light: they never move, so their pools of light are drawn into one texture once.
	# On the GPU every 2D light is worked out for every pixel of the world (it is one big canvas item), so
	# eight small lamps cost more at night than the beacon and your own light together.
	var rad: float = 2.2 * float(T)
	var box_ = Rect2(spots[0], Vector2.ZERO)
	for p in spots:
		box_ = box_.expand(p)
	box_ = box_.grow(rad + 2.0)
	var w: int = ceili(box_.size.x)
	var h: int = ceili(box_.size.y)
	# each pool as the lamp texture drew it (Main.BuildScene: full out to 70% of the radius, then fading)
	var sum = Cs.arr(w * h, 0.0)
	var most: float = 0.0
	for y in range(h):
		for x in range(w):
			var at: Vector2 = box_.position + Vector2(x + 0.5, y + 0.5)
			var s: float = 0.0
			for p in spots:
				var d: float = at.distance_to(p) / rad
				s += 1.0 if d <= 0.7 else maxf(0.0, 1.0 - (d - 0.7) / 0.3)
			sum[y * w + x] = s
			most = maxf(most, s)
	# where pools overlap they add up past 1: the texture holds the sum over this, the energy puts it back
	base_lamp_gain = maxf(1.0, most)
	var bytes = Cs.arr(w * h * 4, 0)
	for i in range(sum.size()):
		var v: int = roundi(clampf(sum[i] / base_lamp_gain, 0.0, 1.0) * 255.0)
		bytes[i * 4] = v
		bytes[i * 4 + 1] = v
		bytes[i * 4 + 2] = v
		bytes[i * 4 + 3] = 255
	var l = PointLight2D.new()
	l.texture = ImageTexture.create_from_image(Image.create_from_data(w, h, false, Image.FORMAT_RGBA8, bytes))
	l.color = LAMP_LIGHT
	l.energy = 0.9
	l.texture_scale = 1.0
	l.position = box_.position + Vector2(w, h) / 2
	l.enabled = false
	l.texture_filter = CanvasItem.TEXTURE_FILTER_LINEAR
	l.texture_repeat = CanvasItem.TEXTURE_REPEAT_DISABLED
	add_child(l)
	base_lamps.append(l)
var base_lamp_gain: float = 1.0

func tick_base_lamps(night: float) -> void:
	for pl in base_lamps:
		pl.enabled = night > 0.05
		pl.energy = 0.75 * night * base_lamp_gain

# ---- src/world/view/Main.BaseProps.cs
# Owner: Vu Duc Viet Anh. The shared storage chest in the base (BAL-18, GameSim.STORAGE_POS): its lid opens when
# anyone walks up to it (in reach to use it) and shuts again when they leave. art/props/chest.png holds the frames
# side by side, closed to wide open (drawn by tools/PixelProps.cs); props.json gives the anchor of one frame.
const CHEST_FRAMES: int = 4
# lid speed: full swing in 1 / this seconds
const CHEST_OPEN_SPEED: float = 5.0
const CHEST_SHUT_SPEED: float = 3.5
# 0 shut, 1 wide open
var chest_open: float = 0.0
var chest_clock: float = 0.0
# The lighthouse is tall (it stands above the roof, src/world/view/Main.BaseFog.cs): while you stand behind it, it
# fades so you can see yourself.
var lighthouse_fade: float = 0.0
var lighthouse_clock: float = 0.0

func lighthouse_tint() -> Color:
	var now: float = float(clock)
	var dt: float = clampf(now - lighthouse_clock, 0.0, 0.1)
	lighthouse_clock = now
	var behind: bool = false
	var p = prop.get("lighthouse")
	if p != null:
		var size: Vector2 = p[0].get_size() * float(LIGHTHOUSE_SCALE)
		var anchor: Vector2 = Vector2(p[1]) * float(LIGHTHOUSE_SCALE)
		var body: Rect2 = Rect2(Vector2(LIGHTHOUSE) - anchor, size)
		var me: Vector2 = Vector2(local_pos)
		# your sprite (about a tile wide, 1.3 tiles tall) overlaps the tower and your feet are behind its foot
		behind = me.y < Vector2(LIGHTHOUSE).y and body.intersects(Rect2(me - Vector2(12, 40), Vector2(24, 40)))
	lighthouse_fade = move_toward(lighthouse_fade, 1.0 if behind else 0.0, dt * 4.0)
	return Color(1, 1, 1, 1.0 - 0.6 * lighthouse_fade)

# call once per frame while building the world items
func tick_chest() -> void:
	var now: float = float(clock)
	var dt: float = clampf(now - chest_clock, 0.0, 0.1)
	chest_clock = now
	var near: bool = false
	for id in snap.get("ps", {}):
		var p = snap.ps[id]
		if p[5] != 0:
			continue
		var pos: Vector2 = Vector2(local_pos if id == my_id else shown_p.get(id, p[2]))
		if GameSim.near_storage(pos):
			near = true
			break
	chest_open = move_toward(chest_open, 1.0 if near else 0.0, dt * (CHEST_OPEN_SPEED if near else CHEST_SHUT_SPEED))

func draw_chest(pos: Vector2) -> void:
	var p = prop.get("chest")
	if p == null:
		return
	# Gd.Load hands back a wrapped object
	var tex = p[0]
	var anchor: Vector2 = p[1]
	var w: float = tex.get_width() / CHEST_FRAMES
	var h: float = tex.get_height()
	var f: int = clampi(roundi(chest_open * (CHEST_FRAMES - 1)), 0, CHEST_FRAMES - 1)
	draw_texture_rect_region(tex, Rect2((pos - anchor).round(), Vector2(w, h)), Rect2(f * w, 0, w, h))
	# wide open: a glint rises from inside now and then
	if f == CHEST_FRAMES - 1:
		var mouth = pos + Vector2(0, -15)
		var spark: float = fposmod(float(clock) * 0.9, 1.0)
		if spark < 0.35:
			var sp = mouth + Vector2(lerpf(-6.0, 6.0, fposmod(floorf(float(clock) * 0.9) * 0.37, 1.0)), -4.0 - spark * 18.0)
			var sc = Color(1.0, 0.95, 0.7, 1.0 - spark / 0.35)
			draw_rect(Rect2(sp.round(), Vector2(1, 1)), sc)
			draw_rect(Rect2(sp.round() + Vector2(-1, 0), Vector2(3, 1)), Color(sc, sc.a * 0.5))
			draw_rect(Rect2(sp.round() + Vector2(0, -1), Vector2(1, 3)), Color(sc, sc.a * 0.5))

# ---- src/world/view/Main.CaveView.cs
var cave_roof_world
var cave_roof_alpha: float = 1
var cave_roof_clock: float = 0.0

var cave_roof_opacity: float:
	get:
		return cave_roof_alpha

var cave_interior_active: bool = false

func hidden_outside_cave(p: Vector2) -> bool:
	return cave_interior_active and not geometry.in_cave_floor(p)

func draw_cave_isolation(w) -> void:
	if not cave_interior_active:
		return
	for mask in w.cave_exterior_masks:
		fill_static(mask, Color("080C10"), false)

func draw_cave_roof(w, view: Rect2) -> void:
	if not is_same(cave_roof_world, w):
		cave_roof_world = w
		cave_roof_alpha = 1
		cave_roof_clock = float(clock)
	var now: float = float(clock)
	var dt: float = clampf(now - cave_roof_clock, 0, 0.1)
	cave_roof_clock = now
	var player: Vector2 = Vector2(local_pos)
	var inside: bool = w.is_cave_interior(player)
	cave_roof_alpha = move_toward(cave_roof_alpha, 0 if inside else 1, dt * 4)
	if cave_roof_alpha <= 0 or not Rect2(w.cave_centre - WorldGeometry.cave_radii, WorldGeometry.cave_radii * 2).intersects(view):
		return
	var i: int = 0
	for facet in w.cave_roof_facets:
		var centre: Vector2 = Vector2.ZERO
		for point in facet:
			centre += point
		centre /= facet.size()
		var light: float = clampf((w.cave_centre.y - centre.y) / (22 * 32), -0.25, 0.25)
		var rock: Color = Color("7F8475").lightened(light + (i % 5 - 2) * 0.015)
		rock.a = cave_roof_alpha
		fill_static(facet, rock)
		i += 1
	var seam: Color = Color("4D594E", cave_roof_alpha * 0.6)
	for band in w.cave_roof_seams:
		draw_polyline(band, seam, 2)
	for k in range(1, w.cave_roof.size(), 3):
		var edge: Vector2 = w.cave_roof[k]
		var in_: Vector2 = edge.lerp(w.cave_centre, 0.32)
		draw_line(edge, in_ + Vector2(9, -8), Color("4B574B", cave_roof_alpha * 0.75), 2)
		draw_line(in_ + Vector2(9, -8), in_ + Vector2(-4, 20), Color("4B574B", cave_roof_alpha * 0.75), 2)

func draw_cave_walls(w, view: Rect2) -> void:
	if not Rect2(w.cave_centre - WorldGeometry.cave_radii, WorldGeometry.cave_radii * 2).intersects(view):
		return
	var i: int = 0
	for _it1 in w.cave_walls:
		var face = _it1[0]
		var cap = _it1[1]
		var facet = _it1[2]
		var strata = _it1[3]
		var crack = _it1[4]
		if not bounds(cap, 80).intersects(view):
			i += 1
			continue
		var side: Color = Color("52564F" if i % 3 == 0 else "5D6056")
		var top: Color = Color("8A8979" if i % 3 == 0 else "77786D" if i % 3 == 1 else "9D9987")
		fill_static(face, side)
		fill_static(cap, top)
		fill_static(facet, top.lightened(0.08))
		draw_polyline(strata, side.darkened(0.22), 2)
		draw_polyline(crack, Color("464C43"), 2)
		draw_line(face[4], face[5], Color("3A4239"), 2)
		i += 1
	for side in range(-1, 2, 2):
		var p: Vector2 = w.cave_entrance + Vector2(0, side * 2.4 * 32)
		draw_line(p + Vector2(-10, -49), p + Vector2(12, -4), Color("B1AA8D"), 3)

# ---- src/world/view/Main.CompoundBoundaries.cs

func compound_boundary_items(items, view: Rect2) -> void:
	if interior_active:
		return
	var w = geometry
	var i: int = 0
	while i < w.compound_boundaries.size():
		var s = w.compound_boundaries[i]
		if Rect2(s.a.min(s.b), (s.b - s.a).abs()).grow(85).intersects(view):
			items.append([maxf(s.a.y, s.b.y), 18, i])
		i += 1

func draw_compound_boundary(index: int) -> void:
	var s = geometry.compound_boundaries[index]
	var a_: Vector2 = s.a
	var b: Vector2 = s.b
	var lift: Vector2 = Vector2(0, -s.height)
	if s.id == 13:
		# Chain-link mesh remains transparent, with sturdy posts, top rail and a concrete toe.
		draw_line(a_, b, ep("535E59"), 7)
		if s.wire.size() > 0:
			draw_multiline(s.wire, Color("8D9E98", 0.75), 1)
		draw_line(a_ + lift, b + lift, ep("9DA9A0"), 3)
		draw_line(a_ + Vector2(0, -5), b + Vector2(0, -5), ep("788A81"), 2)
		draw_line(a_, a_ + lift - Vector2(0, 7), ep("414F4B"), 6)
		draw_line(a_ - Vector2(1, 0), a_ + lift - Vector2(1, 7), ep("B5B9A6"), 2)
		draw_line(b, b + lift - Vector2(0, 7), ep("657970"), 4)
		# A rusted, bent security wire follows the top instead of floating over the entrance.
		for i in range(4):
			var p: Vector2 = a_.lerp(b, (i + 0.5) / 4) + lift - Vector2(0, 5)
			draw_line(p - Vector2(3, 3), p + Vector2(3, 2), ep("9E9378"), 1)
			draw_line(p - Vector2(3, -2), p + Vector2(3, -3), ep("9E9378"), 1)
		return
	fill_static(s.face, ep("A8AA99" if s.side == 0 else "8E9688" if s.side == 3 else "747F76"))
	fill_static(s.cap, ep("C6C3A9"))
	draw_line(a_, b, ep("515F57"), 5)
	draw_line(a_ - Vector2(0, 8), b - Vector2(0, 8), ep("6B796C"), 2)
	if s.side == 0 or s.side == 3:
		var x0: float = minf(a_.x, b.x) + 4
		var x1: float = maxf(a_.x, b.x) - 4
		# Exposed brick beneath flaking plaster and diagonal settlement cracks.
		for row in range(3):
			var x: float = x0 + row % 2 * 6
			while x < x1 - 8:
				var p: Vector2 = Vector2(x, a_.y - 11 - row * 7)
				if int(x) % 3 != 0:
					draw_rect(Rect2(p, Vector2(11, 5)), ep("8D7360" if row % 2 == 0 else "9B8267"))
				x += 13
		var crack: Vector2 = a_.lerp(b, 0.68)
		draw_line(crack + Vector2(-5, -s.height + 9), crack + Vector2(2, -24), ep("56645D"), 2)
		draw_line(crack + Vector2(2, -24), crack + Vector2(-6, -9), ep("56645D"), 2)
		if s.side == 0 and index % 2 == 0:
			var p: Vector2 = a_.lerp(b, 0.43) + Vector2(-12, -49)
			draw_rect(Rect2(p - Vector2(3, 3), Vector2(30, 27)), ep("6D7C73"))
			draw_rect(Rect2(p, Vector2(24, 21)), ep("253B38"))
			draw_line(p + Vector2(10, 0), p + Vector2(13, 21), ep("8D9782"), 2)
			draw_line(p + Vector2(0, 11), p + Vector2(24, 8), ep("94A08E"), 2)
			draw_line(p + Vector2(17, 1), p + Vector2(21, 8), ep("C0C7AE"), 1)
	# Twisted reinforcement and patchy vines make all four surviving sides visibly abandoned.
	var rebar: Vector2 = a_.lerp(b, 0.35) + lift
	draw_line(rebar, rebar + Vector2(2, -11), ep("6D594B"), 2)
	draw_line(rebar + Vector2(2, -11), rebar + Vector2(9, -14), ep("B19B78"), 1)
	if index % 3 == 0:
		var p: Vector2 = a_.lerp(b, 0.18)
		draw_line(p - Vector2(0, 3), p - Vector2(3, 32), ep("405E3E"), 2)
		for i in range(5):
			draw_rect(Rect2(p + Vector2(-7 if i % 2 == 0 else 0, -7 - i * 5), Vector2(6, 3)), ep("6A8154"))

# ---- src/world/view/Main.CompoundGround.cs

func draw_compound_ground(world, view: Rect2) -> void:
	for id in world.compounds:
		var floor_ = world.compounds[id]
		if not floor_.intersects(view):
			continue
		var c: Vector2 = floor_.get_center()
		if id == 6:
			# The exposed foundations still describe the old building's rooms, with an open central corridor.
			var foundation: Color = Color("64675D")
			var scorch: Color = Color("444A43", 0.45)
			draw_line(floor_.position + Vector2(8, 25), Vector2(floor_.end.x - 8, floor_.position.y + 25), foundation, 9)
			draw_line(floor_.position + Vector2(13, 25), Vector2(floor_.position.x + 13, floor_.end.y - 12), foundation, 8)
			draw_line(c + Vector2(32, -72), c + Vector2(32, -15), foundation, 6)
			draw_line(c + Vector2(32, -15), c + Vector2(110, -15), foundation, 6)
			draw_set_transform(c + Vector2(-79, 3), 0, Vector2(1.5, 0.65))
			draw_circle(Vector2.ZERO, 41, scorch)
			draw_set_transform(Vector2.ZERO)
			for i in range(23):
				var x: float = -127 + i * 47 % 225
				var y: float = -70 + i * 29 % 150
				var p: Vector2 = c + Vector2(x, y)
				if Cs.has_point(floor_.grow(-9), p):
					draw_line(p, p + Vector2(12 + i % 12, 4), Color("575E56"), 1)
					draw_line(p + Vector2(12 + i % 12, 4), p + Vector2(15 + i % 12, 11), Color("575E56"), 1)
			# Fallen roof trusses and fragments lie in the side bays, leaving the centre navigable.
			for side in range(-1, 2, 2):
				for i in range(7):
					var p: Vector2 = c + Vector2(side * (60 + i * 17 % 76), -62 + i * 23)
					draw_set_transform(p, i * 0.53)
					draw_rect(Rect2(-7, -3, 14 + i % 3 * 3, 6), ep("A8AB99" if i % 2 == 0 else "75837A"))
					draw_line(Vector2(-7, -3), Vector2(7 + i % 3 * 3, -3), ep("C5C3AC"), 1)
					draw_set_transform(Vector2.ZERO)
			for side in range(-1, 2, 2):
				var a_: Vector2 = c + Vector2(side * 52, -48)
				var b: Vector2 = c + Vector2(side * 140, -10)
				draw_line(a_, b, ep("4E5F59"), 6)
				draw_line(a_ - Vector2(0, 2), b - Vector2(0, 2), ep("ABB3A4"), 2)
				for i in range(1, 5):
					var p: Vector2 = a_.lerp(b, i / 5.0)
					draw_line(p - Vector2(9, 7), p + Vector2(9, -7), ep("8D7560"), 3)
		elif id == 13:
			var paint: Color = Color("CFB46E", 0.7)
			var worn: Color = Color("C8B077", 0.35)
			# Longitudinal forklift aisle, marked loading rectangles and drainage at the seaward edge.
			var lane_y: float = c.y + 6
			var x: float = floor_.position.x + 18
			while x < floor_.end.x - 20:
