	var rim: Color = Color("776449")
	var soil: Color = Color("514A34")
	var furrow: Color = Color("3C3E2D")
	# Packed, muted earth along the gate and a wide central aisle between six cultivated beds.
	draw_rect(Rect2(w.garden_centre + Vector2(-37, -171), Vector2(74, 364)), Color("8B8060"))
	for bed in w.garden_beds:
		draw_rect(bed.grow(4), rim)
		draw_rect(bed, soil)
		var y: float = bed.position.y + 13
		while y < bed.end.y - 6:
			draw_line(Vector2(bed.position.x + 6, y), Vector2(bed.end.x - 6, y + 1), furrow, 2)
			y += 14
		draw_line(bed.position, Vector2(bed.end.x, bed.position.y), Color("9D8961"), 3)
		draw_line(Vector2(bed.position.x, bed.end.y), bed.end, Color("564A36"), 3)

func garden_fence_items(items, view: Rect2) -> void:
	var w = geometry
	if not w.garden_bounds.grow(70).intersects(view) or interior_active:
		return
	var i: int = 0
	while i < w.garden_fence.size():
		var _d1 = w.garden_fence[i]
		var a_ = _d1[0]
		var b = _d1[1]
		if Rect2(a_.min(b), (b - a_).abs()).grow(64).intersects(view):
			items.append([maxf(a_.y, b.y), 13, i])
		i += 1

func draw_garden_fence(index: int) -> void:
	var _d1 = geometry.garden_fence[index]
	var a_ = _d1[0]
	var b = _d1[1]
	var shade: Color = Color("403C2B")
	var wood: Color = Color("84734C")
	var lit: Color = Color("AC9564")
	draw_line(a_ + Vector2(0, -17), b + Vector2(0, -17), shade, 6)
	draw_line(a_ + Vector2(0, -31), b + Vector2(0, -31), wood, 5)
	for i in range(4):
		var p: Vector2 = a_.lerp(b, i / 3.0).round()
		var h: float = 49 if i == 0 else 36 + (index * 7 + i * 3) % 9
		draw_line(p, p + Vector2(2 if i == 2 else 0, -h), shade, 7)
		draw_line(p + Vector2(-1, -2), p + Vector2(-1, -h + 3), wood, 4)
		draw_line(p + Vector2(-2, -h), p + Vector2(2, -h), lit, 2)
	if index % 3 == 0:
		var p: Vector2 = a_.lerp(b, 0.5)
		draw_line(p - Vector2(4, 5), p + Vector2(5, -31), Color("475D36"), 2)
		for i in range(4):
			draw_rect(Rect2((p + Vector2(-5 if i % 2 == 0 else 3, -6 - i * 7)).round(), Vector2(7, 3)), Color("65834A"))

# ---- src/world/view/Main.LandmarkDetails.cs
# Owner: Vu Duc Viet Anh. Ground colour and quiet wildlife distinguish Atlas locations at gameplay scale.
# Visuals only: no extra lights, loot, damage or changes to the navigation mesh.
const landmark_ground_budget_ms: float = 1.0
var landmark_soil_world
var landmark_soil_cache = {}
var landmark_soil_jobs = []
var profile_landmarks: bool = OS.get_cmdline_user_args().find("--profile-landmarks") >= 0

var has_pending_landmark_ground: bool:
	get:
		return landmark_soil_jobs.size() > 0

var landmark_ground_worst_slice_ms: float = 0.0

func draw_landmark_soils(w, view: Rect2) -> void:
	if not is_same(landmark_soil_world, w):
		for job in landmark_soil_cache.values():
			pass
			pass
		landmark_soil_cache.clear()
		landmark_soil_jobs.clear()
		landmark_soil_world = w
	for surface in WorldGeometry.landmark_soils:
		var _d1 = surface
		var id = _d1.id
		var rx = _d1.rx
		var ry = _d1.ry
		var hex_ = _d1.hex
		if not w.lm_at.has(id):
			continue
		var c: Vector2 = w.soil_centre(surface)
		if not Cs.has_point(view.grow(rx * 32), c):
			continue
		var job = landmark_soil_cache.get(id, null)
		if not landmark_soil_cache.has(id):
			# Queue work while the location is still in the camera's off-screen culling margin.
			# Never scan terrain, paint an image or upload a texture from _Draw().
			var origin: Vector2 = (c - Vector2(rx * 32, ry * 32)).floor()
			var bottom: int = maxi(int(ry * 32), 112) if id == 5 or id == 7 else int(ry * 32)
			job = Cs.init(LandmarkSoilJob.new(), {"id": id, "centre": c, "rx": rx, "ry": ry, "soil": Color(hex_), "surface": surface, "fleck": Color(Color(hex_).lightened(0.15), 0.7), "min_x": -int(rx * 32), "x": -int(rx * 32), "max_x": int(rx * 32), "y": -int(ry * 32), "max_y": int(ry * 32), "area": Rect2(origin, Vector2(int(rx * 64) + 8, bottom + int(ry * 32) + 8))})
			landmark_soil_cache[id] = job
			landmark_soil_jobs.push_back(job)
		if job.texture != null:
			draw_texture_rect(job.texture, job.area, false)

# All Godot image/texture operations remain on the main thread, with a small CPU budget per rendered frame.
func tick_landmark_ground() -> void:
	if landmark_soil_jobs.size() == 0:
		return
	var started: int = Time.get_ticks_usec()
	var limit: int = started + int(1000000 * landmark_ground_budget_ms / 1000)
	var job = landmark_soil_jobs.front()
	if job.mask == null: job.mask = LandmarkGroundMask.new(landmark_soil_world, job.area)
	if job.image == null: job.image = Image.create_empty(int(job.area.size.x), int(job.area.size.y), false, Image.FORMAT_RGBA8)
	while true:
		if job.y <= job.max_y:
			paint_landmark_cell(job)
			job.x += 4
			if job.x > job.max_x:
				job.x = job.min_x
				job.y += 4
		else:
			job.texture = ImageTexture.create_from_image(job.image)
			pass
			job.image = null
			landmark_soil_jobs.pop_front()
			break
		if not (Time.get_ticks_usec() < limit): break
	var elapsed: int = Time.get_ticks_usec() - started
	job.work_ticks += elapsed
	job.slices += 1
	landmark_ground_worst_slice_ms = maxf(landmark_ground_worst_slice_ms, elapsed * 1000.0 / 1000000)
	if profile_landmarks and job.texture != null:
		print("LANDMARK BAKE %02d: %.2f ms across %s frames; worst slice %.2f ms" % [job.id, job.work_ticks * 1000.0 / 1000000, job.slices, landmark_ground_worst_slice_ms])

func paint_landmark_cell(job) -> void:
	var p: Vector2 = (job.centre + Vector2(job.x, job.y)).round()
	var coverage: float = WorldGeometry.soil_coverage(job.surface, p - job.centre)
	var noise: float = h01(int(p.x), int(p.y))
	if coverage <= 0 or not job.mask.can_paint(p, 3, true, false):
		return
	var base: Color = landmark_soil_world.cave_ground_colour(p) if job.id == 16 else job.soil
	var patch: Color = base.lightened(0.035) if noise > 0.72 else base.darkened(0.035) if noise < 0.22 else base
	patch.a = coverage
	fill_landmark(job, p, Vector2i(4, 4), patch)
	if noise > 0.92:
		fill_landmark(job, p + Vector2(1, 2), Vector2i(2, 1), Color(job.fleck, job.fleck.a * coverage))
	if job.id == 16 and noise < 0.025:
		fill_landmark(job, p, Vector2i(4, 1), Color(base.darkened(0.18), coverage))

static func fill_landmark(job, p: Vector2, size: Vector2i, colour: Color) -> void:
	job.image.fill_rect(Rect2i(Vector2i((p - job.area.position).round()), size), colour)

func draw_landmark_life(w, view: Rect2, time: float) -> void:
	var night: bool = snap.get("ph", "day") == "night"
	for id in [4, 8, 15, 18]:
		var c = w.lm_at.get(id, Vector2.ZERO)
		if not w.lm_at.has(id) or not Cs.has_point(view.grow(200), c):
			continue
		if id == 8:
			c = w.swamp_centre
		if id == 15 and w.ponds.size() > 0:
			c = w.ponds[0].centre
		for i in range(12 if id == 8 else 6):
			var a_: float = time * 0.24 + i * 2.4
			var p: Vector2 = (c + Vector2(sin(a_) * (45 + i * 7), cos(a_ * 1.3) * (28 + i * 5))).round()
			if not view.has_point(p):
				continue
			if night or id == 8:
				var alpha: float = 0.25 + 0.65 * pow(0.5 + 0.5 * sin(time * 1.8 + i * 1.9), 3)
				# HDR points remain visible through the world's night tint, without casting gameplay light.
				var glow: Color = Color(4.2, 3.8, 1.5, alpha) if night else Color("D4DE87", alpha)
				draw_rect(Rect2(p - Vector2.ONE * 2, Vector2(5, 5)), Color(glow, alpha * 0.07))
				draw_rect(Rect2(p, Vector2.ONE), glow)
			else:
				var wing: int = 2 if sin(time * 10 + i) > 0 else 1
				var col: Color = Color("9DD5D5" if id == 15 else "E3BE74" if i % 2 == 0 else "DAB4D9", 0.85)
				draw_rect(Rect2(p + Vector2(-wing, -1), Vector2(wing, 2)), col)
				draw_rect(Rect2(p + Vector2(1, -1), Vector2(wing, 2)), col)
				draw_rect(Rect2(p, Vector2(1, 2)), Color("4A4B34"))

# ---- src/world/view/Main.LandmarkView.cs
# Owner: Vu Duc Viet Anh. What the landmarks of src/world/WorldLandmarks.cs lay flat on the ground layer: the
# cracked concrete of the Ruined Base and the Container Yard with grass in the joints, the Old Fishing Pier and
# the South Cape platform (sprites from tools/PixelLandmarks.cs), the
# coral reef under the Coral Lookout and the lily pads on the Rainwater Pond. Their standing parts (walls,
# containers, the ship, the bluff...) are depth-sorted scenery like the trees.
const SLAB: Color = Color("8B8D88")
const SLAB_LIT: Color = Color("A2A49E")
const SLAB_JOINT: Color = Color("6C6E6A")
const SLAB_EDGE: Color = Color("55574F")
static var CORAL = [Color("D9788A"), Color("E09A5A"), Color("5FB8A8"), Color("9A7AC8"), Color("E3C46A")]
const LILY: Color = Color("4E8C46")
const LILY_LIT: Color = Color("6FAE5A")

static func h01(x: int, y: int) -> float:
	return float((Cs.u32(x * 374761393 + y * 668265263) ^ 0x5bd1e995) % 1000) / 1000.0

func draw_landmark_ground(w, view: Rect2) -> void:
	var tl: float = float(T)
	for _it1 in w.floors:
		var f = _it1[0]
		var drawn = _it1[1]
		if drawn and f.intersects(view):
			draw_slab(f)
	for _it2 in w.lm_ground:
		var p = _it2[0]
		var name = _it2[1]
		if Cs.has_point(view.grow(12 * tl), p):
			self.sprite(name, p, WorldGeometry.LANDMARK_SCALE, COLD)
	var clk: float = float(clock)
	draw_lookout_ground(w, view, clk)
	draw_compound_ground(w, view)
	draw_expedition_ground(w, view)
	draw_cave_walls(w, view)
	draw_garden_ground(w, view)
	draw_weather_ground(w, view)
	draw_fishing_life(w, view, clk)

# a concrete slab: joints every two tiles, a darker edge, cracks and grass growing through
func draw_slab(f: Rect2) -> void:
	var tl: float = float(T)
	draw_rect(f.grow(2), SLAB_EDGE)
	draw_rect(f, SLAB)
	# a few panels lighter or darker
	var y: float = f.position.y
	while y < f.end.y - 1:
		var x: float = f.position.x
		while x < f.end.x - 1:
			var h: float = h01(int(x), int(y))
			var panel_ = Rect2(x, y, minf(2 * tl, f.end.x - x), minf(2 * tl, f.end.y - y))
			if h > 0.7:
				draw_rect(panel_, SLAB_LIT)
			elif h < 0.18:
				draw_rect(panel_, Color("7D7F7A"))
			# a crack across the panel
			if h > 0.45 and h < 0.65:
				var a_: Vector2 = panel_.position + Vector2(panel_.size.x * h, 2)
				var b: Vector2 = a_ + Vector2(10 - 20 * h01(int(y), int(x)), panel_.size.y * 0.45)
				var c: Vector2 = b + Vector2(8 * (h - 0.5) * 10, panel_.size.y * 0.4)
				draw_line(a_.round(), b.round(), SLAB_JOINT, 1)
				draw_line(b.round(), c.round(), SLAB_JOINT, 1)
			x += 2 * tl
		y += 2 * tl
	var x: float = f.position.x + 2 * tl
	while x < f.end.x - 1:
		draw_line(Vector2(x, f.position.y).round(), Vector2(x, f.end.y).round(), SLAB_JOINT, 1)
		x += 2 * tl
	y = f.position.y + 2 * tl
	while y < f.end.y - 1:
		draw_line(Vector2(f.position.x, y).round(), Vector2(f.end.x, y).round(), SLAB_JOINT, 1)
		y += 2 * tl
	# grass in the joints and along the edge
	for i in range(int(f.size.x * f.size.y / (tl * tl) * 0.8)):
		var hx: float = h01(i, int(f.position.x))
		var hy: float = h01(int(f.position.y), i)
		var edge: bool = i % 3 == 0
		var p: Vector2 = Vector2(f.position.x + hx * f.size.x, f.position.y + 1 if hy > 0.5 else f.end.y - 2) if edge else Vector2(f.position.x + Cs.round_even(hx * f.size.x / (2 * tl)) * 2 * tl, f.position.y + hy * f.size.y)
		if not f.has_point(p):
			continue
		p = p.round()
		draw_rect(Rect2(p, Vector2(1, 3)), Color("5F7A3A"))
		draw_rect(Rect2(p + Vector2(1, 1), Vector2(1, 2)), Color("7A9648"))
		draw_rect(Rect2(p + Vector2(-1, 1), Vector2(1, 2)), Color("4C6530"))

func draw_lilies(pd) -> void:
	for i in range(9):
		var p: Vector2 = (pd.centre + Vector2.from_angle(i * 2.3 + 0.6) * pd.radius * (0.35 + 0.07 * i) * Vector2(1.2, 0.85)).round()
		var rr: float = 4 + i % 3
		draw_circle(p + Vector2(1, 1), rr, Color(0.05, 0.1, 0.12, 0.35))
		draw_circle(p, rr, LILY)
		draw_circle(p + Vector2(-1, -1), rr - 2, LILY_LIT)
		# the notch
		draw_line(p, p + Vector2.from_angle(i * 1.7) * rr, Color("2F5A75"), 2)
		if i % 4 == 1:
			draw_rect(Rect2(p + Vector2(-1, -2), Vector2(3, 2)), Color("F0B8D0"))
			draw_rect(Rect2(p + Vector2(0, -3), Vector2(1, 1)), Color("FFF0F6"))

# ---- src/world/view/Main.Lookouts.cs
static var reef_roof = [Vector2(-70, -66), Vector2(-43, -95), Vector2(56, -95), Vector2(75, -66)]
static var beacon_hood = [Vector2(-21, -78), Vector2(0, -95), Vector2(21, -78)]
static var compass_north = [Vector2(0, -48), Vector2(-9, 0), Vector2(0, -9), Vector2(9, 0)]
static var compass_south = [Vector2(0, 48), Vector2(-9, 0), Vector2(0, 9), Vector2(9, 0)]

func lookout_items(items, view: Rect2) -> void:
	if interior_active:
		return
	var w = geometry
	var i: int = 0
	while i < w.lookout_objects.size():
		var s = w.lookout_objects[i]
		if Cs.has_point(view.grow(150), s.pos):
			items.append([s.pos.y, 19, i])
		i += 1
	i = 0
	while i < w.lookout_rails.size():
		var s = w.lookout_rails[i]
		if Cs.has_point(view.grow(70), (s.a + s.b) / 2):
			items.append([maxf(s.a.y, s.b.y), 20, i])
		i += 1

func draw_lookout_ground(w, view: Rect2, time: float) -> void:
	for site in w.lookouts.values():
		if not Rect2(site.centre - site.radii, site.radii * 2).grow(75).intersects(view):
			continue
		var c: Vector2 = site.centre
		if site.id == 12:
			draw_rect(site.deck.grow(5), ep("536F68"))
			draw_rect(site.deck, ep("B4B69A"))
			var y: float = site.deck.position.y + 3
			while y < site.deck.end.y:
				draw_line(Vector2(site.deck.position.x + 2, y), Vector2(site.deck.end.x - 2, y), ep("7D9581"), 2)
				for i in range(4):
					var p: Vector2 = Vector2(site.deck.position.x + 25 + i * 55, y + 2)
					draw_rect(Rect2(p, Vector2(1, 1)), ep("506D65"))
				y += 9
			# Shell fragments and bleached coral rubble identify the whole clearing, not only the pavilion.
			for i in range(30):
				var a_: float = i * 2.39996
				var p: Vector2 = c + Vector2(cos(a_) * 164, sin(a_) * 116)
				draw_arc(p.round(), 3 + i % 3, PI, TAU, 7, ep("F1D6C2" if i % 2 == 0 else "E5DCC0"), 2)
				draw_line(p + Vector2(-2, 1), p + Vector2(2, 1), ep("AB9E8D"), 1)
			for i in range(5):
				draw_rect(Rect2(c + Vector2(-36, 73 + i * 8), Vector2(72, 6)), ep("B0B398" if i % 2 == 0 else "8C9C85"))
		else:
			fill_static(w.cape_scarp_face, ep("465F63"))
			fill_static(w.cape_scarp_cap, ep("A4B2A5"))
			fill_static(site.outline, ep("A8B9B0"))
			for i in range(24):
				var p: Vector2 = c + Vector2(-105 + i * 37 % 205, -81 + i * 29 % 163)
				if (p - c).length() < 55:
					continue
				draw_line(p, p + Vector2(7 + i % 9, 3), ep("6F8983"), 1)
				draw_line(p + Vector2(7 + i % 9, 3), p + Vector2(10 + i % 9, 8), ep("6F8983"), 1)
			draw_set_transform(c)
			draw_arc(Vector2.ZERO, 56, 0, TAU, 48, ep("5B7F79"), 2)
			draw_arc(Vector2.ZERO, 61, 0, TAU, 48, ep("D2D4B9"), 2)
			for i in range(16):
				var d: Vector2 = Vector2.from_angle(i * TAU / 16)
				draw_line(d * (46 if i % 4 == 0 else 51), d * 56, ep("577972"), 2)
			fill_static(compass_north, ep("476E6D"), false)
			fill_static(compass_south, ep("CCB88E"), false)
			draw_set_transform(c, PI / 2)
			fill_static(compass_north, ep("65857F"), false)
			fill_static(compass_south, ep("DBCFB0"), false)
			draw_set_transform(Vector2.ZERO)
			draw_circle(c, 6, ep("D7C494"))
			draw_circle(c, 2, ep("536E69"))
			draw_string(ThemeDB.fallback_font, c + Vector2(-4, -66), "N", HORIZONTAL_ALIGNMENT_LEFT, -1, 12, ep("3F6464"))
			draw_string(ThemeDB.fallback_font, c + Vector2(-4, 78), "S", HORIZONTAL_ALIGNMENT_LEFT, -1, 12, ep("3F6464"))
	if interior_active:
		return
	for i in range(w.coral.size()):
		var p: Vector2 = w.coral[i]
		if not Cs.has_point(view.grow(32), p):
			continue
		fill_static(w.reef_beds[i], Color("55ADAB" if i % 2 == 0 else "78BBAE", 0.27), false)
		var col: Color = CORAL[i % CORAL.size()]
		col.a = 0.64 + 0.08 * sin(time * 1.2 + i)
		if i % 3 == 0:
			for k in range(-2, 3):
				var d: Vector2 = Vector2.from_angle((k + 2) * 0.68 + 0.2 + i * 1.4)
				var tip: Vector2 = p + d * 14
				draw_line(p, tip, col, 3)
				draw_line(p + d * 8, tip + d.orthogonal() * 4, col.lightened(0.22), 2)
		else:
			for k in range(5):
				var q: Vector2 = p + Vector2.from_angle(k * 2.4 + i) * (5 + k % 3 * 2)
				draw_circle(q.round(), 4 + k % 3, col)
				draw_circle((q - Vector2(1, 1)).round(), 2, col.lightened(0.3))
		draw_line(p + Vector2(-9, 18), p + Vector2(9, 18), Color("B8E3D7", 0.2 + 0.1 * sin(time + i)), 1)
	for i in range(w.cape_gulls.size()):
		var p: Vector2 = w.cape_gulls[i] + Vector2(sin(time * 0.5 + i) * 16, cos(time * 0.7 + i) * 6)
		if not view.has_point(p):
			continue
		var wing: float = 3 + sin(time * 3 + i) * 3
		draw_line(p - Vector2(8, wing), p, ep("E1E4CC"), 2)
		draw_line(p, p + Vector2(8, -wing), ep("E1E4CC"), 2)

func draw_lookout_rail(index: int) -> void:
	var s = geometry.lookout_rails[index]
	var a_: Vector2 = s.a
	var b: Vector2 = s.b
	var wood: bool = s.id == 12
	var body: Color = ep("729D91" if wood else "738F8B")
	var light: Color = ep("D4DAC1" if wood else "C0CFC1")
	var h: float = 28 if wood else 17
	draw_line(a_, b, ep("4D6D66"), 5)
	draw_line(a_ - Vector2(0, h), b - Vector2(0, h), light, 5)
	if wood:
		draw_line(a_ - Vector2(0, 12), b - Vector2(0, 12), body, 3)
	for i in range(3):
		var p: Vector2 = a_.lerp(b, i / 2.0)
		draw_line(p, p - Vector2(0, h + 3), body, 4 if wood else 6)
		draw_line(p - Vector2(1, 1), p - Vector2(1, h + 3), light, 1)

func draw_lookout_object(index: int) -> void:
	var s = geometry.lookout_objects[index]
	draw_set_transform(s.pos)
	var _sw1 = s.model
	# Coral pavilion, faded sea-green roof and salt-bleached posts.
	if _sw1 == 0:
		for side in range(-1, 2, 2):
			draw_line(Vector2(side * 48, 0), Vector2(side * 48, -72), ep("586F60"), 8)
			draw_line(Vector2(side * 48 - 2, -2), Vector2(side * 48 - 2, -70), ep("D9DCC1"), 3)
		draw_rect(Rect2(-58, -22, 116, 7), ep("7D9A84"))
		draw_line(Vector2(-56, -17), Vector2(54, -17), ep("D2D8BA"), 2)
		fill_static(reef_roof, ep("4D9D95"), false)
		draw_line(Vector2(-69, -65), Vector2(74, -65), ep("CEE0CA"), 6)
		for i in range(13):
			draw_line(Vector2(-65 + i * 11, -69), Vector2(-40 + i * 8, -92), ep("7DBAB0" if i % 2 == 0 else "397C79"), 2)
		draw_line(Vector2(-43, -96), Vector2(56, -96), ep("B8D0BC"), 3)
		draw_rect(Rect2(-24, -57, 48, 13), ep("DCD8B4"))
		draw_line(Vector2(-18, -50), Vector2(17, -50), ep("497A75"), 2)
	# Illustrated reef identification board.
