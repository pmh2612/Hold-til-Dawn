# Context hint above the hotbar: towers, gathering, door repair and night entry.
func draw_interaction_hint(c, vs, me, ph) -> void:
	var hint = me[16]
	for job in snap.get("construction", []):
		if job[2] == my_id:
			hint = "Building tower: %.0f%% - stand still" % [float(job[1]) * 100]
	if hint == "" and local_note_t > 0:
		hint = local_note
	# a downed teammate, or a dead one (with a Revival kit in the bag)
	if hint == "" and me[5] == 0:
		for qid in snap.ps:
			var q = snap.ps[qid]
			if qid == my_id or q[5] == 0 or local_pos.distance_to(Vector2(shown_p.get(qid, q[2]))) > 1.5 * T:
				continue
			if q[5] == 1:
				hint = "E: revive"
			else:
				hint = "E: use Revival kit" if carried(me, "revive") > 0 else "Needs a Revival kit"
			break
	# standing at the base furniture
	if hint == "" and me[5] == 0:
		if self.at_bench_local(me):
			hint = "C: craft"
		elif self.at_storage_local(me):
			hint = "Tab: storage"
	var gathering_hint = false
	if hint == "" and me[1] == 2 and me[5] == 0 and not me[19]:
		var tws = snap.get("tw", [])
		for tw in tws:
			if local_pos.distance_to(tw[1]) <= 1.5 * T:
				var tcap: float = float(GameSim.TOWER_HP * (0.3 if tw[3] else 1.0))
				hint = "Tower %d/%d" % [tw[2], tcap] + ("  |  E: repair" if tw[2] < tcap else "")
				break
		if hint == "" and self.free_tower_here():
			hint = "T: build free tower (6s)"
	if hint == "" and ph in ["day", "dusk"] and me[5] == 0:
		for nd in snap.nodes:
			if nd[2] > 0 and local_pos.distance_to(nd[1]) <= 1.5 * T:
				var pct = int(me[21] * 100)
				hint = "Gathering %s... %d%%" % [GameSim.RES[nd[0]], pct] if me[21] > 0 else "E: gather %s" % [GameSim.RES[nd[0]]]
				gathering_hint = true
				break
	if hint == "" and ph in ["day", "dusk", "night"] and me[1] == 2 and me[5] == 0 and not me[19] and not GameSim.inside_base(local_pos):
		for i in 3:
			if local_pos.distance_to(GameSim.DOOR_POS[i]) > 1.5 * T:
				continue
			var dn = GameSim.DOOR_NAMES[i]
			var cap: float = float(GameSim.DOOR_HP * (0.3 if snap.broken[i] else 1.0))
			var dur: float = float(snap.doors[i])
			if dur >= cap:
				hint = ""
			elif snap.broken[i] and snap.inside_en:
				hint = "Clear the enemies inside first"
			elif carried(me, "wood") <= 0:
				hint = "Need wood"
			elif Input.is_physical_key_pressed(69):
				hint = "Interrupted!" if snap.dpause[i] else "Door %s %d/%d" % [dn, dur, cap]
			else:
				hint = "E: repair door %s" % [dn]
			if ph == "night" and dur > 0:
				hint += "F: enter" if hint == "" else "  |  F: enter"
			break
	if hint == "" and ph == "night" and me[1] == 2 and me[5] == 0:
		if me[19]:
			hint = "F at a door: leave"
		else:
			for i in 3:
				if snap.doors[i] > 0 and local_pos.distance_to(GameSim.DOOR_POS[i]) <= 2.0 * T:
					hint = "F: enter"
	if hint != "":
		if gathering_hint:
			c.draw_string(font_ui, Vector2(0, vs.y - 74), hint, 1, vs.x, 13, Color.BLACK)
		else:
			self.text(c, Vector2(0, vs.y - 74), hint, 13, GOLD, 1, vs.x)

# Gameplay keys (F3 and zoom stay in Main.cs). Each key sends one action string to GameSim.Action.
func gameplay_key(code) -> void:
	if code == 81:
		self.act("bandage")
	elif code == 84:
		self.act("tower")
	elif code == 86:
		self.act("vote")
	elif code == 71:
		self.act("give")
	elif code == 77:
		self.toggle_map()
	elif code == 67:
		# the workbench tab opens only at the workbench (and closes by itself away from it, KeepPanelsInReach)
		var me = snap.ps.get(my_id)
		if not craft_open and not self.at_bench_local(me):
			return
		craft_open = not craft_open
		select_craft_tier(craft_tier)
		bag_open = false
		bag_exploration_chest = -1
		drag_from = null
	elif code == 4194306:
		# the bag opens anywhere; opened at the chest it is the chest, and closes when you walk away from it
		bag_open = not bag_open
		bag_exploration_chest = -1
		if bag_open:
			for chest in supply_rows():
				if chest[4] and Vector2(local_pos).distance_squared_to(Vector2(chest[1])) <= GameSim.CHEST_REACH * GameSim.CHEST_REACH:
					act("open_chest", int(chest[0]))
					break
		bag_at_chest = bag_open and self.at_storage_local(snap.ps.get(my_id))
		drag_from = null
		craft_open = false
	elif code == 4194340:
		self.act("skip")
	else:
		var n: int = int(code - 49)
		if code == 48:
			n = 9
		if craft_open:
			# a number key shows that recipe and crafts it at once (ui/gameplay/Main.CraftPanel.cs)
			var choices = craft_choices()
			if n >= 0 and n < choices.size():
				craft_sel = choices[n]
				self.act("craft", craft_sel)
		elif n >= 0 and n < GameSim.HOTBAR:
			self.act("select", n)

# Mouse wheel picks the hotbar slot (MEC-09).
func hotbar_wheel(step: int) -> void:
	var me = snap.ps.get(my_id)
	if me != null:
		self.act("select", (int(me[25]) + step + GameSim.HOTBAR) % GameSim.HOTBAR)

func gameplay_right_click() -> void:
	if ui_captures_mouse():
		return
	var me = snap.ps.get(my_id)
	var slot = null if me == null else me[7][int(me[25])]
	var use: bool = slot != null and GameSim.is_tactical_use(Cs.s(slot[0]))
	self.act("use_item" if use else "flask", get_global_mouse_position())

