func _ready() -> void:
	# a cap on the frame rate (config/display/display.tres): on a 144 Hz screen the game would otherwise draw
	# flat out all match long and the laptop's fans would follow
	Engine.max_fps = DisplaySettings.get_current().max_fps
	add_child(sound)
	sound.setup(self)
	self.build_scene()
	self.build_ui()
	var args = OS.get_cmdline_user_args()
	for a_ in args:
		if a_.begins_with("--shot="):
			shot_path = a_.substr(7)
		elif a_.begins_with("--shot-at="):
			shot_at = a_.substr(10).to_float()
		elif a_.begins_with("--at="):
			var xy = a_.substr(5).split(",")
			shot_pos = Vector2(xy[0].to_float(), xy[1].to_float()) * T
	if "--autoplay" in args or "--autohost" in args or "--autolobby" in args:
		self.start_local()
		var nb = 2
		for a_ in args:
			if a_.begins_with("--bots="):
				nb = a_.substr(7).to_int()
		for i in nb:
			sim.action(1, "add_bot", 0)
		if not "--autolobby" in args:
			sim.action(1, "start", 0)
		if "--night" in args:
			sim.action(1, "skip", 0)
			sim.tick(0.01)
			sim.t = 0.0
			sim.tick(0.01)
			sim.elapsed = maxf(0.0, GameSim.FIRST_WAVE_DELAY - 0.5)
		self.dev_args(args)

# Screenshot and playtest helpers: --kit (some materials and a bow), --arsenal (every weapon), --walls, --towers, --goto=x,y (tiles) or --goto=wood|stone|herb|titanium|sup:N, --gathered=0..5, --panel=bag|craft|build|pause|map,
# --boss=0..6 (night 2 with that boss 9 tiles in front of door A, you beside it).
func dev_args(args) -> void:
	for a_ in args:
		var me = sim.players.get(1)
		if me == null or sim.phase == "lobby":
			return
		if a_ == "--kit":
			sim.set_count(me, "wood", 30)
			sim.set_count(me, "stone", 12)
			sim.set_count(me, "titanium", 8)
			sim.set_count(me, "bow", 1)
			sim.set_count(me, "arrow", 10)
			sim.set_count(me, "bandage", 2)
			sim.unlock = 2
		elif a_ == "--arsenal":
			# every weapon in the hotbar (keys 1-4: spear, blade, hammer, bow) to look at each attack; for fists,
			# drag one of them into the bag (Tab) and select the empty slot
			me.inv = GameSim.empty_slots(GameSim.INV_SLOTS)
			me.inv[0] = ["stone_spear", 1]
			me.inv[1] = ["titanium_blade", 1]
			me.inv[2] = ["hammer", 1]
			me.inv[3] = ["bow", 1]
			sim.set_count(me, "arrow", 99)
			me.sel = 0
		elif a_ == "--walls":
			# a wood and a stone wall beside door A, to look at
			var d: Vector2 = Vector2(GameSim.DOOR_POS[0] + GameSim.DOOR_DIR[0] * 5 * T)
			sim.built_walls.append({"id": 9001, "kind": "wood", "pos": GameSim.snap_to_tile(d + Vector2(0, -3 * T)), "vert": true, "hp": 200.0, "maxhp": 200.0})
			sim.built_walls.append({"id": 9002, "kind": "stone", "pos": GameSim.snap_to_tile(d + Vector2(-2 * T, 4 * T)), "vert": false, "hp": 300.0, "maxhp": 400.0})
			sim.teleport(me, d + Vector2(2 * T, 0))
		elif a_ == "--towers":
			# a tower beside each landing pad (the third one badly damaged), you beside the first
			sim.free_tower = false
			for i in range(GameSim.MAX_TOWERS):
				sim.place_tower(i, sim.free_tower_spot(i))
			sim.towers[2].hp = 60.0
			sim.world.rebuild(sim.nodes, sim.towers, sim.built_walls)
			sim.teleport(me, sim.towers[0].pos + Vector2(-2 * T, -1.0 * T))
		elif a_.begins_with("--gathered="):
			# every node left with N units (0..5), to look at the broken stages
			for nd in sim.nodes:
				nd.amount = a_.substr(11).to_int()
		elif a_.substr(7) in GameSim.RES and a_.begins_with("--goto="):
			# --goto=wood|stone|herb|titanium: next to the nearest node of that kind (titanium is all in the outer zone)
			var kind: int = GameSim.RES.find(a_.substr(7))
			var best: Vector2 = Vector2.ZERO
			for nd in sim.nodes:
				if int(nd.type) == kind and (best == Vector2.ZERO or Vector2(nd.pos).length() < best.length()):
					best = Vector2(nd.pos)
			sim.teleport(me, best + Vector2(0, 1.5 * T))
		elif a_.begins_with("--goto=sup:"):
			# --goto=sup:N: two tiles south of exploration chest N
			var n: int = a_.substr(11).to_int()
			if n >= 0 and n < sim.exploration_chests.size():
				sim.teleport(me, IslandMap.pull_inland(sim.exploration_chests[n].pos + Vector2(0, 2.0 * T), T))
		elif a_.begins_with("--goto=lm:"):
			# --goto=lm:N: in front of landmark N's structure (src/world/WorldLandmarks.cs)
			var id: int = a_.substr(10).to_int()
			var _v1 = (IslandMap.by_id(id).pos if IslandMap.by_id(id) != null else null)
			var at: Vector2 = _v1 if _v1 != null else Vector2.ZERO
			var wg = geometry
			var _c2 = geometry is WorldGeometry
			var built
			if _c2:
				built = wg.lm_at.get(id, Vector2.ZERO)
				_c2 = wg.lm_at.has(id)
			if _c2:
				at = built
			sim.teleport(me, IslandMap.pull_inland(at + Vector2(0, 2.5 * T), T))
		elif a_.begins_with("--goto="):
			# --goto=x,y in tiles from the base centre, to look at a part of the island
			var xy = a_.substr(7).split(",")
			sim.teleport(me, Vector2(xy[0].to_float(), xy[1].to_float()) * T)
		elif a_ == "--night":
			# straight to night 1 with no waves, to look at the night colours; an Engineer standing in the base
			# (--goto before it) stays inside
			var keep: Vector2 = Vector2(me.pos)
			sim.night()
			sim.next_wave = INF
			if me.role == 2 and GameSim.inside_base(keep):
				me.inside = true
				sim.teleport(me, keep)
		elif a_.begins_with("--zoom="):
			# --zoom=0..2: the camera zoom step (0 is the widest), as the mouse wheel sets it
			zoom_i = clampi(a_.substr(7).to_int(), 0, ZOOMS.size() - 1)
		elif a_.begins_with("--panel="):
			var p = a_.substr(8)
			bag_open = p == "bag"
			craft_open = p == "craft"
			paused = p == "pause"
			map_big = p == "map"
			if p == "build":
				build_open = true
				build_kind = "wood"
		elif a_.begins_with("--boss="):
			sim.boss_plan = [a_.substr(7).to_int(), 0]
			sim.k = 2
			sim.night()
			sim.active = [0]
			sim.next_wave = INF
			sim.boss_spawned = true
			sim.spawn_boss()
			var b = sim.boss()
			b.pos = GameSim.DOOR_POS[0] + GameSim.DOOR_DIR[0] * 9 * T
			b.spd = 0.0
			sim.teleport(me, b.pos + Vector2(2.5 * T, 0.5 * T))

# --- local match (multiplayer removed for now; GameSim keeps the same API for adding it back) ---------
func start_local() -> void:
	sim = GameSim.new()
	my_id = 1
	sim.add_player(1, self.get_player_name(), role_opt.selected)

func back_to_menu(why) -> void:
	sim = null
	snap = {}
	my_id = 0
	pending_inputs.clear()
	input_sequence = 0
	status.text = why

func act(kind, arg = null) -> void:
	if arg == null: arg = 0
	if sim:
		sim.action(my_id, kind, arg)

func _physics_process(delta: float) -> void:
	var dt = delta
	# a solo match stops while the pause overlay is open
	if sim and not paused:
		sim.tick(dt)
		frame += 1
		# the renderer reads a snapshot 20 times per second, as a client would
		if frame % 3 == 0:
			self.on_snap(sim.snapshot())

func move(dt) -> void:
	var me = snap.ps.get(my_id)
	if me == null:
		return
	if me[15] != local_tp:
		local_tp = me[15]
		local_pos = me[2]
		pending_inputs.clear()
	var playing: bool = snap.ph in ["day", "dusk", "night"]
	var local_before: Vector2 = Vector2(local_pos)
	if playing and me[5] == 0:
		var dir = Vector2(self.key(68) - self.key(65), self.key(83) - self.key(87))
		var destination = local_pos + dir.normalized() * GameSim.SPEED * (1.2 if me[1] == 0 else 1.0) * (1.2 if me.size() > 30 and me[30] else 1.0) * dt
		local_pos = geometry.move_body(local_pos, destination, BODY_R, GameSim.walls(self.doors_open()))
		local_pos = self.bump(local_pos, BODY_R)
	local_pos = IslandMap.keep(local_before, Vector2(local_pos), float(BODY_R))
	local_pos = GameSim.collide(local_pos, 0.4 * T, self.doors_open())
	if snap.ph == "night" and not self.breach() and not me[19] and not GameSim.inside_base(local_pos):
		local_pos = GameSim.push_out(local_pos, 0.4 * T)
	send_acc += dt
	if send_acc >= 0.05:
		send_acc = 0.0
		# from the body, not the feet
		var aim = (get_global_mouse_position() - (local_pos - Vector2(0, LIFT))).angle()
		var atk = playing and not self.ui_captures_mouse() and Input.is_mouse_button_pressed(1)
		var hand_item = me[7][int(me[25])]
		if hand_item != null and GameSim.is_tactical_use(Cs.s(hand_item[0])):
			atk = false
		var inter = playing and not ui_captures_mouse() and Input.is_physical_key_pressed(69)
		var ent = playing and Input.is_physical_key_pressed(70)
		input_sequence += 1
		pending_inputs[input_sequence] = local_pos
		if pending_inputs.size() > 128:
			pending_inputs.erase(pending_inputs.keys()[0])
		if sim:
			sim.input(my_id, local_pos, aim, atk, inter, ent, local_tp, input_sequence)

func _unhandled_input(input_event) -> void:
	var ev = input_event
	if ev is InputEventKey and ev.pressed and not ev.echo and ev.keycode == 4194334:
		debug_geometry = not debug_geometry
	if my_id == 0 or not snap.has("ph"):
		return
	if ev is InputEventKey and ev.pressed and not ev.echo:
		if ev.physical_keycode == 4194305:
			self.escape_key()
		elif paused:
			return
		elif ev.physical_keycode == 66:
			self.toggle_build()
		elif not self.build_key(ev.physical_keycode):
			self.gameplay_key(ev.physical_keycode)
	elif ev is InputEventMouseButton and ev.pressed and ev.button_index in [4, 5]:
		# the wheel picks the hotbar slot; Ctrl + wheel zooms
		if ev.ctrl_pressed:
			zoom_i = clampi(zoom_i + (1 if ev.button_index == 4 else -1), 0, ZOOMS.size() - 1)
		elif not paused:
			self.hotbar_wheel(-1 if ev.button_index == 4 else 1)
	elif ev is InputEventMouseButton:
		# overlays take the click first, then panels, then the world (right mouse = flask)
		if self.pause_mouse(ev) or self.result_mouse(ev) or self.build_mouse(ev) or self.inventory_mouse(ev) or self.craft_mouse(ev):
			return
		if ev.pressed and ev.button_index == 1 and not ui_captures_mouse():
			var me = snap.ps.get(my_id)
			var hand = null if me == null else me[7][int(me[25])]
			if hand != null and GameSim.is_tactical_use(Cs.s(hand[0])):
				act("use_item", get_global_mouse_position())
		if ev.pressed and ev.button_index == 2:
			self.gameplay_right_click()

# --- hit feedback (derived from snapshot diffs, no extra network) -------
func on_snap(d) -> void:
	sound.from_snap(d)
	var same: bool = d.get("ph") == snap.get("ph") and d.get("k") == snap.get("k")
	if same and d.ph in ["day", "dusk", "night"]:
		var seen = {}
		for e in d.en:
			seen[e[0]] = true
			var old = prev_hp.get(e[0])
			if old != null and e[3] < old:
				# 2.5D: hits land on the body, not the feet
				var body: Vector2 = e[2] - Vector2(0, e[5])
				self.popup(body, Cs.s(roundi(old - e[3])), NEON_CYAN, 18 if e[1] == GameSim.BOSS else 15)
				flash[e[0]] = 0.1
				self.sparks(body, 4, Color(1.6, 1.6, 2.0))
		for id in prev_pos:
			if not seen.has(id):
				self.sparks(prev_pos[id], 16, NEON_PINK, 260.0)
		if d.base < snap.base:
			gen_flash = 0.4
			shake = maxf(shake, 2.0)
		for i in 3:
			if d.doors[i] < snap.doors[i]:
				door_flash[i] = 0.4
			elif d.doors[i] > snap.doors[i]:
				self.sparks(GameSim.DOOR_POS[i], 3, Color(2.2, 1.7, 0.6), 90.0)
	if same:
		for id in d.ps:
			var p = d.ps[id]
			var old = prev_php.get(id)
			if old != null and p[3] < old:
				self.popup(p[2] - Vector2(0, LIFT), "-%d" % [roundi(old - p[3])], NEON_RED, 15)
				if id == my_id:
					shake = maxf(shake, 7.0)
					hurt = 0.35
	var mine = d.get("ps", {}).get(my_id)
	var old_me = snap.get("ps", {}).get(my_id)
	if mine != null and old_me != null:
		# "+1 wood" popups from the change in carried totals
		for res in ["wood", "stone", "herb", "titanium", "bandage", "arrow"]:
			var gain: int = carried(mine, res) - carried(old_me, res)
			if gain > 0:
				self.popup(mine[2] - Vector2(0, LIFT), "+%d %s" % [gain, res], DROP_COL.get(res, Color.WHITE) * 1.6, 14)
	prev_hp.clear()
	prev_pos.clear()
	for e in d.get("en", []):
		prev_hp[e[0]] = e[3]
		prev_pos[e[0]] = e[2] - Vector2(0, e[5])
	prev_php.clear()
	for id in d.get("ps", {}):
		prev_php[id] = d.ps[id][3]
	geometry.rebuild(node_colliders(d.get("nodes", [])), d.get("tw", []).map(func(tw): return {"pos": tw[1]}), d.get("walls", []).map(func(w): return {"pos": w[0], "vert": w[1]}))
	if mine != null and mine[15] == local_tp and mine.size() > 24:
		var acknowledged: int = int(mine[24])
		if pending_inputs.has(acknowledged):
			var correction: Vector2 = Vector2(mine[2] - pending_inputs[acknowledged])
			local_pos += correction
			for sequence in pending_inputs.keys():
				if sequence <= acknowledged:
					pending_inputs.erase(sequence)
				else:
					pending_inputs[sequence] += correction
	snap = d
	sync_chest_panel(mine, old_me)

func popup(pos, text_, col, size) -> void:
	popups.append({"pos": pos + Vector2(float(randi_range(-10, 10)), -20), "text": text_, "col": col, "size": size, "life": 0.8})

func sparks(pos, n, col, speed = null) -> void:
	if speed == null: speed = 160.0
	for i in n:
		if fx.size() < 400:
			fx.append({"pos": pos, "vel": Vector2.from_angle(randf() * TAU) * randf_range(0.3, 1.0) * speed, "life": 0.45, "max": 0.45, "col": col, "r": randf_range(2.0, 4.5)})

# --- per-frame ----------------------------------------------------------
func _process(delta: float) -> void:
	var dt = delta
	if sim and my_id == 0:
		# dedicated server draws nothing
		return
	clock += dt
	sound.tick(dt)
	tick_landmark_ground()
	local_note_t -= dt
	# Your own character moves every rendered frame (not at the 60 Hz physics rate), so it glides at any
	# monitor refresh rate; the simulation still checks every position it receives.
	if my_id != 0 and snap.has("ps") and not paused:
		self.move(minf(dt, 0.05))
	var ph = snap.get("ph", "")
	var in_game = ph in ["day", "dusk", "night", "result"]
	menu_panel.visible = ph == ""
	lobby_panel.visible = ph == "lobby"
	banner.visible = in_game and ph != "result"
	front.visible = not in_game
	if front.visible:
		front.queue_redraw()
		self.layout_frontend()
	var me_now = snap.get("ps", {}).get(my_id)
	if ph != "day" and ph != "dusk" and not (ph == "night" and me_now != null and me_now[19]):
		craft_open = false
	self.keep_panels_in_reach(me_now)
	if not ph in ["day", "dusk", "night"]:
		bag_open = false
		paused = false
		self.close_build()
	# the large map covers the middle of the screen: the radio line waits until it closes
	# the large map and the workbench tab hide the radio line
	banner.text = "" if map_big or craft_open else snap.get("msg", "")
	# the night bar pushes the boss bar down (src/ai/view/Main.EnemyView.cs); the banner moves down with it
	var boss_shown: bool = ph == "night" and snap.get("en", []).any(func(e): return e[1] == GameSim.BOSS)
	banner.offset_top = 86 + NIGHT_BAR_H if boss_shown else 60 + NIGHT_BAR_H if ph == "night" else 86
	if ph == "lobby":
		self.lobby_ui()
	hud.queue_redraw()
	queue_redraw()
	if shot_path != "" and clock >= shot_at:
		self.capture_shot(shot_path)
		shot_path = ""
	if not in_game:
		self.forget_fallen()
		return
	var a_ = minf(1.0, dt * 15.0)
	var ne = {}
	for e in snap.en:
		ne[e[0]] = shown_e.get(e[0], e[2]).lerp(e[2], a_)
	# enemies gone since the last frame fall over where they were (src/ai/view/Main.EnemyView.cs)
	self.note_fallen(ne)
	shown_e = ne
	for id in snap.ps:
		shown_p[id] = shown_p.get(id, snap.ps[id][2]).lerp(snap.ps[id][2], a_)
	for id in flash.keys():
		flash[id] -= dt
		if flash[id] <= 0:
			flash.erase(id)
	var damp = pow(0.02, dt)
	for f in fx:
		f.pos += f.vel * dt
		f.vel *= damp
		f.life -= dt
	fx = fx.filter(func(f): return f.life > 0)
	for p in popups:
		p.life -= dt
	popups = popups.filter(func(p): return p.life > 0)
	hurt = maxf(0.0, hurt - dt)
	gen_flash = maxf(0.0, gen_flash - dt)
	for i in 3:
		door_flash[i] = maxf(0.0, door_flash[i] - dt)
	shake = move_toward(shake, 0.0, dt * 30.0)
	cam.offset = Vector2(float(randi_range(-1, 1)), float(randi_range(-1, 1))) * shake
	var target = local_pos - Vector2(0, LIFT)
	if camera_tp != local_tp:
		camera_tp = local_tp
		camera_focus = target
		cam.position = target
	var zone: Vector2 = DisplaySettings.get_current().camera_dead_zone
	var delta_2 = target - camera_focus
	camera_focus += Vector2(signf(delta_2.x) * maxf(0, absf(delta_2.x) - zone.x), signf(delta_2.y) * maxf(0, absf(delta_2.y) - zone.y))
	var follow: Vector2 = cam.position.lerp(camera_focus, 1.0 - exp(-DisplaySettings.get_current().camera_follow_rate * dt))
	# zoom so one art pixel covers a whole number of screen pixels: crisp pixel art at any window size
	var ws = Vector2(DisplayServer.window_get_size())
	# the canvas_items stretch scale
	var sc = minf(ws.x / 960.0, ws.y / 540.0)
	cam.zoom = Vector2.ONE * maxf(1.0, ZOOMS[zoom_i] / sc)
	# snap the camera to whole screen pixels, not whole art pixels: the world scrolls one screen pixel at a
	# time instead of jumping 3 at a time, and every art pixel still covers exactly the same screen pixels
	var screen_px: float = float(cam.zoom.x * sc)
	cam.position = (follow * screen_px).round() / screen_px
	if shot_pos != null and clock > 0.5:
		local_pos = shot_pos
		shot_pos = null
	var me = snap.ps.get(my_id)
	var night = 0.0
	if ph == "night":
		night = 1.0
	elif ph == "dusk":
		night = 1.0 - snap.t / GameSim.DUSK
	night_level = float(night)
	tint.color = DAY_TINT.lerp(NIGHT_TINT, night)
	self.tick_base_lamps(float(night))
	my_light.enabled = night > 0
	beacon.enabled = night > 0
	for l in tower_lights:
		l.enabled = false
	for tw in snap.get("tw", []):
		var l = tower_lights[tw[0]]
		# a standing tower floodlights the ground around it (TOWER_LIGHT, 6 tiles) from dusk to dawn; the light
		# goes out the moment the tower falls and flickers while it is badly damaged
		l.enabled = night > 0.02 and tw[2] > 0
		l.position = tw[1]
		l.energy = 0.85 * night * (randf_range(0.45, 1.0) if tw[2] < 0.3 * GameSim.TOWER_HP else 1.0)
	my_light.position = local_pos
	if me != null:
		var r = 4.0 * T * (1.3 if me[1] == 0 else 1.0)
		my_light.texture_scale = lerpf(30.0 * T, r, night) * 2.0 / 256.0

func lobby_ui() -> void:
	var eng = false
	var ids = snap.ps.keys()
	for i in roster.size():
		var row = roster[i]
		var occupied = i < ids.size()
		row.icon.visible = occupied
		if occupied:
			var id: int = int(ids[i])
			var p = snap.ps[id]
			eng = eng or p[1] == 2
			row.name.text = Cs.s(p[0]) + ("  / YOU" if id == my_id else "")
			row.meta.text = Cs.s(GameSim.ROLES[p[1]]) + ("  ·  AI teammate" if id < 0 else "  ·  You")
			row.badge.text = "LEADER" if id == snap.leader else "BOT" if id < 0 else "CREW"
			row.badge.add_theme_color_override("font_color", ROLE_COL[p[1]])
			row.icon.texture = self.portrait(p[1])
			row.name.modulate = Color.WHITE
		else:
			row.name.text = "Open crew slot"
			row.name.modulate = Color("64788A")
			row.meta.text = "Add a bot to fill this slot"
			row.badge.text = "%02d" % [i + 1]
			row.badge.add_theme_color_override("font_color", Color("435768"))
	lobby_count.text = "%d / 5 CREW" % [ids.size()]
	lobby_text.text = snap.get("msg", "")
	var leader: bool = my_id == snap.leader
	start_btn.text = "START EXPEDITION  >" if leader else "WAITING FOR LEADER"
	start_btn.disabled = not leader or not eng
	lobby_hint.text = "Ready" if eng else "Needs an Engineer"
	lobby_hint.modulate = Color("89A498") if eng else Color("F2B544")
	if not snap.ps.has(my_id):
		lobby_hint.text = "Lobby full."
	lobby_role.disabled = not snap.ps.has(my_id)
	if snap.ps.has(my_id) and not lobby_role.has_focus():
		lobby_role.selected = snap.ps[my_id][1]
	mode_opt.disabled = not leader
	bot_row.visible = leader
	bot_buttons[0].disabled = ids.size() >= 5
	bot_buttons[1].disabled = not ids.any(func(id): return id < 0)
	if not mode_opt.has_focus():
		mode_opt.selected = snap.mode
	self.update_role_cards()

func capture_shot(path) -> void:
	await RenderingServer.frame_post_draw
	var img = get_viewport().get_texture().get_image()
	img.convert(Image.FORMAT_RGBA8)
	img.linear_to_srgb()
	img.save_png(path)
	get_tree().quit()

# --- world drawing (2.5D) -------------------------------------------------
# The rules stay flat 2D (GameSim.cs). Only the look is 2.5D: ground first, then everything with
# height (trees, rocks, walls, enemies, players) sorted by the y of its foot, back to front,
# so nearer things cover farther ones. Walls are drawn with a top face and a front face.
func _draw() -> void:
	if not snap.get("ph", "") in ["day", "dusk", "night", "result"]:
		return
	var font = ThemeDB.fallback_font
	var visible_size = get_viewport_rect().size / cam.zoom
	var view = Rect2(cam.position - visible_size / 2, visible_size).grow(8 * T)
	var h = GameSim.HALF
	# ground layer: flat, nothing here hides anything
	# the island from the level-design map: sea, shallows, beach, grass, safe zone, woods and hills; then the
	# swamp, routes, trails, door roads and the pond (src/world/view/Main.TerrainView.cs)
	cave_interior_active = geometry.is_cave_interior(Vector2(local_pos))
	weather_interior_active = geometry.is_weather_interior(Vector2(local_pos))
	self.draw_island(Rect2(view))
	self.draw_terrain(Rect2(view))
	# grass tufts and pebbles: thousands on the island, so a typed copy is checked against the view
	if scatter_typed == null or scatter_typed.size() != scatter.size():
		scatter_typed = Cs.arr(scatter.size(), null)
		for i in range(scatter_typed.size()):
			scatter_typed[i] = [Vector2(scatter[i][0]), Cs.s(scatter[i][1])]
	var seen_rect: Rect2 = Rect2(view)
	var cold_typed: Color = COLD
	for _it1 in scatter_typed:
		var sp = _it1[0]
		var sn = _it1[1]
		if seen_rect.has_point(sp) and not hidden_outside_interior(sp):
			self.sprite_2(sn, sp, 1.0, cold_typed)
	for i in 3:
		var pp = GameSim.pad_pos(i)
		self.draw_prop("pad", pp)
		if snap.k == 5 and snap.ph == "night":
			var blink = 0.5 + 0.5 * sin(Time.get_ticks_msec() / 200.0)
			for j in 8:
				draw_rect(Rect2(pp + Vector2.from_angle(j * TAU / 8.0) * 117.0 - Vector2(2, 2), Vector2(4, 4)), Color(0.5, 1.2, 2.6) * (0.6 + blink))
			if snap.pads[i] > 0:
				draw_arc(pp, 108, -PI / 2, -PI / 2 + TAU * snap.pads[i] / 10.0, 64, Color(0.6, 2.0, 0.8), 6)
	# base floor: stone paving (src/world/view/Main.BaseLook.cs)
	draw_rect(Rect2(-h, h * 2), Color("4F4B42"))
	self.draw_base_floor()
	self.draw_telegraphs()
	draw_tactical_areas()
	draw_construction_ground()
	# from outside, the inside of the base is fogged over (src/world/view/Main.BaseFog.cs)
	self.tick_base_fog()
	self.draw_base_fog()
	# depth layer: [foot y, kind, ...], drawn back to front
	var items = []
	if cmove.size() > 400:
		cmove.clear()
		anim_state.clear()
	for e in snap.en:
		var pos: Vector2 = Vector2(shown_e.get(e[0], e[2]))
		if view.has_point(pos):
			items.append([pos.y, 2, e, pos])
	self.corpse_items(items)
	for id in snap.ps:
		var p = snap.ps[id]
		# the dead lie where they fell until someone brings a Revival kit
		var pos: Vector2 = Vector2(local_pos if id == my_id else shown_p.get(id, p[2]))
		items.append([pos.y, 3, id, p, pos])
	for d in deco_scene_index.visible(deco, 0, Rect2(view), true):
		if view.has_point(d[0]):
			items.append([d[0].y, 0, d[1], d[0], d[2], d[3]])
	self.prepare_harvest_feedback()
	for nd in resource_scene_index.visible(snap.nodes, 1, Rect2(view), true):
		if view.has_point(nd[1]):
			var hsh = int(absf(nd[1].x * 7.0 + nd[1].y * 13.0))
			var n = self.node_sprite(nd, int(hsh))
			items.append([nd[1].y, 0, n, nd[1] + self.node_offset(nd), self.node_scale(nd), self.node_modulate(nd)])
	for r in GameSim.walls([true, true, true]):
		self.wall_items(items, r, WALL_H, Color("8A8F98"), Color("5B5F6B"))
	for i in 3:
		var dur: float = float(snap.doors[i])
		var gap = self.door_gap(i)
		if dur <= 0:
			items.append([gap.end.y, 7, gap])
		elif snap.ph == "night":
			var col = Color("8FA3B8") if dur > 250 else Color("F2B544")
			if door_flash[i] > 0:
				col = col.lerp(Color(2, 2, 2), door_flash[i])
			self.wall_items(items, gap, WALL_H * 0.8, col, col.darkened(0.45))
	items.append([WORKBENCH.y, 6, "workbench", WORKBENCH])
	# the shared storage chest, its lid opening as someone walks up (src/world/view/Main.BaseProps.cs)
	self.tick_chest()
	items.append([GameSim.STORAGE_POS.y, 6, "chest", GameSim.STORAGE_POS])
	# the old lighthouse carries the beacon (GDD 5.1)
	# it fades while you stand behind it (src/world/view/Main.BaseProps.cs)
	items.append([LIGHTHOUSE.y, 6, "lighthouse", LIGHTHOUSE, self.lighthouse_tint()])
	for tw in snap.get("tw", []):
		items.append([tw[1].y, 9, tw])
	# MEC-11: green preview where T would place the free tower (drawn just behind the Engineer)
	if self.free_tower_here():
		items.append([local_pos.y - 0.5, 6, "tower", local_pos, Color(0.6, 1.6, 0.7, 0.45)])
	for i in 3:
		for fp in self.door_pillars(i):
			items.append([fp.end.y, 8, fp])
	for b in snap.proj:
		items.append([b[0].y, 4, b])
	for a_ in snap.get("arrows", []):
		items.append([a_[0].y, 11, a_])
	for w in snap.get("walls", []):
		items.append([w[0].y + (1.5 * T if w[1] else 0.5 * T), 10, w])
	for d in snap.get("drops", []):
		items.append([d[0].y, 5, d])
	garden_fence_items(items, Rect2(view))
	weather_wall_items(items, Rect2(view))
	fishing_rod_items(items, Rect2(view))
	expedition_items(items, Rect2(view))
	compound_boundary_items(items, Rect2(view))
	lookout_items(items, Rect2(view))
	exploration_items(items, Rect2(view))
	items.sort_custom(func(a_, b): return a_[0] < b[0])
	var tnow = Time.get_ticks_msec() / 1000.0
	for it in items:
		if self.hidden_item(it):
			continue
		# the kind once, not one dynamic compare per branch (hundreds of items a frame)
		var kind: int = int(it[1])
		if kind == 13:
			draw_garden_fence(int(it[2]))
		elif kind == 14:
			draw_weather_wall(int(it[2]))
		elif kind == 15:
			draw_fishing_rod(int(it[2]))
		elif kind == 16:
			draw_expedition_vehicle(int(it[2]))
		elif kind == 17:
			draw_expedition_cliff(int(it[2]))
		elif kind == 18:
			draw_compound_boundary(int(it[2]))
		elif kind == 19:
			draw_lookout_object(int(it[2]))
		elif kind == 20:
			draw_lookout_rail(int(it[2]))
		elif kind == 21:
			draw_exploration_chest(it[2])
		elif kind == 22:
			draw_installed_radio()
		elif kind == 0:
			self.sprite_2(it[2], it[3], it[4], it[5])
			self.draw_ore_glow(Cs.s(it[2]), Vector2(it[3]), float(it[4]))
		elif kind == 1:
			self.wall(it[2], it[3], it[4], it[5], it[6])
		elif kind == 2:
			self.draw_enemy(it[2], it[3])
		elif kind == 3:
			self.draw_player(it[2], it[3], it[4])
		elif kind == 4:
			# enemy projectile: Spitter spit or Bio-Cannon spore (art/fx)
			var b = it[2]
			var bp: Vector2 = Vector2(b[0])
			self.shadow(bp + Vector2(0, -4), 5)
			draw_circle(bp - Vector2(0, LIFT), 8, Color(0.5, 2.0, 0.6, 0.3) if b[1] == "orb" else Color(1.6, 1.9, 0.4, 0.35))
			self.draw_fx(b[1], bp - Vector2(0, LIFT), 0.0)
		elif kind == 5:
			var d = it[2]
			if d[3] >= 0.0 and d[3] < 5.0 and fmod(tnow, 0.3) < 0.12:
				continue
			var dc: Color = DROP_COL.get(d[1], Color.WHITE)
			var dp: Vector2 = d[0] - Vector2(0, 10 + sin(tnow * 4.0 + d[0].x) * 3.0)
			self.shadow(d[0] - Vector2(0, 6), 7)
			draw_circle(dp, 12, Color(dc.r * 1.8, dc.g * 1.8, dc.b * 1.8, 0.3))
			# the item's own icon, floating (art/items)
			self.draw_item_icon(self, d[1], dp.round(), 1.0)
		elif kind == 6 and Cs.s(it[2]) == "chest":
			self.draw_chest(Vector2(it[3]))
		elif kind == 6 and Cs.s(it[2]) == "lighthouse":
			self.draw_lighthouse(Vector2(it[3]), it[4])
		elif kind == 6:
			self.draw_prop(it[2], it[3], it[4] if it.size() > 4 else Color.WHITE)
		elif kind == 8:
			self.pillar(it[2])
		elif kind == 9:
			self.draw_tower(it[2])
		elif kind == 10:
			self.draw_built_wall(it[2])
		elif kind == 12:
			self.draw_corpse(int(it[2]))
		elif kind == 11:
			var a_ = it[2]
			self.draw_fx("explosive_arrow" if a_.size() > 2 and a_[2] else "arrow", a_[0] - Vector2(0, LIFT), a_[1])
		elif kind == 7:
			var g: Rect2 = Rect2(it[2])
			for k in 5:
				var c = g.position + Vector2(fmod(k * 13.7, g.size.x), fmod(k * 29.3, g.size.y))
				self.box(Rect2(c - Vector2(5, 4), Vector2(10, 8)), 5.0, Color("4A2226"))
	# chips flying off nodes being gathered
	self.draw_chips()
	self.draw_harvest_feedback()
	draw_cave_roof(geometry, Rect2(view))
	draw_weather_roof(geometry, Rect2(view))
	if debug_geometry:
		for i in geometry.candidates(view.position, view.end, 0.0):
			var shape = geometry.solids[i]
			draw_arc(shape[0], shape[1], 0, TAU, 24, Color(0.3, 1.0, 0.5, 0.8), 1.0)
		for wall_ in GameSim.walls(self.doors_open()):
			draw_rect(wall_, Color(1, 0.3, 0.3, 0.5), false, 1)
		for id in snap.ps:
			draw_arc(snap.ps[id][2], BODY_R, 0, TAU, 20, Color.CYAN, 1)
	# overlays: always readable, never hidden by depth
	var pulse = 0.5 + 0.5 * sin(Time.get_ticks_msec() / 150.0)
	for i in 3:
		var dp: Vector2 = Vector2(GameSim.DOOR_POS[i])
		var dd: Vector2 = Vector2(GameSim.DOOR_DIR[i])
		var along = Vector2(absf(dd.y), absf(dd.x))
		if i in snap.active:
			var mc = dp + dd * 16
			draw_line(mc - along * 1.4 * T, mc + along * 1.4 * T, NEON_RED * (0.5 + 0.5 * pulse), 3)
	for id in snap.ps:
		var p = snap.ps[id]
		var pf = local_pos if id == my_id else shown_p.get(id, p[2])
		if not self.hidden_in_base(Vector2(pf)) and not hidden_outside_interior(Vector2(pf)):
			self.player_ui(id, p, pf, font)
	for f in fx:
		if self.hidden_in_base(Vector2(f.pos)) or hidden_outside_interior(Vector2(f.pos)):
			continue
		draw_circle(f.pos, f.r * f.life / f.max, f.col)
	self.draw_build_preview()
	draw_cave_isolation(geometry)
	draw_weather_isolation(geometry)

func draw_player(id, p, foot) -> void:
	var r = T * 0.42
	var aim: float = float(p[12])
	if id == my_id:
		aim = (get_global_mouse_position() - (local_pos - Vector2(0, LIFT))).angle()
	# role ring on the ground, so roles read apart
	draw_set_transform(foot, 0, Vector2(1.0, 0.45))
	draw_arc(Vector2.ZERO, r * 1.15, 0, TAU, 32, ROLE_COL[p[1]], 2.5)
	draw_set_transform(Vector2.ZERO)
	var skin = Cs.s(ROLE_SKIN[p[1]])
	if p[5] == 1:
		# knocked down: falls over once (the sheet's "down" frames), then lies still with the eyes shut
		self.char_(id, skin, foot, null, 1.0, Color(0.85, 0.8, 0.85), false, "idle", "down", self.down_time(id, true))
		return
	if p[5] == 2:
		# dead: lies still, greyed, with a cross over the body
		self.char_(id, skin, foot, null, 1.0, Color(0.5, 0.48, 0.55), false, "idle", "down", self.down_time(id, true) + 10.0)
		var x: Vector2 = Vector2(foot) - Vector2(0, 22)
		draw_line(x + Vector2(-4, -4), x + Vector2(4, 4), NEON_RED, 2)
		draw_line(x + Vector2(4, -4), x + Vector2(-4, 4), NEON_RED, 2)
		return
	self.down_time(id, false)
	if p[11]:
		slash_t[id] = clock
	var fighting: bool = clock - slash_t.get(id, -9.0) < 0.4
	if id == my_id and Input.is_mouse_button_pressed(1):
		fighting = true
	var activity = p[22] if p.size() > 22 else "idle"
	if p[11]:
		activity = "attack"
	if activity in ["gather", "repair", "revive"]:
		aim = (p[23] - p[2]).angle()
	# the attack frames of the weapon in hand (src/gameplay/view/Main.Anim.cs)
	var attack = self.player_attack(id, p, skin)
	var gather = gather_animation(Vector2(p[23])) if activity == "gather" and attack == null else null
	var _v1 = (attack[0] if attack != null else null)
	var _v2 = (attack[1] if attack != null else null)
	self.char_(id, skin, foot, aim, 1.0, Color.WHITE, fighting or activity != "idle", activity, _v1 if _v1 != null else gather, _v2 if _v2 != null else 0.0, gather != null)
	self.draw_activity(foot, aim, activity)
	draw_tactical_weapon(id, p, Vector2(foot), aim)
# compass octant (0 = right, counting clockwise on screen) to the sheet row
static var OCT_ROW = [0, 4, 1, 5, 2, 6, 3, 7]

func char_(key_, skin, foot, aim, s, mod_, lock = null, activity = null, play = null, play_t: float = 0.0, loop: bool = false) -> void:
	if lock == null: lock = false
	if activity == null: activity = "idle"
	# A pixel-art character: the walk cycle while it moves, idle breathing otherwise.
	# `play` names a one-shot animation of its sheet (an attack, "down") shown `play_t` seconds in; its last
	# frame holds. Knocked down it keeps the direction it last faced.
	# While it walks it faces where it walks (no moonwalking); standing still it faces `aim` (the mouse),
	# and with `lock` (fighting) it faces `aim` even on the move. With aim null (enemies) it faces its walk.
	var m = cmove.get(key_)
	if m == null:
		m = [foot, -1.0, PI / 2, -1]
	var step: Vector2 = Vector2(foot - m[0])
	if step.length() > 0.2:
		m[1] = clock
		m[2] = step.angle()
	m[0] = foot
	cmove[key_] = m
	var tex = csheet.get(skin)
	if tex == null:
		return
	var moving: bool = clock - m[1] < 0.15
	var anim = "run" if moving else "idle"
	var ang: float = float(m[2] if aim == null or moving and not lock else aim)
	# 8 directions. Sheet rows: right, down, left, up, then down-right, down-left, up-left, up-right.
	# The facing only changes once the angle is well past the edge between two directions, so walking
	# diagonally (two keys) or sliding along a wall never flickers between neighbouring rows.
	var c0 = cinfo.chars[skin]
	var one = null if play == null else c0.get("anims", {}).get(play, null)
	var rows: int = int(tex.get_height() / c0.size)
	var dir: int = 0
	if rows >= 8:
		var oct: int = wrapi(roundi(ang / (PI / 4.0)), 0, 8)
		var last: int = int(m[3])
		if last >= 0 and one != null and play == "down":
			oct = last
		elif last >= 0 and absf(angle_difference(ang, last * PI / 4.0)) < PI / 8.0 + 0.2:
			oct = last
		m[3] = oct
		dir = OCT_ROW[oct]
	else:
		dir = wrapi(roundi(ang / (PI / 2.0)), 0, 4)
	var state = play if loop else activity if activity != "idle" else anim
	var timing = anim_state.get(key_)
	if timing == null or timing[0] != state:
		timing = [state, clock]
	anim_state[key_] = timing
	var phase_time: float = float(clock - timing[1])
	var act_ = Cs.s(activity)
	if act_ == "repair":
		foot += Vector2(cos(ang), 0) * sin(phase_time * 12.0) * 2.0
	elif act_ == "heal" or act_ == "revive":
		foot.y += 2.0
	var fr = cinfo.frames[anim]
	# out of step with each other
	var k: int = int(phase_time * cinfo.fps[anim]) % int(fr[1])
	if moving and cos(m[2] - ang) < -0.2:
		k = int(fr[1]) - 1 - k
	var f: int = int(fr[0]) + k
	if one != null:
		var count: int = int(one[1])
		var frame_: int = int((phase_time if loop else play_t) * float(one[2]))
		f = int(one[0]) + (frame_ % count if loop else mini(count - 1, frame_))
	var c = cinfo.chars[skin]
	var size = Vector2(c.size, c.size)
	var anchor = Vector2(c.anchor[0], c.anchor[1])
	draw_texture_rect_region(tex, Rect2(foot - anchor * s, size * s), Rect2(Vector2(f, dir) * size, size), mod_)

# How a node looks as it is gathered (broken stages, chips): src/world/view/Main.NodeBreak.cs
func player_ui(id, p, foot, font) -> void:
	var r = T * 0.42
	var pos = foot - Vector2(0, 0 if p[5] == 1 else LIFT)
	if p[20] > 0:
		draw_arc(pos, r + 13, -PI / 2, -PI / 2 + TAU * p[20] / 2.0, 24, Color(2.2, 1.6, 0.5), 4)
	var prog: float = float(p[14] if p[14] > 0 else 1.0 - p[13] / 2.0 if p[13] > 0 else p[21])
	if prog > 0:
		draw_arc(pos, r + 8, -PI / 2, -PI / 2 + TAU * prog, 24, Color(0.6, 2.0, 0.8), 3)
	# just above the head
	var top = foot - Vector2(0, (10.0 if p[5] != 0 else CHAR_H) + 2)
	if id != my_id and p[5] != 2:
		self.bar(top, T, p[3] / p[4], Color("3DBE5A"))
	var label = Cs.s(p[0]) + ("  DOWN %d" % [p[6]] if p[5] == 1 else "  DEAD" if p[5] == 2 else "")
	var lp = top + Vector2(-2 * T, -6)
	draw_string_outline(font, lp, label, 1, 4 * T, 7, 2, INK)
	draw_string(font, lp, label, 1, 4 * T, 7, NEON_RED if p[5] != 0 else Color.WHITE)

func bump(pos, r) -> Variant:
	# Keeps the local player's feet out of trees, rocks, the lighthouse and workbench, resource nodes
	# (not herbs), towers and enemies; it slides around them. Walls come after this, so a wall always wins.
	pos = geometry.resolve(pos, r)
	for e in snap.get("en", []):
		pos = push(pos, r, shown_e.get(e[0], e[2]), e[5] * ENEMY_BODY)
	return pos

static func push(pos, r, c, cr) -> Variant:
	var d = pos - c
	var need = r + cr
	if d.length_squared() >= need * need:
		return pos
	return c + (d.normalized() if d.length() > 0.01 else Vector2.DOWN) * need

func var_(n, k) -> Variant:
	return "%s_%d" % [n, absi(k) % maxi(1, nvar.get(n, 1))]

func ground(pts, col) -> void:
	var uv = PackedVector2Array()
	for p in pts:
		# art/nature/ground.png repeats every 8 tiles
		uv.append(p / 256.0)
	draw_colored_polygon(pts, col, uv, ground_tex)

func sprite_rect(n, pos, s) -> Variant:
	var sp = spr.get(n)
	if sp == null:
		return Rect2(pos, Vector2.ZERO)
	return Rect2(pos - sp[1] * SPR * s, sp[0].get_size() * SPR * s)

func sprite(n, pos, s, mod_ = null) -> void:
	var name = n
	var _c1 = n is String
	var at
	if _c1:
		at = pos
		_c1 = pos is Vector2
	if _c1:
		var f = s
		var c = mod_
		f = s
		c = mod_
		self.sprite_2(name, at, f if s is float else float(s), c if mod_ is Color else Color.WHITE)
		return
	if mod_ == null: mod_ = Color.WHITE
	var sp = spr.get(n)
	if sp != null:
		draw_texture_rect(sp[0], self.sprite_rect(n, pos, s), false, mod_)
# the sprites of Spr with their anchor and size, typed: thousands are drawn every frame (grass, rocks, trees)
var spr_typed = {}

func sprite_2(n, pos: Vector2, s: float, mod_: Color) -> void:
	var e = spr_typed.get(n, null)
	if not spr_typed.has(n):
		var sp = spr.get(n)
		var tex = null if sp == null else sp[0]
		var px_: float = float(SPR)
		e = [tex, Vector2.ZERO if tex == null else Vector2(sp[1]) * px_, Vector2.ZERO if tex == null else tex.get_size() * px_]
		spr_typed[n] = e
	if e[0] != null:
		draw_texture_rect(e[0], Rect2(pos - e[1] * s, e[2] * s), false, mod_)

func door_gap(i) -> Variant:
	var h = GameSim.HALF
	var th = GameSim.WALL_IN + GameSim.WALL_OUT
	var g = GameSim.DOOR_GAP
	return [Rect2(-h.x - GameSim.WALL_OUT, -g, th, 2 * g), Rect2(-g, -h.y - GameSim.WALL_OUT, 2 * g, th), Rect2(h.x - GameSim.WALL_IN, -g, th, 2 * g)][i]

func wall_items(items, r, height, top, face) -> void:
	# A horizontal wall is one item. A vertical wall is cut into 1-tile pieces so a player
	# beside it sorts correctly against each piece; the pieces join into one wall.
	if r.size.y <= r.size.x:
		items.append([r.end.y, 1, r, height, top, face, true])
		return
	# corners belong to the long walls
	var lo = maxf(r.position.y, -GameSim.HALF.y + GameSim.WALL_IN)
	var hi = minf(r.end.y, GameSim.HALF.y - GameSim.WALL_IN)
	var y = lo
	while y < hi - 0.5:
		var piece = Rect2(r.position.x, y, r.size.x, minf(T, hi - y))
		items.append([piece.end.y, 1, piece, height, top, face, y == lo and lo > -GameSim.HALF.y + GameSim.WALL_IN + 0.5])
		y += T

func wall(r, height, top, face, cap) -> void:
	# the base walls are weathered concrete (src/world/view/Main.BaseLook.cs)
	if top == BASE_WALL_TOP:
		self.concrete_wall(Rect2(r), float(height), cap)
		return
	# a wall facing into the roofed base (door B's gate) hides its face under the roof
	if self.face_under_roof(Rect2(r)):
		height = 0.0
	# top face, lifted
	var time_left = Rect2(r.position - Vector2(0, height), r.size)
	# front face, toward the camera
	var f = Rect2(r.position.x, r.end.y - height, r.size.x, height)
	draw_rect(f, face)
	var row = 0
	for y in range(int(f.position.y), int(f.end.y), 7):
		draw_rect(Rect2(f.position.x, y, f.size.x, 1), face.darkened(0.3))
		var x0 = int(f.position.x) - int(f.position.x) % 16 + (8 if row % 2 else 0)
		for x in range(x0, int(f.end.x), 16):
			if x > f.position.x:
				draw_rect(Rect2(x, y, 1, minf(7.0, f.end.y - y)), face.darkened(0.3))
		draw_rect(Rect2(f.position.x, y + 1, f.size.x, 1), face.lightened(0.08))
		row += 1
	draw_rect(time_left, top)
	for x in range(int(time_left.position.x) - int(time_left.position.x) % 4, int(time_left.end.x), 4):
		for y in range(int(time_left.position.y) - int(time_left.position.y) % 4, int(time_left.end.y), 4):
			if (x * 7 + y * 13) % 11 == 0 and time_left.has_point(Vector2(x, y)):
				draw_rect(Rect2(x, y, 1, 1), top.darkened(0.18))
	draw_line(Vector2(time_left.position.x, f.position.y), Vector2(time_left.end.x, f.position.y), top.lightened(0.3), 1)
	draw_line(Vector2(time_left.position.x, time_left.position.y), Vector2(time_left.position.x, r.end.y), INK, 2)
	draw_line(Vector2(time_left.end.x, time_left.position.y), Vector2(time_left.end.x, r.end.y), INK, 2)
	draw_line(Vector2(time_left.position.x, r.end.y), Vector2(time_left.end.x, r.end.y), INK, 2)
	if cap:
		draw_line(time_left.position, Vector2(time_left.end.x, time_left.position.y), INK, 2)

func box(r, height, col) -> void:
	var time_left = Rect2(r.position - Vector2(0, height), r.size)
	draw_rect(Rect2(time_left.position, Vector2(r.size.x, r.size.y + height)).grow(2), INK)
	draw_rect(Rect2(r.position.x, r.end.y - height, r.size.x, height), col.darkened(0.4))
	draw_rect(time_left, col)

func draw_prop(n, pos, mod_ = null) -> void:
	if mod_ == null: mod_ = Color.WHITE
	# A pixel-art prop with its ground anchor on pos, snapped to whole pixels.
	var p = prop.get(n)
	if p != null:
		var scale = 1.0
		if n == "lighthouse":
			scale = LIGHTHOUSE_SCALE
		elif n in ["tower", "tower_wreck"]:
			scale = TOWER_SCALE
		var texture = p[0]
		draw_texture_rect(texture, Rect2((pos - p[1] * scale).round(), texture.get_size() * scale), false, mod_)

func door_pillars(i) -> Variant:
	# Footprints of the two lamp pillars at the ends of door i's opening.
	var g = self.door_gap(i)
	if i == 1:
		return [Rect2(g.position.x - 10, g.position.y - 1, 10, g.size.y + 2), Rect2(g.end.x, g.position.y - 1, 10, g.size.y + 2)]
	return [Rect2(g.position.x - 1, g.position.y - 10, g.size.x + 2, 10), Rect2(g.position.x - 1, g.end.y, g.size.x + 2, 10)]

func pillar(r) -> void:
	# A door pillar: taller than the wall, with a lamp on top that glows from dusk.
	var hgt = WALL_H + 10.0
	# concrete like the walls, with its lamp (src/world/view/Main.BaseLook.cs)
	self.concrete_pillar(Rect2(r), float(hgt))

# The Engineer still has the free tower and T would place it here. Only shown near the base, so the ghost
# does not follow them all over the island.
func free_tower_here() -> bool:
	var me_b = snap.ps.get(my_id)
	if me_b == null or me_b[1] != 2 or me_b[5] != 0 or me_b[19] or not snap.get("free_tower", false):
		return false
	var near_door: bool = false
	for i in 3:
		near_door = near_door or local_pos.distance_to(Vector2(GameSim.DOOR_POS[i])) < 14.0 * T
	return near_door and GameSim.tower_spot_problem(local_pos, null) == ""

func draw_tower(tw) -> void:
	# Defence tower (AGT-12): [door, pos, hp, wrecked, has target, target pos].
	var pos: Vector2 = Vector2(tw[1])
	var hp: float = float(tw[2])
	var up = hp > 0
	var mod_ = Color.WHITE
	if up and hp < 0.3 * GameSim.TOWER_HP and fmod(clock, 0.5) < 0.12:
		mod_ = Color(0.65, 0.65, 0.75)
	self.draw_prop("tower" if up else "tower_wreck", pos, mod_)
	# the floodlight burns at night: a hot glow on the lamp head (the glow pass blooms it)
	if up and night_level > 0.02:
		var lamp: Vector2 = pos + Vector2(0, -47 - TOWER_EXTRA) * float(TOWER_SCALE)
		var flick: float = randf_range(0.4, 1.0) if hp < 0.3 * GameSim.TOWER_HP else 1.0
		draw_circle(lamp, 7.0 * float(TOWER_SCALE), Color(1.0, 0.62, 0.25, 0.22 * night_level * flick))
		draw_rect(Rect2(lamp - Vector2(3, 2) * float(TOWER_SCALE), Vector2(6, 4) * float(TOWER_SCALE)), Color(2.2, 1.7, 0.9, night_level * flick))
	if up and tw[4] and fmod(clock, 0.25) < 0.1:
		var tgt: Vector2 = tw[5] - Vector2(0, 12)
		draw_line(pos + Vector2(11, -46 - TOWER_EXTRA) * TOWER_SCALE, tgt, Color(2.4, 1.8, 0.7), 1.5)
		draw_circle(tgt, 3, Color(2.4, 1.8, 0.7))
	if hp < GameSim.TOWER_HP:
		self.bar(pos - Vector2(0, (64 + TOWER_EXTRA if up else 26) * TOWER_SCALE), T * 1.2 * TOWER_SCALE, hp / GameSim.TOWER_HP, Color("F2B544") if up else NEON_RED)

func blob(pos, r, col) -> void:
	draw_circle(pos, r + 2.5, INK)
	draw_circle(pos, r, col)
	draw_circle(pos + Vector2(-r * 0.35, -r * 0.4), r * 0.28, Color(1, 1, 1, 0.12))

func shadow(pos, r) -> void:
	draw_set_transform(pos, 0, Vector2(1.0, 0.4))
	draw_circle(Vector2.ZERO, r, Color(0, 0, 0, 0.3))
	draw_set_transform(Vector2.ZERO)

func round_rect(half, r) -> Variant:
	# Outline of the base rectangle grown by r (a rectangle with corners rounded by r).
	var pts = PackedVector2Array()
	for c in [[Vector2(half.x, half.y), 0.0], [Vector2(-half.x, half.y), PI / 2], [Vector2(-half.x, -half.y), PI], [Vector2(half.x, -half.y), PI * 1.5]]:
		for i in 9:
			pts.append(c[0] + Vector2.from_angle(c[1] + i * PI / 16) * r)
	return pts

func bar(center, w, frac, col) -> void:
	draw_rect(Rect2(center - Vector2(w / 2 + 1, 3), Vector2(w + 2, 6)), INK)
	draw_rect(Rect2(center - Vector2(w / 2, 2), Vector2(w * clampf(frac, 0, 1), 4)), col)

func draw_hud() -> void:
	var ph = snap.get("ph", "")
	if not ph in ["day", "dusk", "night", "result"]:
		return
	var c = hud
	var vs = c.size
	var me = snap.ps.get(my_id)
	var ct = get_viewport().get_canvas_transform()
	var pulse = 0.5 + 0.5 * sin(Time.get_ticks_msec() / 150.0)
	# the arrow home, under every panel (src/world/view/Main.BaseArrow.cs)
	if ph != "result":
		self.draw_base_arrow(c, ct)
	for p in popups:
		# nothing pops up from inside the base while you are outside (src/world/view/Main.BaseFog.cs)
		if self.hidden_in_base(Vector2(p.pos)):
			continue
		var k: float = float(p.life / 0.8)
		var sp: Vector2 = ct * p.pos + Vector2(0, -36 * (1.0 - k))
		var size = int(p.size * (1.0 + 0.5 * clampf((k - 0.8) * 5.0, 0, 1)))
		var col: Color = p.col
		col.a = clampf(k * 2.0, 0, 1)
		self.text(c, sp - Vector2(30, 0), p.text, size, col, 1, 60)
	# the workbench tab takes the screen on its own: the HUD widgets would show through it, the scene may
	# (ui/gameplay/Main.CraftPanel.cs)
	if craft_open and me != null and ph != "result":
		map_big = false
		self.draw_craft_panel(c, vs)
		self.draw_hurt_flash(c, vs)
		self.draw_pause(c, vs)
		return
	# top right: phase + timer
	var tl = "%d:%02d" % [int(maxf(snap.t, 0)) / 60, int(maxf(snap.t, 0)) % 60]
	var phase_line = {"day": "DAY %d/5" % [snap.k], "dusk": "DUSK", "night": "NIGHT %d/5" % [snap.k], "result": "RESULT"}[ph]
	self.text(c, Vector2(0, 24), "%s   %s" % [phase_line, tl], 16, Color.WHITE, 2, vs.x - 12, true)
	if ph == "day":
		var vote_hint = "skip %d/%d (V)" % [snap.votes, snap.need]
		self.text(c, Vector2(0, 40), vote_hint, 11, Color(1, 1, 1, 0.6), 2, vs.x - 12)
	if snap.ext >= 0:
		self.text(c, Vector2(0, 40), "EXTENSION %ds" % [snap.ext], 12, NEON_RED, 2, vs.x - 12)
	# Locator radio checklist and assembly progress (day and night).
	if ph != "result" and not map_big:
		self.draw_supply_row(c, float(vs.x) - 12, 50.0 if snap.ext >= 0 else 34.0)
	# top centre: generator + doors (under the large map, which takes the middle of the screen)
	var cx = vs.x / 2
	if not map_big:
		self.panel(c, Rect2(cx - 160, 6, 320, 46))
		# the generator and the doors in red, so their health reads at a glance
		var gcol = Color("E0362C").lerp(Color(2.5, 0.6, 0.5), gen_flash / 0.4)
		self.text(c, Vector2(cx - 150, 21), "GENERATOR", 11, GOLD, 0, -1.0, true)
		self.text(c, Vector2(cx + 60, 21), "%d / 1000" % [snap.base], 11, Color.WHITE, 2, 90, true)
		c.draw_rect(Rect2(cx - 150, 25, 300, 7), INK)
		c.draw_rect(Rect2(cx - 150, 25, 300 * snap.base / 1000.0, 7), gcol)
		for i in 3:
			var r = Rect2(cx - 150 + i * 102, 36, 96, 12)
			var dur: float = float(snap.doors[i])
			var col = Color("E0362C")
			c.draw_rect(r, INK)
			c.draw_rect(Rect2(r.position + Vector2(14, 3), Vector2(68 * dur / 500.0, 6)), col)
			# tower icon: lit = a standing tower covers this door (within 12 tiles of it; HUD 3)
			var door_at: Vector2 = Vector2(GameSim.DOOR_POS[i])
			var tws = snap.get("tw", []).filter(func(tw): return tw[2] > 0 and Vector2(tw[1]).distance_to(door_at) < 12.0 * T)
			var tcol = Color("F2B544") if not tws.is_empty() else Color(0.4, 0.42, 0.48)
			c.draw_rect(Rect2(r.position + Vector2(87, 4), Vector2(2, 7)), tcol)
			c.draw_rect(Rect2(r.position + Vector2(85, 2), Vector2(6, 3)), tcol)
			self.text(c, r.position + Vector2(2, 11), GameSim.DOOR_NAMES[i], 11, Color.WHITE)
			if i in snap.active:
				c.draw_rect(r.grow(1), NEON_RED * (0.6 + 0.6 * pulse if door_flash[i] > 0 else 0.7), false, 1.5)
	# night enemies bar and boss bar (AI view)
	# the large map takes the middle of the screen
	if not map_big:
		self.draw_night_bar(c, float(cx))
		self.draw_boss_bar(c, cx)
	# left: team list
	# under the minimap (top left, ui/gameplay/Main.Minimap.cs)
	var y = 160.0
	for id in snap.ps:
		var p = snap.ps[id]
		var col: Color = ROLE_COL[p[1]]
		self.panel(c, Rect2(8, y - 16, 150, 32))
		c.draw_circle(Vector2(24, y), 12, INK)
		c.draw_circle(Vector2(24, y), 10, col if p[5] == 0 else col.darkened(0.6))
		self.text(c, Vector2(40, y - 3), Cs.s(p[0]) + (" (you)" if id == my_id else ""), 11, Color.WHITE)
		if p[5] == 0:
			c.draw_rect(Rect2(40, y + 3, 110, 5), INK)
			c.draw_rect(Rect2(40, y + 3, 110 * p[3] / p[4], 5), Color("3DBE5A"))
		else:
			self.text(c, Vector2(40, y + 11), "DOWN %ds" % [p[6]] if p[5] == 1 else "DEAD", 10, NEON_RED)
		y += 38
	if me == null:
		return
	# bottom left: HP hexagon + small hexes
	var hp_c = Vector2(48, vs.y - 50)
	self.hex(c, hp_c, 38, GOLD)
	self.hex(c, hp_c, 34, INK)
	self.hex(c, hp_c, 31, Color("B3262A").lerp(Color(2.5, 0.4, 0.3), hurt / 0.35))
	self.text(c, hp_c + Vector2(-40, 8), Cs.s(int(me[3])), 22, Color.WHITE, 1, 80, true)
	self.text(c, hp_c + Vector2(-40, 24), "/%d" % [me[4]], 10, Color(1, 1, 1, 0.7), 1, 80)
	# beside it: the armour worn (no bag slot), then the bandages and healing flasks carried
	self.draw_stat_slots(c, Vector2(vs), me)
	self.text(c, Vector2(92, vs.y - 46), GameSim.ROLES[me[1]].to_upper(), 12, ROLE_COL[me[1]], 0, -1.0, true)
	if me[5] != 0:
		self.text(c, Vector2(0, vs.y / 2 + 40), "DOWN  %ds" % [me[6]] if me[5] == 1 else "DEAD", 18, NEON_RED, 1, vs.x, true)
	# top left: minimap (M shows it large); any open panel takes over from the large map
	if bag_open or craft_open or build_open:
		map_big = false
	self.draw_minimap(c, vs, me)
	# teammates and supplies, pinned to the screen edge when out of view, over the side panels
	# (ui/gameplay/Main.TeamMarkers.cs)
	if not map_big and ph != "result":
		self.draw_team_markers(c, ct, Vector2(vs))
	# the large map covers the hotbar and the hints
	if not map_big:
		self.draw_hotbar(c, vs, me)
		self.draw_interaction_hint(c, vs, me, ph)
	self.draw_build_menu(c, vs, me)
	self.draw_bag(c, vs, me)
	self.draw_hurt_flash(c, vs)
	self.draw_result(c, vs)
	self.draw_pause(c, vs)

# red screen edges after a hit
func draw_hurt_flash(c, vs) -> void:
	draw_low_health(c, Vector2(vs))
	if hurt > 0:
		var a_ = hurt / 0.35 * 0.5
		for r in [Rect2(0, 0, vs.x, 14), Rect2(0, vs.y - 14, vs.x, 14), Rect2(0, 0, 14, vs.y), Rect2(vs.x - 14, 0, 14, vs.y)]:
			c.draw_rect(r, Color(0.9, 0.05, 0.05, a_))

func text(ci, pos, s, size, col, align = null, width = null, title = null) -> void:
	if align == null: align = 0
	if width == null: width = -1.0
	if title == null: title = false
	# HUD text with a dark outline; title = Oswald (headings, timer, big numbers), otherwise Noto Sans.
	var font = font_title if title else font_ui
	var fs = roundi(size * TITLE_SCALE) if title else size
	# thin outline on small text, so pixel letters stay open
	var ol = 2 if fs <= 12 else 3 if fs < 20 else 4
	ci.draw_string_outline(font, pos, s, align, width, fs, ol, Color(0, 0, 0, 0.9 * col.a))
	ci.draw_string(font, pos, s, align, width, fs, col)
# A pixel-art texture that keeps hard pixels on a linearly filtered canvas (the HUD and the menus).
var pixel_tex = {}

func pixel(tex) -> Variant:
	var raw = tex
	var ct = pixel_tex.get(raw, null)
	if not pixel_tex.has(raw):
		ct = Cs.init(CanvasTexture.new(), {"diffuse_texture": raw, "texture_filter": CanvasItem.TEXTURE_FILTER_NEAREST})
		pixel_tex[raw] = ct
	return ct

func panel(ci, r) -> void:
	ci.draw_rect(r, PANEL)
	ci.draw_rect(r, GOLD * Color(1, 1, 1, 0.7), false, 1.5)

func hex(ci, center, r, col) -> void:
	var pts = PackedVector2Array()
	for i in 6:
		pts.append(center + Vector2.from_angle(deg_to_rad(60 * i - 90)) * r)
	ci.draw_colored_polygon(pts, col)

func diamond(ci, center, r, col) -> void:
	ci.draw_colored_polygon(PackedVector2Array([center + Vector2(0, -r), center + Vector2(r, 0), center + Vector2(0, r), center + Vector2(-r, 0)]), col)

# --- setup --------------------------------------------------------------
func build_scene() -> void:
	# sea
	RenderingServer.set_default_clear_color(Color("0E1726"))
	var env = Environment.new()
	env.background_mode = Environment.BG_CANVAS
	env.glow_enabled = true
	env.glow_intensity = 0.8
	env.glow_hdr_threshold = 1.0
	env.glow_blend_mode = Environment.GLOW_BLEND_MODE_ADDITIVE
	var we = WorldEnvironment.new()
	we.environment = env
	add_child(we)
	add_child(tint)
	add_child(cam)
	var g = Gradient.new()
	g.set_color(0, Color.WHITE)
	g.set_color(1, Color.BLACK)
	g.add_point(0.7, Color.WHITE)
	var tex = GradientTexture2D.new()
	tex.gradient = g
	tex.fill = GradientTexture2D.FILL_RADIAL
	tex.fill_from = Vector2(0.5, 0.5)
	tex.fill_to = Vector2(1.0, 0.5)
	tex.width = 256
	tex.height = 256
	my_light.texture = tex
	beacon.texture = tex
	beacon.color = Color("FFAE52")
	beacon.energy = 0.16
	my_light.color = Color("B8D6D0")
	my_light.energy = 0.3
	# full strength over the whole base (the texture is flat out to 70% of its radius), fading over the yard
	beacon.texture_scale = GameSim.HALF.x * 1.2 / 0.7 * 2.0 / 256.0
	add_child(my_light)
	add_child(beacon)
	# warm lamps on the door pillars and the north wall (src/world/view/Main.BaseLook.cs)
	self.setup_base_lamps(tex)
	for i in 3:
		var tl = PointLight2D.new()
		tl.texture = tex
		tl.color = Color("FF9A3C")
		tl.texture_scale = GameSim.TOWER_LIGHT * 2.0 / 256.0
		tl.enabled = false
		tl.texture_filter = CanvasItem.TEXTURE_FILTER_LINEAR
		# the scene repeats its ground texture; a light must not tile
		tl.texture_repeat = CanvasItem.TEXTURE_REPEAT_DISABLED
		add_child(tl)
		tower_lights.append(tl)
	var idx = JSON.parse_string(FileAccess.get_file_as_string(Cs.s(NATURE) + "index.json"))
	for n in idx:
		spr[n] = [load(Cs.s(NATURE + n) + ".png"), Vector2(idx[n][0], idx[n][1])]
		# "Pine_2_1" = model Pine_2, turned variant 1
		var base = n.rsplit("_", true, 1)
		nvar[base[0]] = maxi(nvar.get(base[0], 0), base[1].to_int() + 1)
	# the landmarks' structures (tools/PixelLandmarks.cs, placed by src/world/WorldLandmarks.cs)
	var lm_idx = JSON.parse_string(FileAccess.get_file_as_string("res://art/landmarks/index.json"))
	for n in lm_idx:
		spr[n] = [load("res://art/landmarks/" + Cs.s(n) + ".png"), Vector2(lm_idx[n][0], lm_idx[n][1])]
	cinfo = JSON.parse_string(FileAccess.get_file_as_string(Cs.s(CHARS) + "chars.json"))
	# the seven bosses come from tools/PixelBosses.cs in the same sheet layout
	var bj = JSON.parse_string(FileAccess.get_file_as_string(Cs.s(CHARS) + "bosses.json"))
	for n in bj.chars:
		cinfo.chars[n] = bj.chars[n]
	for n in cinfo.chars:
		csheet[n] = load(Cs.s(CHARS + n) + ".png")
	self.load_item_art()
	var pj = JSON.parse_string(FileAccess.get_file_as_string(Cs.s(PROPS) + "props.json"))
	for n in pj:
		prop[n] = [load(Cs.s(PROPS + n) + ".png"), Vector2(pj[n][0], pj[n][1])]
	# pixel-art ground: light and dark patches and grass marks, multiplied by the zone colour (tools/PixelNature.cs)
	ground_tex = load(Cs.s(NATURE) + "ground.png")
	self.set("texture_repeat", CanvasItem.TEXTURE_REPEAT_ENABLED)
	# the whole world is pixel art: no smoothing when scaled up
	self.set("texture_filter", CanvasItem.TEXTURE_FILTER_NEAREST)
	# light falloff stays soft
	my_light.texture_filter = CanvasItem.TEXTURE_FILTER_LINEAR
	beacon.texture_filter = CanvasItem.TEXTURE_FILTER_LINEAR
	my_light.texture_repeat = CanvasItem.TEXTURE_REPEAT_DISABLED
	beacon.texture_repeat = CanvasItem.TEXTURE_REPEAT_DISABLED
	deco = geometry.deco
	scatter = geometry.scatter

